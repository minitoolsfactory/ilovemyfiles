{
  "image-convert": {
    "title": "Image format converter",
    "description": "Convert an image to another format: JPG/JPEG, PNG, WebP, BMP, GIF, ICO, SVG or TIFF.",
    "accept": "image/*",
    "hint": "Supported input: common browser-readable images",
    "options": "<span class=\"field-label\">Output format</span><div class=\"format-grid\" role=\"radiogroup\" aria-label=\"Output format\"><button type=\"button\" class=\"format-chip\" data-format=\"image/jpeg\">JPG</button><button type=\"button\" class=\"format-chip\" data-format=\"image/jpeg\" data-ext=\"jpeg\">JPEG</button><button type=\"button\" class=\"format-chip\" data-format=\"image/png\">PNG</button><button type=\"button\" class=\"format-chip\" data-format=\"image/webp\">WebP</button><button type=\"button\" class=\"format-chip\" data-format=\"image/bmp\">BMP</button><button type=\"button\" class=\"format-chip\" data-format=\"image/gif\">GIF</button><button type=\"button\" class=\"format-chip\" data-format=\"image/x-icon\">ICO</button><button type=\"button\" class=\"format-chip\" data-format=\"image/svg+xml\">SVG</button><button type=\"button\" class=\"format-chip\" data-format=\"image/tiff\">TIFF</button></div><input type=\"hidden\" id=\"image-format\" value=\"image/png\"><div class=\"margin-control\"><div class=\"margin-head\"><span class=\"field-label\">Margin</span><span class=\"margin-unit\">px</span></div><div class=\"margin-presets\" role=\"group\" aria-label=\"Margin presets\"><button type=\"button\" class=\"margin-preset active\" data-value=\"0\" data-target=\"convert-margin\">0</button><button type=\"button\" class=\"margin-preset\" data-value=\"5\" data-target=\"convert-margin\">5</button><button type=\"button\" class=\"margin-preset\" data-value=\"10\" data-target=\"convert-margin\">10</button><button type=\"button\" class=\"margin-preset\" data-value=\"20\" data-target=\"convert-margin\">20</button></div><div class=\"stepper\"><button type=\"button\" class=\"stepper-btn\" data-step=\"-1\" data-target=\"convert-margin\" aria-label=\"Decrease margin\">−</button><input id=\"convert-margin\" aria-label=\"Margin\" class=\"field-control\" type=\"number\" min=\"0\" max=\"200\" step=\"1\" value=\"0\" inputmode=\"numeric\"><button type=\"button\" class=\"stepper-btn\" data-step=\"1\" data-target=\"convert-margin\" aria-label=\"Increase margin\">+</button></div></div><p class=\"field-help\">Convert between JPG/JPEG, PNG, WebP, BMP, GIF, ICO, SVG and TIFF. WebP is usually smallest; JPG has broad support. GIF is a single frame; SVG wraps the image (it is not vectorised); TIFF is uncompressed and large. Transparent areas are filled white for JPG, BMP, GIF, ICO and TIFF.</p>"
  },
  "image-compress": {
    "title": "Image compressor",
    "description": "Reduce image file size with a quality setting or a target size in KB.",
    "accept": "image/*",
    "hint": "Supported input: common browser-readable images",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"compress-format\">Output format</label><select id=\"compress-format\" class=\"field-control\"><option value=\"image/webp\">WebP</option><option value=\"image/jpeg\" data-ext=\"jpg\">JPG</option><option value=\"image/jpeg\" data-ext=\"jpeg\">JPEG</option><option value=\"image/png\">PNG</option><option value=\"image/bmp\">BMP</option><option value=\"image/gif\">GIF</option><option value=\"image/x-icon\">ICO</option><option value=\"image/svg+xml\">SVG</option><option value=\"image/tiff\">TIFF</option></select></div><div><label class=\"field-label\" for=\"compress-mode\">Compression mode</label><select id=\"compress-mode\" class=\"field-control\"><option value=\"target\">Target size (KB)</option><option value=\"quality\">Quality slider</option></select></div></div><div id=\"quality-option\" hidden><label class=\"field-label\" for=\"quality\">Quality <output id=\"quality-value\">78%</output></label><input id=\"quality\" class=\"range-control\" type=\"range\" min=\"20\" max=\"95\" value=\"78\"><p class=\"field-help\">Adjustable quality is available for JPG and WebP. Choose target size for other formats.</p></div><div id=\"target-option\"><label class=\"field-label\" for=\"target-kb\">Target file size (KB)</label><input id=\"target-kb\" class=\"field-control\" type=\"number\" min=\"5\" max=\"50000\" value=\"200\"><p class=\"field-help\">The tool will try to reach this size. Exact size and quality cannot be guaranteed.</p></div>"
  },
  "image-resize": {
    "title": "Image Size compressor",
    "description": "Reduce an image's file size by resizing it to the dimensions you need.",
    "accept": "image/*",
    "hint": "Supported input: common browser-readable images",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"resize-width\">Width (px)</label><input id=\"resize-width\" class=\"field-control\" type=\"number\" min=\"1\" max=\"20000\" value=\"1200\"></div><div><label class=\"field-label\" for=\"resize-height\">Height (px)</label><input id=\"resize-height\" class=\"field-control\" type=\"number\" min=\"1\" max=\"20000\" value=\"1200\"></div></div><label class=\"check-field\"><input id=\"keep-ratio\" type=\"checkbox\" checked><span>Keep original aspect ratio</span></label><label class=\"field-label\" for=\"resize-format\">Output format</label><select id=\"resize-format\" class=\"field-control\"><option value=\"image/webp\">WebP</option><option value=\"image/jpeg\" data-ext=\"jpg\">JPG</option><option value=\"image/jpeg\" data-ext=\"jpeg\">JPEG</option><option value=\"image/png\">PNG</option><option value=\"image/bmp\">BMP</option><option value=\"image/gif\">GIF</option><option value=\"image/x-icon\">ICO</option><option value=\"image/svg+xml\">SVG</option><option value=\"image/tiff\">TIFF</option></select><div class=\"margin-control\"><div class=\"margin-head\"><span class=\"field-label\">Margin</span><span class=\"margin-unit\">px</span></div><div class=\"margin-presets\" role=\"group\" aria-label=\"Margin presets\"><button type=\"button\" class=\"margin-preset active\" data-value=\"0\" data-target=\"image-resize-margin\">0</button><button type=\"button\" class=\"margin-preset\" data-value=\"5\" data-target=\"image-resize-margin\">5</button><button type=\"button\" class=\"margin-preset\" data-value=\"10\" data-target=\"image-resize-margin\">10</button><button type=\"button\" class=\"margin-preset\" data-value=\"20\" data-target=\"image-resize-margin\">20</button></div><div class=\"stepper\"><button type=\"button\" class=\"stepper-btn\" data-step=\"-1\" data-target=\"image-resize-margin\" aria-label=\"Decrease margin\">−</button><input id=\"image-resize-margin\" aria-label=\"Margin\" class=\"field-control\" type=\"number\" min=\"0\" max=\"500\" step=\"1\" value=\"0\" inputmode=\"numeric\"><button type=\"button\" class=\"stepper-btn\" data-step=\"1\" data-target=\"image-resize-margin\" aria-label=\"Increase margin\">+</button></div></div>"
  },
  "image-rotate": {
    "title": "Rotate & flip images",
    "description": "Rotate images by 90°, 180° or 270°, or mirror them.",
    "accept": "image/*",
    "hint": "Supported input: common browser-readable images",
    "options": "<label class=\"field-label\">Rotate</label><div class=\"rotate-actions\"><button type=\"button\" class=\"rotate-act\" data-op=\"ccw\" title=\"Rotate 90° counter-clockwise\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 2.64-6.36\"/><path d=\"M3 3v6h6\"/></svg><span>90° CCW</span></button><button type=\"button\" class=\"rotate-act\" data-op=\"cw\" title=\"Rotate 90° clockwise\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21 12a9 9 0 1 1-2.64-6.36\"/><path d=\"M21 3v6h-6\"/></svg><span>90° CW</span></button><button type=\"button\" class=\"rotate-act\" data-op=\"180\" title=\"Rotate 180°\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5a7 7 0 1 1-7 7\"/><path d=\"m9 4 3-3 3 3\"/></svg><span>180°</span></button></div><div class=\"rotate-readout\"><span>Current rotation</span><b id=\"rotate-readout\">0°</b></div><label class=\"field-label\">Flip</label><div class=\"flip-actions\"><button type=\"button\" class=\"flip-act\" data-op=\"flip-h\" title=\"Flip horizontally (mirror)\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3v18\" stroke-dasharray=\"2 3\"/><path d=\"M8 8 4 12l4 4\"/><path d=\"m16 8 4 4-4 4\"/></svg><span>Flip H</span></button><button type=\"button\" class=\"flip-act\" data-op=\"flip-v\" title=\"Flip vertically\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12h18\" stroke-dasharray=\"2 3\"/><path d=\"M8 8 12 4l4 4\"/><path d=\"m8 16 4 4 4-4\"/></svg><span>Flip V</span></button></div><button type=\"button\" class=\"rotate-reset\" data-op=\"reset\">Reset rotation &amp; flips</button><div><label class=\"field-label\" for=\"rotate-format\">Output format</label><select id=\"rotate-format\" class=\"field-control\"><option value=\"image/webp\">WebP</option><option value=\"image/jpeg\" data-ext=\"jpg\">JPG</option><option value=\"image/jpeg\" data-ext=\"jpeg\">JPEG</option><option value=\"image/png\">PNG</option><option value=\"image/bmp\">BMP</option><option value=\"image/gif\">GIF</option><option value=\"image/x-icon\">ICO</option><option value=\"image/svg+xml\">SVG</option><option value=\"image/tiff\">TIFF</option></select></div><div class=\"margin-control\"><div class=\"margin-head\"><span class=\"field-label\">Margin</span><span class=\"margin-unit\">px</span></div><div class=\"margin-presets\" role=\"group\" aria-label=\"Margin presets\"><button type=\"button\" class=\"margin-preset active\" data-value=\"0\" data-target=\"rotate-image-margin\">0</button><button type=\"button\" class=\"margin-preset\" data-value=\"5\" data-target=\"rotate-image-margin\">5</button><button type=\"button\" class=\"margin-preset\" data-value=\"10\" data-target=\"rotate-image-margin\">10</button><button type=\"button\" class=\"margin-preset\" data-value=\"20\" data-target=\"rotate-image-margin\">20</button></div><div class=\"stepper\"><button type=\"button\" class=\"stepper-btn\" data-step=\"-1\" data-target=\"rotate-image-margin\" aria-label=\"Decrease margin\">−</button><input id=\"rotate-image-margin\" aria-label=\"Margin\" class=\"field-control\" type=\"number\" min=\"0\" max=\"500\" step=\"1\" value=\"0\" inputmode=\"numeric\"><button type=\"button\" class=\"stepper-btn\" data-step=\"1\" data-target=\"rotate-image-margin\" aria-label=\"Increase margin\">+</button></div></div><p class=\"field-help\">Tap a rotate button to turn the current preview further. Each image keeps its own rotation and flips. JPG cannot keep transparency.</p>"
  },
  "image-crop": {
    "title": "Crop image",
    "description": "Drag on the image to choose exactly the area to keep.",
    "accept": "image/*",
    "hint": "Choose one image, then drag on it to select the crop area.",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"crop-format\">Output format</label><select id=\"crop-format\" class=\"field-control\"><option value=\"image/webp\">WebP</option><option value=\"image/jpeg\" data-ext=\"jpg\">JPG</option><option value=\"image/jpeg\" data-ext=\"jpeg\">JPEG</option><option value=\"image/png\">PNG</option><option value=\"image/bmp\">BMP</option><option value=\"image/gif\">GIF</option><option value=\"image/x-icon\">ICO</option><option value=\"image/svg+xml\">SVG</option><option value=\"image/tiff\">TIFF</option></select></div></div><div class=\"margin-control\"><div class=\"margin-head\"><span class=\"field-label\">Margin</span><span class=\"margin-unit\">px</span></div><div class=\"margin-presets\" role=\"group\" aria-label=\"Margin presets\"><button type=\"button\" class=\"margin-preset active\" data-value=\"0\" data-target=\"crop-margin\">0</button><button type=\"button\" class=\"margin-preset\" data-value=\"5\" data-target=\"crop-margin\">5</button><button type=\"button\" class=\"margin-preset\" data-value=\"10\" data-target=\"crop-margin\">10</button><button type=\"button\" class=\"margin-preset\" data-value=\"20\" data-target=\"crop-margin\">20</button></div><div class=\"stepper\"><button type=\"button\" class=\"stepper-btn\" data-step=\"-1\" data-target=\"crop-margin\" aria-label=\"Decrease margin\">−</button><input id=\"crop-margin\" aria-label=\"Margin\" class=\"field-control\" type=\"number\" min=\"0\" max=\"200\" step=\"1\" value=\"0\" inputmode=\"numeric\"><button type=\"button\" class=\"stepper-btn\" data-step=\"1\" data-target=\"crop-margin\" aria-label=\"Increase margin\">+</button></div></div><p class=\"field-help\">Choose the file, drag the crop box on the left, then download the cropped image.</p>"
  },
  "pdf-delete-pages": {
    "title": "Delete PDF pages",
    "description": "Remove chosen pages from a PDF.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<label class=\"field-label\" for=\"delete-pages\">Pages to delete</label><input id=\"delete-pages\" class=\"field-control\" type=\"text\" placeholder=\"Example: 2, 5-7\"><p class=\"field-help\">Click pages in the preview to select them, or enter page numbers here. Page numbering starts at 1; ranges are inclusive. At least one page must remain.</p>"
  },
  "pdf-rotate-pages": {
    "title": "Rotate PDF pages",
    "description": "Rotate all pages or a selected range.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<label class=\"field-label\">Rotate selected page</label><div class=\"rotate-actions\"><button type=\"button\" class=\"rotate-act\" data-op=\"ccw\" title=\"Rotate 90° counter-clockwise\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 2.64-6.36\"/><path d=\"M3 3v6h6\"/></svg><span>90° CCW</span></button><button type=\"button\" class=\"rotate-act\" data-op=\"cw\" title=\"Rotate 90° clockwise\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21 12a9 9 0 1 1-2.64-6.36\"/><path d=\"M21 3v6h-6\"/></svg><span>90° CW</span></button><button type=\"button\" class=\"rotate-act\" data-op=\"180\" title=\"Rotate 180°\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5a7 7 0 1 1-7 7\"/><path d=\"m9 4 3-3 3 3\"/></svg><span>180°</span></button></div><div class=\"rotate-readout\"><span>Page rotation</span><b id=\"rotate-readout-pdf\">0°</b></div><button type=\"button\" class=\"rotate-reset\" data-op=\"reset\">Reset rotation</button><p class=\"field-help\">Select one page in the preview, then use the rotation buttons. Each page keeps its own rotation. Click another page to edit its rotation.</p>"
  },
  "pdf-resize-pages": {
    "title": "Resize PDF pages",
    "description": "Change page size to A4, A3, Letter and more.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"resize-page-size\">Page size</label><select id=\"resize-page-size\" class=\"field-control\"><option value=\"a4\" selected>A4 (210 × 297 mm)</option><option value=\"a3\">A3 (297 × 420 mm)</option><option value=\"a2\">A2 (420 × 594 mm)</option><option value=\"a1\">A1 (594 × 841 mm)</option><option value=\"a0\">A0 (841 × 1189 mm)</option><option value=\"a5\">A5 (148 × 210 mm)</option><option value=\"a6\">A6 (105 × 148 mm)</option><option value=\"b5\">B5 (176 × 250 mm)</option><option value=\"b4\">B4 (250 × 353 mm)</option><option value=\"letter\">US Letter (8.5 × 11 in)</option><option value=\"legal\">US Legal (8.5 × 14 in)</option><option value=\"tabloid\">Tabloid (11 × 17 in)</option><option value=\"executive\">US Executive (7.25 × 10.5 in)</option><option value=\"statement\">US Statement (5.5 × 8.5 in)</option><option value=\"folio\">Folio (8.5 × 13 in)</option></select></div><div><label class=\"field-label\" for=\"resize-orientation\">Orientation</label><select id=\"resize-orientation\" class=\"field-control\"><option value=\"portrait\">Portrait</option><option value=\"landscape\">Landscape</option><option value=\"auto\">Match each page</option></select></div></div><div class=\"margin-control\"><div class=\"margin-head\"><span class=\"field-label\">Margin</span><span class=\"margin-unit\">pt</span></div><div class=\"margin-presets\" role=\"group\" aria-label=\"Margin presets\"><button type=\"button\" class=\"margin-preset active\" data-value=\"0\" data-target=\"resize-margin\">0</button><button type=\"button\" class=\"margin-preset\" data-value=\"5\" data-target=\"resize-margin\">5</button><button type=\"button\" class=\"margin-preset\" data-value=\"10\" data-target=\"resize-margin\">10</button><button type=\"button\" class=\"margin-preset\" data-value=\"20\" data-target=\"resize-margin\">20</button></div><div class=\"stepper\"><button type=\"button\" class=\"stepper-btn\" data-step=\"-1\" data-target=\"resize-margin\" aria-label=\"Decrease margin\">−</button><input id=\"resize-margin\" aria-label=\"Margin\" class=\"field-control\" type=\"number\" min=\"0\" max=\"200\" step=\"1\" value=\"0\" inputmode=\"numeric\"><button type=\"button\" class=\"stepper-btn\" data-step=\"1\" data-target=\"resize-margin\" aria-label=\"Increase margin\">+</button></div></div><div><label class=\"field-label\" for=\"resize-pages\">Pages (optional)</label><input id=\"resize-pages\" class=\"field-control\" type=\"text\" placeholder=\"All pages\"></div><div class=\"field-actions\"><button type=\"button\" class=\"field-action\" id=\"resize-reset-page\">Reset this page</button><button type=\"button\" class=\"field-action field-action-primary\" id=\"resize-apply-all\">Apply to all pages</button></div><p class=\"field-help\">Page size, orientation and margin apply to the selected page only. Click a page in the preview or use the page navigation to edit it. Leave the page box empty to resize every page, or enter ranges such as 1, 3-5. Content is scaled to fit and centred, so nothing is cropped.</p>"
  },
  "pdf-page-numbers": {
    "title": "Add page numbers",
    "description": "Stamp page numbers on every page.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"numbers-position\">Position</label><select id=\"numbers-position\" class=\"field-control\"><option value=\"bottom-center\">Bottom centre</option><option value=\"bottom-right\">Bottom right</option><option value=\"bottom-left\">Bottom left</option><option value=\"top-center\">Top centre</option><option value=\"top-right\">Top right</option><option value=\"top-left\">Top left</option></select></div><div><label class=\"field-label\" for=\"numbers-start\">Start at</label><input id=\"numbers-start\" class=\"field-control\" type=\"number\" min=\"1\" max=\"100000\" value=\"1\"></div></div><div class=\"field-row\"><div><label class=\"field-label\" for=\"numbers-format\">Number format</label><select id=\"numbers-format\" class=\"field-control\"><option value=\"page\">Page 1</option><option value=\"pg\">Pg 1</option><option value=\"dash\">- 1 -</option><option value=\"number\">1</option><option value=\"custom\">Custom…</option></select></div><div><label class=\"field-label\" for=\"numbers-font\">Font</label><div id=\"numbers-font-picker\"></div><input id=\"numbers-font\" type=\"hidden\" value=\"helvetica\"></div></div><div class=\"check-row\"><label class=\"check-field\"><input id=\"numbers-bold\" type=\"checkbox\"> Bold</label><label class=\"check-field\"><input id=\"numbers-italic\" type=\"checkbox\"> Italic</label><label class=\"check-field\"><input id=\"numbers-underline\" type=\"checkbox\"> Underline</label></div><div id=\"numbers-custom-wrap\" hidden><label class=\"field-label\" for=\"numbers-custom\">Custom text</label><input id=\"numbers-custom\" class=\"field-control\" type=\"text\" placeholder=\"Example: Page {n} of 5\"><p class=\"field-help\">Use {n} where the page number should appear.</p></div><div class=\"field-row\"><div><label class=\"field-label\" for=\"numbers-size\">Font size</label><input id=\"numbers-size\" class=\"field-control\" type=\"number\" min=\"6\" max=\"72\" value=\"11\"></div><div><label class=\"field-label\" for=\"numbers-color\">Colour</label><input id=\"numbers-color\" class=\"field-control color-control\" type=\"color\" value=\"#383d52\"></div></div>"
  },
  "pdf-watermark": {
    "title": "Watermark PDF",
    "description": "Add diagonal text to every page.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<label class=\"field-label\" for=\"watermark-text\">Watermark text</label><input id=\"watermark-text\" class=\"field-control\" type=\"text\" value=\"CONFIDENTIAL\" maxlength=\"60\"><div class=\"field-row\"><div><label class=\"field-label\" for=\"watermark-size\">Font size (pt)</label><input id=\"watermark-size\" class=\"field-control\" type=\"number\" min=\"8\" max=\"200\" value=\"52\"></div><div><label class=\"field-label\" for=\"watermark-opacity\">Opacity</label><input id=\"watermark-opacity\" class=\"field-control\" type=\"number\" min=\"0.05\" max=\"1\" step=\"0.05\" value=\"0.18\"></div></div><div class=\"field-row\"><div><label class=\"field-label\" for=\"watermark-font\">Font</label><div id=\"watermark-font-picker\"></div><input id=\"watermark-font\" type=\"hidden\" value=\"helvetica\"></div><div><label class=\"field-label\" for=\"watermark-color\">Text colour</label><input id=\"watermark-color\" class=\"field-control color-control\" type=\"color\" value=\"#595a73\"></div></div><div class=\"check-row\"><label class=\"check-field\"><input id=\"watermark-bold\" type=\"checkbox\"> Bold</label><label class=\"check-field\"><input id=\"watermark-italic\" type=\"checkbox\"> Italic</label><label class=\"check-field\"><input id=\"watermark-underline\" type=\"checkbox\"> Underline</label></div><div class=\"field-row\"><div class=\"angle-control\"><label class=\"field-label\" for=\"watermark-angle\">Rotation (°)</label><div class=\"angle-dial\" id=\"watermark-angle-dial\" aria-hidden=\"true\">\n<svg viewBox=\"0 0 100 100\" class=\"angle-dial-svg\"><circle cx=\"50\" cy=\"50\" r=\"40\" class=\"angle-track\"/><path class=\"angle-progress\" id=\"watermark-angle-progress\" fill=\"none\" stroke-width=\"8\" stroke-linecap=\"round\"/><circle cx=\"50\" cy=\"10\" r=\"4.5\" class=\"angle-handle\" id=\"watermark-angle-handle\"/></svg>\n</div><div class=\"angle-stepper\"><input id=\"watermark-angle\" class=\"angle-stepper-input\" type=\"number\" min=\"0\" max=\"360\" step=\"1\" value=\"45\" aria-label=\"Rotation angle in degrees\"><span class=\"angle-stepper-btns\"><button type=\"button\" class=\"angle-step-btn\" data-dir=\"1\" aria-label=\"Increase rotation angle\">+</button><button type=\"button\" class=\"angle-step-btn\" data-dir=\"-1\" aria-label=\"Decrease rotation angle\">−</button></span></div></div><div class=\"pos-control\"><label class=\"field-label\">Position on page (%)</label><div class=\"pos-grid\"><label for=\"watermark-pos-x\">X</label><input id=\"watermark-pos-x\" class=\"field-control\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"50\"><label for=\"watermark-pos-y\">Y</label><input id=\"watermark-pos-y\" class=\"field-control\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"50\"></div></div></div><p class=\"field-help\">Drag the watermark on the page to move it, or set X and Y here. Drag around the dial or use the up/down buttons to set the rotation angle. All settings apply to every page.</p>"
  },
  "pdf-remove-metadata": {
    "title": "Remove PDF metadata",
    "description": "Inspect the document properties, then remove the ones you choose.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file. Its metadata is inspected before anything is changed.",
    "options": "<div class=\"meta-panel\" id=\"metadata-panel\"><p class=\"meta-empty\">Add a PDF to inspect its metadata. Nothing is removed until you review the properties and confirm.</p></div>"
  },
  "image-watermark": {
    "title": "Watermark image",
    "description": "Add a text watermark to images.",
    "accept": "image/*",
    "hint": "Supported input: common browser-readable images",
    "options": "<label class=\"field-label\" for=\"wm-text\">Watermark text</label><input id=\"wm-text\" class=\"field-control\" type=\"text\" value=\"© iLoveMyFiles\" maxlength=\"80\"><div class=\"field-row\"><div><label class=\"field-label\" for=\"wm-position\">Position</label><select id=\"wm-position\" class=\"field-control\"><option value=\"bottom-right\">Bottom right</option><option value=\"bottom-left\">Bottom left</option><option value=\"top-right\">Top right</option><option value=\"top-left\">Top left</option><option value=\"center\">Centre</option></select></div><div><label class=\"field-label\" for=\"wm-color\">Colour</label><input id=\"wm-color\" class=\"field-control\" type=\"color\" value=\"#ffffff\"></div></div><div class=\"field-row\"><div><label class=\"field-label\" for=\"wm-opacity\">Opacity <output id=\"wm-opacity-value\">60%</output></label><input id=\"wm-opacity\" class=\"range-control\" type=\"range\" min=\"0.1\" max=\"1\" step=\"0.05\" value=\"0.6\"></div><div><label class=\"field-label\" for=\"wm-size\">Size (% of image)</label><input id=\"wm-size\" class=\"field-control\" type=\"number\" min=\"2\" max=\"40\" value=\"6\"></div></div><label class=\"field-label\" for=\"wm-format\">Output format</label><select id=\"wm-format\" class=\"field-control\"><option value=\"image/webp\">WebP</option><option value=\"image/jpeg\" data-ext=\"jpg\">JPG</option><option value=\"image/jpeg\" data-ext=\"jpeg\">JPEG</option><option value=\"image/png\">PNG</option><option value=\"image/bmp\">BMP</option><option value=\"image/gif\">GIF</option><option value=\"image/x-icon\">ICO</option><option value=\"image/svg+xml\">SVG</option><option value=\"image/tiff\">TIFF</option></select>"
  },
  "images-pdf": {
    "title": "Images to PDF",
    "description": "Turn multiple images into one PDF, in the order shown.",
    "accept": "image/*",
    "hint": "Select multiple images. JPG, PNG and WebP are supported.",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"pdf-page-size\">Page size</label><select id=\"pdf-page-size\" class=\"field-control\"><option value=\"fit\">Fit image to page</option><option value=\"a4\">A4</option><option value=\"a3\">A3</option><option value=\"a2\">A2</option><option value=\"a5\">A5</option><option value=\"b5\">B5</option><option value=\"letter\">US Letter</option><option value=\"legal\">US Legal</option><option value=\"tabloid\">Tabloid (11×17)</option><option value=\"executive\">Executive</option></select></div><div><label class=\"field-label\" for=\"pdf-page-orientation\">Orientation</label><select id=\"pdf-page-orientation\" class=\"field-control\"><option value=\"portrait\">Portrait</option><option value=\"landscape\">Landscape</option><option value=\"auto\">Match image</option></select></div></div><div class=\"margin-control\"><div class=\"margin-head\"><span class=\"field-label\">Margin</span><span class=\"margin-unit\">pt</span></div><div class=\"margin-presets\" role=\"group\" aria-label=\"Margin presets\"><button type=\"button\" class=\"margin-preset active\" data-value=\"0\" data-target=\"pdf-margin\">0</button><button type=\"button\" class=\"margin-preset\" data-value=\"5\" data-target=\"pdf-margin\">5</button><button type=\"button\" class=\"margin-preset\" data-value=\"10\" data-target=\"pdf-margin\">10</button><button type=\"button\" class=\"margin-preset\" data-value=\"20\" data-target=\"pdf-margin\">20</button></div><div class=\"stepper\"><button type=\"button\" class=\"stepper-btn\" data-step=\"-1\" data-target=\"pdf-margin\" aria-label=\"Decrease margin\">−</button><input id=\"pdf-margin\" aria-label=\"Margin\" class=\"field-control\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"0\" inputmode=\"numeric\"><button type=\"button\" class=\"stepper-btn\" data-step=\"1\" data-target=\"pdf-margin\" aria-label=\"Increase margin\">+</button></div></div><p class=\"field-help\">No margin is added by default — with \"Fit image to page\" the page wraps each image exactly. Add a margin only if you want a border.</p>"
  },
  "pdf-merge": {
    "title": "Merge PDFs",
    "description": "Combine multiple PDF files into a single document.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose at least two PDF files.",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"merge-page-size\">Page size</label><select id=\"merge-page-size\" class=\"field-control\"><option value=\"original\" selected>Original (keep)</option><option value=\"a4\">A4</option><option value=\"a3\">A3</option><option value=\"a5\">A5</option><option value=\"a6\">A6</option><option value=\"b5\">B5</option><option value=\"b4\">B4</option><option value=\"letter\">US Letter</option><option value=\"legal\">US Legal</option><option value=\"tabloid\">Tabloid</option><option value=\"executive\">Executive</option><option value=\"statement\">Statement</option><option value=\"folio\">Folio</option></select></div><div><label class=\"field-label\" for=\"merge-orientation\">Orientation</label><select id=\"merge-orientation\" class=\"field-control\"><option value=\"auto\">Match each page</option><option value=\"portrait\">Portrait</option><option value=\"landscape\">Landscape</option></select></div></div><div class=\"margin-control\"><div class=\"margin-head\"><span class=\"field-label\">Margin</span><span class=\"margin-unit\">pt</span></div><div class=\"margin-presets\" role=\"group\" aria-label=\"Margin presets\"><button type=\"button\" class=\"margin-preset active\" data-value=\"0\" data-target=\"merge-margin\">0</button><button type=\"button\" class=\"margin-preset\" data-value=\"5\" data-target=\"merge-margin\">5</button><button type=\"button\" class=\"margin-preset\" data-value=\"10\" data-target=\"merge-margin\">10</button><button type=\"button\" class=\"margin-preset\" data-value=\"20\" data-target=\"merge-margin\">20</button></div><div class=\"stepper\"><button type=\"button\" class=\"stepper-btn\" data-step=\"-1\" data-target=\"merge-margin\" aria-label=\"Decrease margin\">−</button><input id=\"merge-margin\" aria-label=\"Margin\" class=\"field-control\" type=\"number\" min=\"0\" max=\"200\" step=\"1\" value=\"0\" inputmode=\"numeric\"><button type=\"button\" class=\"stepper-btn\" data-step=\"1\" data-target=\"merge-margin\" aria-label=\"Increase margin\">+</button></div></div><div class=\"field-actions\"><button type=\"button\" class=\"field-action\" id=\"merge-reset-page\">Reset this page</button><button type=\"button\" class=\"field-action field-action-primary\" id=\"merge-apply-all\">Apply to all pages</button></div><div class=\"field-row\"><div><label class=\"field-label\" for=\"merge-quality\">Output quality</label><select id=\"merge-quality\" class=\"field-control\"><option value=\"original\" selected>Original (keep, fastest)</option><option value=\"less\">High quality (smaller)</option><option value=\"recommended\">Balanced</option><option value=\"extreme\">Smallest (rasterized)</option></select></div></div><p class=\"field-help\">The large panel previews the merged result in order. Drag the page thumbnails on the right (or use the ‹ › buttons) to set the exact order — the preview follows live. Click a page in the preview or a thumbnail to select it; the size, orientation and margin above apply only to that page. Use Apply to all pages for a bulk change. \"Reset order\" restores the original file order. Margin of 0 keeps pages unchanged.</p>"
  },
  "pdf-split": {
    "title": "Split PDF pages",
    "description": "Extract selected pages or save each page as its own PDF in a ZIP.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one or more PDF files. Each file is split separately.",
    "options": "<label class=\"field-label\" for=\"split-mode\">Split mode</label><select id=\"split-mode\" class=\"field-control\"><option value=\"each\">Every page as a separate PDF (ZIP)</option><option value=\"selected\">Selected pages into one PDF</option></select><div id=\"split-pages-wrap\" hidden><label class=\"field-label\" for=\"split-pages\">Pages to extract</label><input id=\"split-pages\" class=\"field-control\" type=\"text\" placeholder=\"Example: 1-3, 5, 8\"><p class=\"field-help\">Page numbering starts at 1. Ranges are inclusive.</p></div>"
  },
  "pdf-compress": {
    "title": "Compress PDF",
    "description": "Shrink a PDF with a compression level.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<span class=\"field-label\">Compression level</span><div class=\"level-picker\" role=\"radiogroup\" aria-label=\"Compression level\"><label class=\"level-option\"><input type=\"radio\" name=\"compress-level\" value=\"extreme\"><span class=\"level-text\"><b>Extreme compression</b><small>Smallest file, lower quality</small></span></label><label class=\"level-option\"><input type=\"radio\" name=\"compress-level\" value=\"recommended\" checked><span class=\"level-text\"><b>Recommended compression</b><small>Good quality, good compression</small></span></label><label class=\"level-option\"><input type=\"radio\" name=\"compress-level\" value=\"less\"><span class=\"level-text\"><b>Less compression</b><small>High quality, larger file</small></span></label></div><p class=\"field-help\">Pages are re-rendered as images, so text is no longer selectable after compressing. Results vary by document.</p>"
  },
  "pdf-to-images": {
    "title": "PDF to images",
    "description": "Render PDF pages as PNG or JPG images.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"pti-format\">Output format</label><select id=\"pti-format\" class=\"field-control\"><option value=\"image/png\">PNG - lossless</option><option value=\"image/jpeg\">JPG - smaller</option></select></div><div><label class=\"field-label\" for=\"pti-dpi\">Resolution (DPI)</label><input id=\"pti-dpi\" class=\"field-control\" type=\"number\" min=\"36\" max=\"400\" value=\"150\"></div></div><label class=\"field-label\" for=\"pti-pages\">Pages (optional)</label><input id=\"pti-pages\" class=\"field-control\" type=\"text\" placeholder=\"All pages\"><p class=\"field-help\">Leave the page box empty to render every page. Click pages in the preview to choose them. Higher DPI means larger images.</p>"
  },
  "pdf-organize": {
    "title": "Organize PDF pages",
    "description": "Reorder, duplicate or drop pages.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<label class=\"field-label\" for=\"organize-order\">New page order</label><input id=\"organize-order\" class=\"field-control\" type=\"text\" placeholder=\"Example: 3, 1, 2\"><p class=\"field-help\">List pages in the order you want. Repeat a number to duplicate a page, use ranges such as 1-3, or omit a page to drop it. Page numbering starts at 1.</p>"
  },
  "data-json": {
    "mode": "text",
    "title": "JSON formatter",
    "description": "Format, minify and validate JSON.",
    "accept": "",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"json-mode\">Mode</label><select id=\"json-mode\" class=\"field-control\"><option value=\"pretty\">Pretty-print</option><option value=\"minify\">Minify</option></select></div><div><label class=\"field-label\" for=\"json-indent\">Indent</label><input id=\"json-indent\" class=\"field-control\" type=\"number\" min=\"0\" max=\"8\" value=\"2\"></div></div>"
  },
  "data-base64": {
    "mode": "text",
    "title": "Base64 encoder",
    "description": "Encode text to Base64 or decode it back.",
    "accept": "",
    "options": "<label class=\"field-label\" for=\"base64-mode\">Mode</label><select id=\"base64-mode\" class=\"field-control\"><option value=\"encode\">Encode text → Base64</option><option value=\"decode\">Decode Base64 → text</option></select><p class=\"field-help\">UTF-8 safe, so accents and emoji survive the round trip.</p>"
  },
  "data-hash": {
    "title": "Hash generator",
    "description": "Create SHA-256, SHA-384 or SHA-512 hashes of text or files.",
    "accept": "*/*",
    "hint": "Hash text in the box, or drop one or more files to hash their contents.",
    "options": "<label class=\"field-label\" for=\"hash-algorithm\">Algorithm</label><select id=\"hash-algorithm\" class=\"field-control\"><option value=\"SHA-256\">SHA-256</option><option value=\"SHA-384\">SHA-384</option><option value=\"SHA-512\">SHA-512</option></select><p class=\"field-help\">Paste text, or drop files to hash their raw bytes. Multiple files produce one hash per file. Runs locally with the Web Crypto API.</p>"
  },
  "data-wordcount": {
    "mode": "text",
    "title": "Word counter",
    "description": "Count words, characters, lines and reading time.",
    "accept": "",
    "options": "<p class=\"field-help\">Paste or type text above to see word, character, line and sentence counts plus an estimated reading time.</p>"
  },
  "data-json-csv": {
    "mode": "text",
    "title": "JSON ↔ CSV",
    "description": "Convert between JSON arrays and CSV tables.",
    "accept": "",
    "options": "<label class=\"field-label\" for=\"jsoncsv-mode\">Direction</label><select id=\"jsoncsv-mode\" class=\"field-control\"><option value=\"json-to-csv\">JSON array → CSV</option><option value=\"csv-to-json\">CSV → JSON</option></select><p class=\"field-help\">JSON should be an array of objects. CSV should have a header row.</p>"
  },
  "data-units": {
    "mode": "text",
    "title": "Unit converter",
    "description": "Convert data size, length, mass and time units.",
    "accept": "",
    "options": "<label class=\"field-label\" for=\"units-category\">Category</label><select id=\"units-category\" class=\"field-control\"><option value=\"data-size\">Data size (from bytes)</option><option value=\"length\">Length (from metres)</option><option value=\"mass\">Mass (from grams)</option><option value=\"time\">Time (from seconds)</option></select><p class=\"field-help\">Type a value in the base unit shown, then run the tool to see it in every other unit.</p>"
  },
  "qr-code": {
    "mode": "text",
    "title": "QR code generator",
    "description": "Create a QR code PNG from any text or link.",
    "accept": "",
    "options": "<div class=\"field-row\"><div><label class=\"field-label\" for=\"qr-level\">Error correction</label><select id=\"qr-level\" class=\"field-control\"><option value=\"L\">Low (smallest)</option><option value=\"M\" selected>Medium</option><option value=\"Q\">Quartile</option><option value=\"H\">High (most robust)</option></select></div><div><label class=\"field-label\" for=\"qr-size\">Pixel size</label><input id=\"qr-size\" class=\"field-control\" type=\"number\" min=\"2\" max=\"24\" value=\"8\"></div></div><p class=\"field-help\">Enter a URL or any text in the box, then run the tool to generate a downloadable PNG.</p>"
  },
  "barcode": {
    "mode": "text",
    "title": "Barcode generator",
    "description": "Create Code 128, EAN-13 and more as PNG.",
    "accept": "",
    "options": "<label class=\"field-label\" for=\"barcode-format\">Format</label><select id=\"barcode-format\" class=\"field-control\"><option value=\"CODE128\">Code 128 (any text)</option><option value=\"EAN13\">EAN-13 (12–13 digits)</option><option value=\"UPC\">UPC-A (11–12 digits)</option><option value=\"CODE39\">Code 39</option><option value=\"ITF14\">ITF-14 (14 digits)</option></select><div class=\"field-row\"><div><label class=\"field-label\" for=\"barcode-width\">Bar width</label><input id=\"barcode-width\" class=\"field-control\" type=\"number\" min=\"1\" max=\"6\" value=\"2\"></div><div><label class=\"field-label\" for=\"barcode-height\">Height (px)</label><input id=\"barcode-height\" class=\"field-control\" type=\"number\" min=\"30\" max=\"200\" value=\"90\"></div></div><p class=\"field-help\">Enter the value to encode in the box, then run the tool to generate a downloadable PNG.</p>"
  },
  "ocr": {
    "title": "OCR - image & PDF",
    "description": "Extract selectable text from an image or PDF.",
    "accept": "image/*,application/pdf,.pdf",
    "hint": "Choose one image or PDF file.",
    "options": "<label class=\"field-label\" for=\"ocr-lang\">Document language</label><select id=\"ocr-lang\" class=\"field-control\"><option value=\"eng\" selected>English</option><option value=\"spa\">Spanish</option><option value=\"fra\">French</option><option value=\"deu\">German</option><option value=\"ita\">Italian</option><option value=\"por\">Portuguese</option><option value=\"nld\">Dutch</option><option value=\"rus\">Russian</option><option value=\"ara\">Arabic</option><option value=\"chi_sim\">Chinese (Simplified)</option><option value=\"jpn\">Japanese</option></select><p class=\"field-help\">The OCR engine and language data (a few MB) download on first use and are cached by your browser. Your file is processed locally and never uploaded.</p>"
  },
  "pdf-flatten": {
    "title": "Flatten PDF",
    "description": "Render each page to an image so the text layer is removed.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one PDF file.",
    "options": "<label class=\"field-label\" for=\"flatten-dpi\">Output resolution</label><select id=\"flatten-dpi\" class=\"field-control\"><option value=\"110\">110 DPI — smallest</option><option value=\"150\" selected>150 DPI — balanced</option><option value=\"200\">200 DPI — sharp</option><option value=\"300\">300 DPI — print (large)</option></select><label class=\"field-label\" for=\"flatten-quality\">Image quality</label><select id=\"flatten-quality\" class=\"field-control\"><option value=\"low\">Low (JPEG 60%)</option><option value=\"medium\">Medium (JPEG 80%)</option><option value=\"high\" selected>High (JPEG 92%)</option><option value=\"lossless\">Lossless (PNG)</option></select><p class=\"field-help\">Flattening removes the selectable text layer, but it can increase the file size, break text search and copy/paste, and reduce accessibility. It does <b>not</b> make a document confidential — OCR can still read the page images.</p>"
  },
  "pdf-ocr": {
    "title": "Make PDF searchable",
    "description": "Add an invisible, selectable text layer to a scanned PDF with OCR.",
    "accept": "application/pdf,.pdf",
    "hint": "Choose one scanned or image-only PDF.",
    "options": "<label class=\"field-label\" for=\"pdf-ocr-lang\">Document language</label><select id=\"pdf-ocr-lang\" class=\"field-control\"><option value=\"eng\" selected>English</option><option value=\"spa\">Spanish</option><option value=\"fra\">French</option><option value=\"deu\">German</option><option value=\"ita\">Italian</option><option value=\"por\">Portuguese</option><option value=\"nld\">Dutch</option><option value=\"swe\">Swedish</option><option value=\"dan\">Danish</option><option value=\"nor\">Norwegian</option><option value=\"fin\">Finnish</option></select><label class=\"field-label\" for=\"pdf-ocr-dpi\">Render resolution</label><select id=\"pdf-ocr-dpi\" class=\"field-control\"><option value=\"110\">110 DPI — fastest</option><option value=\"150\" selected>150 DPI — balanced</option><option value=\"200\">200 DPI — sharper OCR</option><option value=\"300\">300 DPI — best accuracy (slow, large)</option></select><label class=\"field-label\" for=\"pdf-ocr-quality\">Output image quality</label><select id=\"pdf-ocr-quality\" class=\"field-control\"><option value=\"low\">Low (JPEG 60%)</option><option value=\"medium\">Medium (JPEG 80%)</option><option value=\"high\" selected>High (JPEG 92%)</option><option value=\"lossless\">Lossless (PNG)</option></select><p class=\"field-help\">OCR runs locally with Tesseract.js. The engine and language data (a few MB) download from a CDN on first use and are then cached. Pages are rasterised, so the original look is kept but any existing selectable text is replaced by the new text layer.</p>"
  }
}
