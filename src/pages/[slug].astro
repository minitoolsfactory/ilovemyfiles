---
import BaseLayout from '../layouts/BaseLayout.astro';
import toolData from '../data/tools.json';
import ToolSeoContent from '../components/ToolSeoContent.astro';
import ToolWorkspace from '../components/ToolWorkspace.astro';
import ClientRuntime from '../components/client/ClientRuntime.astro';
import ToolStyles from '../components/ToolStyles.astro';

const { TOOLS } = toolData;
export function getStaticPaths() {
  return toolData.TOOLS.map(tool => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
const tool = TOOLS.find(item => item.slug === slug);
---
<BaseLayout>
  <ToolStyles />
  <Fragment slot="head">
    <title>{tool?.seo?.title ?? 'iLoveMyFiles'}</title>
    <meta name="description" content={tool?.seo?.description ?? ''} />
    <link rel="canonical" href={`https://ilovemyfiles.com/${slug}/`} />
    <meta property="og:title" content={tool?.seo?.title ?? 'iLoveMyFiles'} />
    <meta property="og:description" content={tool?.seo?.description ?? ''} />
    <meta property="og:url" content={`https://ilovemyfiles.com/${slug}/`} />
    <meta property="og:type" content="website" />
  </Fragment>
  {tool && (
    <section class="tool-view tool-page-view">
      <ToolSeoContent tool={tool}>
        <ToolWorkspace tool={tool} />
      </ToolSeoContent>
    </section>
  )}
  <ClientRuntime />
</BaseLayout>
