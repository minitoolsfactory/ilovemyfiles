---
import toolData from '../../data/tools.json';
import BaseLayout from '../../layouts/BaseLayout.astro';

const blogFiles = import.meta.glob('../../data/blog/*.json', { eager:true, import:'default' });
const posts = Object.values(blogFiles);
export function getStaticPaths() {
  const files = import.meta.glob('../../data/blog/*.json', { eager:true, import:'default' });
  return Object.values(files).map(post => ({ params:{slug:post.slug} }));
}
const slug = Astro.params.slug;
const post = posts.find(item => item.slug === slug);
const relatedTools = post ? post.relatedTools.map(id => toolData.TOOLS.find(tool => tool.id === id)).filter(Boolean) : [];
const pathFor = tool => tool.section === 'tools' ? `/tools/${tool.slug}/` : `/${tool.slug}/`;
const canonical = `https://ilovemyfiles.com/blog/${slug}/`;
const structuredData = post ? {
  '@context':'https://schema.org',
  '@type':'BlogPosting',
  headline:post.title,
  description:post.description,
  datePublished:post.date,
  dateModified:post.date,
  mainEntityOfPage:canonical,
  author:{'@type':'Organization',name:'iLoveMyFiles'},
  publisher:{'@type':'Organization',name:'iLoveMyFiles'}
} : null;
const faqData = post?.faq?.length ? {'@context':'https://schema.org','@type':'FAQPage',mainEntity:post.faq.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))} : null;
---
<BaseLayout>
  <Fragment slot="head">
    <title>{post ? `${post.title} | iLoveMyFiles` : 'Article not found | iLoveMyFiles'}</title>
    <meta name="description" content={post?.description ?? 'Browse practical file guides from iLoveMyFiles.'}>
    <meta name="robots" content={post ? 'index,follow' : 'noindex,follow'}>
    <link rel="canonical" href={canonical}>
    <meta property="og:title" content={post?.title ?? 'iLoveMyFiles Blog'}>
    <meta property="og:description" content={post?.description ?? ''}>
    <meta property="og:url" content={canonical}>
    <meta property="og:type" content="article">
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {faqData && <script type="application/ld+json" set:html={JSON.stringify(faqData)} />}
  </Fragment>
  {post ? <main class="article-page">
    <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span aria-current="page">{post.title}</span></nav>
    <article>
      <header class="article-header">
        <a class="article-category" href="/blog/">{post.category}</a>
        <h1>{post.title}</h1>
        <p class="article-description">{post.description}</p>
        <div class="article-byline"><span>iLoveMyFiles Editorial</span><span aria-hidden="true">·</span><time datetime={post.date}>{new Date(`${post.date}T12:00:00Z`).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time><span aria-hidden="true">·</span><span>{post.readTime}</span></div>
        <div class="article-audio-controls" role="group" aria-label="Listen to this article">
          <button type="button" class="article-listen-button" data-audio-play aria-pressed="false"><span class="audio-play-icon" aria-hidden="true">▶</span><span data-audio-label>Listen to article</span></button>
          <button type="button" class="article-audio-stop" data-audio-stop disabled>Stop</button>
          <label class="article-voice-label">Voice <select data-audio-voice aria-label="Reading voice"><option value="">System default</option></select></label>
          <span class="article-audio-status" data-audio-status role="status" aria-live="polite">Audio is read aloud by your browser.</span>
        </div>
      </header>
      <div class="article-layout">
        <div class="article-body">
          <p class="article-lead" data-audio-content>{post.intro}</p>
          {post.sections.map(section => <section class="article-section" data-audio-content><h2>{section.heading}</h2>{section.paragraphs.map(paragraph => <p set:html={paragraph} />)}</section>)}
          {post.faq?.length > 0 && <section class="article-faq" data-audio-content><h2>Frequently asked questions</h2>{post.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}
          <p class="article-disclaimer">Tool behavior and supported formats can change. Check the linked tool page for current options, limits and processing details. Keep an original copy of important files.</p>
        </div>
        <aside class="article-related"><h2>Related tools</h2><p>Continue with a tool for this task.</p><div>{relatedTools.map(tool => <a href={pathFor(tool)}><span class={`tool-icon icon-${tool.icon}`} aria-hidden="true"><svg viewBox="0 0 24 24" set:html={tool.svg}></svg></span><span><b>{tool.cardTitle}</b><small>{tool.cardText}</small></span><i aria-hidden="true">↗</i></a>)}</div><a class="all-guides-link" href="/blog/">More guides →</a></aside>
      </div>
    </article>
  </main> : <main class="article-page article-missing"><h1>Article not found</h1><p>This guide may have moved. Browse the latest articles instead.</p><a href="/blog/">View all guides →</a></main>}
  <style is:global>
    .article-page{max-width:1160px;margin:0 auto;padding:32px 28px 76px}
    .article-breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:0 0 36px;color:var(--color-text-muted);font-size:12px;line-height:1.5}
    .article-breadcrumb a{color:var(--color-text-secondary);text-decoration:none}.article-breadcrumb a:hover{color:#2563eb}
    .article-header{max-width:790px;margin:0 auto 38px;text-align:center}
    .article-category{display:inline-block;padding:6px 10px;border-radius:999px;background:#eff6ff;color:#315fc2;font-size:11px;font-weight:650;text-decoration:none}
    .article-header h1{margin:16px 0 12px;color:var(--color-text-primary);font-size:clamp(34px,4.5vw,50px);line-height:1.1;letter-spacing:-1.7px}
    .article-description{margin:0 auto;color:var(--color-text-secondary);font-size:17px;line-height:1.55}
    .article-byline{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px;margin-top:18px;color:var(--color-text-muted);font-size:11px}
    .article-audio-controls{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:9px;margin:20px auto 0;padding:10px 12px;width:max-content;max-width:100%;border:1px solid var(--color-border);border-radius:12px;background:var(--color-surface)}
    .article-listen-button,.article-audio-stop{min-height:36px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 12px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface);color:var(--color-text-primary);font:600 12px/1 ui-sans-serif,system-ui,sans-serif;cursor:pointer}
    .article-listen-button{border-color:#2563eb;background:#2563eb;color:#fff}.article-listen-button:hover{background:#1d4ed8}.article-audio-stop:hover:not(:disabled){border-color:#cbd5e1;background:var(--color-surface-soft)}.article-audio-stop:disabled{opacity:.48;cursor:not-allowed}
    .audio-play-icon{font-size:10px}.article-voice-label{display:flex;align-items:center;gap:6px;color:var(--color-text-muted);font-size:11px}.article-voice-label select{max-width:150px;min-height:34px;padding:0 24px 0 8px;border:1px solid var(--color-border);border-radius:7px;background:var(--color-surface);color:var(--color-text-primary);font:inherit}.article-audio-status{flex-basis:100%;color:var(--color-text-muted);font-size:10px;text-align:center}
    .article-layout{display:grid;grid-template-columns:minmax(0,740px) 270px;justify-content:center;align-items:start;gap:46px}
    .article-body{min-width:0;color:var(--color-text-primary);font-size:16px;line-height:1.8}
    .article-lead{margin:0 0 30px;color:var(--color-text-secondary);font-size:18px;line-height:1.75}
    .article-section{margin:0 0 27px}.article-section h2,.article-faq h2{margin:0 0 9px;color:var(--color-text-primary);font-size:23px;line-height:1.3;letter-spacing:-.45px}
    .article-section p{margin:0 0 13px;color:var(--color-text-secondary)}.article-body a{color:#1d4ed8;text-decoration:underline;text-underline-offset:3px}.article-body a:hover{color:#1e40af}
    .article-faq{margin-top:34px}.article-faq details{margin:10px 0;padding:13px 15px;border:1px solid var(--color-border);border-radius:10px;background:var(--color-surface)}.article-faq summary{cursor:pointer;color:var(--color-text-primary);font-size:14px;font-weight:650}.article-faq details p{margin:9px 0 0;color:var(--color-text-secondary);font-size:14px;line-height:1.65}
    .article-disclaimer{margin-top:34px;padding:13px 15px;border-left:3px solid #93b4f5;background:var(--color-surface-soft);color:var(--color-text-muted);font-size:12px;line-height:1.6}
    .article-related{position:sticky;top:88px;padding:17px;border:1px solid var(--color-border);border-radius:13px;background:var(--color-surface)}.article-related h2{margin:0 0 5px;font-size:16px;color:var(--color-text-primary)}.article-related>p{margin:0 0 13px;color:var(--color-text-muted);font-size:11px}.article-related>div{display:grid;gap:8px}
    .article-related>div>a{display:grid;grid-template-columns:34px minmax(0,1fr) 12px;align-items:center;gap:9px;padding:9px;border:1px solid var(--color-border);border-radius:9px;color:var(--color-text-primary);text-decoration:none}.article-related>div>a:hover{border-color:#bfd0f5;background:var(--color-surface-soft)}.article-related .tool-icon{width:32px;height:32px;flex-basis:32px;border-radius:8px}.article-related .tool-icon svg{width:18px;height:18px}.article-related>div>a b,.article-related>div>a small{display:block}.article-related>div>a b{font-size:11px;line-height:1.35}.article-related>div>a small{margin-top:3px;color:var(--color-text-muted);font-size:9px;line-height:1.35}.article-related>div>a i{color:#315fc2;font-style:normal}.all-guides-link{display:block;margin-top:14px;color:#2563eb;font-size:12px;font-weight:650;text-decoration:none}
    .article-missing{min-height:45vh;text-align:center;padding-top:100px}.article-missing p{color:var(--color-text-secondary)}.article-missing>a{color:#2563eb}
    [data-theme="dark"] .article-category{background:#202b4a;color:#bfdbfe}
    [data-theme="dark"] .article-listen-button{color:#fff}
    [data-theme="dark"] .article-audio-controls{background:var(--color-surface)}
    @media(max-width:850px){.article-layout{grid-template-columns:minmax(0,740px);gap:24px}.article-related{position:static;grid-row:1}.article-related>div{grid-template-columns:1fr 1fr}}
    @media(max-width:600px){.article-page{padding:22px 16px 52px}.article-breadcrumb{margin-bottom:26px}.article-header{margin-bottom:28px}.article-header h1{font-size:34px;letter-spacing:-1px}.article-description{font-size:15px}.article-layout{gap:22px}.article-related>div{grid-template-columns:1fr}.article-body{font-size:15px}.article-lead{font-size:16px}.article-section h2,.article-faq h2{font-size:21px}}
  </style>
  <script>
    const root = document.querySelector('.article-page');
    const playButton = root?.querySelector('[data-audio-play]');
    const stopButton = root?.querySelector('[data-audio-stop]');
    const voiceSelect = root?.querySelector('[data-audio-voice]');
    const status = root?.querySelector('[data-audio-status]');
    const label = root?.querySelector('[data-audio-label]');
    const synth = window.speechSynthesis;
    let utterance = null;
    let voices = [];
    const readText = () => [...root.querySelectorAll('[data-audio-content]')].map(section => section.innerText.trim()).filter(Boolean).join('. ');
    const setState = (playing, text) => {
      playButton?.setAttribute('aria-pressed', String(playing));
      if (label) label.textContent = playing ? 'Pause reading' : 'Listen to article';
      if (playButton?.querySelector('.audio-play-icon')) playButton.querySelector('.audio-play-icon').textContent = playing ? 'Ⅱ' : '▶';
      if (stopButton) stopButton.disabled = !playing && !synth?.paused;
      if (status && text) status.textContent = text;
    };
    const loadVoices = () => {
      if (!voiceSelect || !synth) return;
      voices = synth.getVoices();
      const selected = voiceSelect.value;
      voiceSelect.replaceChildren(new Option('System default',''));
      voices.forEach((voice,index) => voiceSelect.add(new Option(`${voice.name} (${voice.lang})`,String(index))));
      if (selected && voices[Number(selected)]) voiceSelect.value = selected;
    };
    loadVoices();
    if (synth) synth.addEventListener?.('voiceschanged',loadVoices);
    playButton?.addEventListener('click',() => {
      if (!synth) { if(status)status.textContent='Read-aloud is not supported in this browser.'; return; }
      if (synth.speaking && !synth.paused) { synth.pause(); setState(false,'Reading paused.'); return; }
      if (synth.paused) { synth.resume(); setState(true,'Reading article aloud.'); return; }
      const text = readText();
      if (!text) { if(status)status.textContent='There is no article text available to read.'; return; }
      utterance = new SpeechSynthesisUtterance(text);
      const voice = voices[Number(voiceSelect?.value)];
      if (voice) { utterance.voice = voice; utterance.lang = voice.lang; }
      utterance.onstart = () => setState(true,'Reading article aloud.');
      utterance.onend = () => { utterance=null; setState(false,'Finished reading.'); };
      utterance.onerror = () => { utterance=null; setState(false,'Audio could not be played. Try another browser voice.'); };
      synth.cancel(); synth.speak(utterance);
      setState(true,'Starting read-aloud…');
    });
    stopButton?.addEventListener('click',() => { synth?.cancel(); utterance=null; setState(false,'Reading stopped.'); });
    window.addEventListener('pagehide',() => synth?.cancel(),{once:true});
  </script>
</BaseLayout>
