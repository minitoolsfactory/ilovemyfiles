---
import toolData from "../data/tools.json";
import cbseTool from "../data/cbse-tool.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeToolFilters from "../components/HomeToolFilters.astro";
import HomeStyles from "../components/HomeStyles.astro";

const { TOOLS, CATEGORIES } = toolData;
const categoryIcons = {
  'pdf-tools': '▤', 'other-work': '✦', 'organize-pdf': '↕', 'optimize-pdf': '◌',
  'to-pdf': '＋', 'convert-pdf': '⇄', 'security-pdf': '⌑', 'edit-pdf': '✎',
  image: '▧', data: '{}', developer: '</>', ai: '✧', seo: '⌕'
};
const isPdfCategory = id => id === 'to-pdf' || id.endsWith('-pdf');
const categoryCount = id => id === 'all'
  ? TOOLS.length
  : id === 'pdf-tools'
    ? TOOLS.filter(tool => isPdfCategory(tool.category)).length
    : id === 'other-work'
      ? TOOLS.filter(tool => !isPdfCategory(tool.category)).length
      : TOOLS.filter(tool => tool.category === id).length;
const toolById = id => TOOLS.find(tool => tool.id === id);
const icon = (tool, large = false) => `<span class="tool-icon icon-${tool.icon}${large ? ' tool-icon-lg' : ''}" aria-hidden="true"><svg viewBox="0 0 24 24">${tool.svg}</svg></span>`;
const popular = ['pdf-merge', 'pdf-compress', 'images-pdf', 'image-resize', 'image-convert'].map(toolById).filter(Boolean);
---
<BaseLayout>
  <HomeStyles />
  <Fragment slot="head">
    <meta name="description" content="Free, private file tools. Convert, compress and resize images, create PDFs, merge PDFs and split PDF pages directly in your browser.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://ilovemyfiles.com/">
    <title>iLoveMyFiles - Free Online Image & PDF Tools</title>
  </Fragment>

  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-icon" aria-hidden="true">✦</span> PRIVATE FILE TOOLS · NO UPLOADS</div>
      <h1>Get file tasks<br><span>out of your way.</span></h1>
      <p class="hero-subtitle">Convert, compress, organise and edit files with a clear, focused toolkit. Processing happens in your browser, so your documents stay on your device.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/#tools">Find your tool <span aria-hidden="true">↘</span></a>
        <span class="micro-trust"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2 16 4v5c0 4-2.5 7-6 9-3.5-2-6-5-6-9V4z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m7 10 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Free · no account · runs locally</span>
      </div>
      <div class="hero-proof" aria-label="At a glance"><span><b>{TOOLS.length}</b> practical tools</span><span><b>0</b> file uploads</span><span><b>100%</b> browser-based</span></div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
      <div class="file-card file-card-back"><div class="fake-lines"></div><div class="fake-lines short"></div><div class="fake-lines"></div></div>
      <div class="file-card file-card-front"><div class="image-glyph"><span></span><i></i></div><div class="file-label">your-file.webp</div><div class="file-meta">IMAGE · 2.4 MB</div><div class="convert-arrow">↓</div><div class="file-output"><span class="output-icon">✓</span><div><b>Optimized</b><small>640 KB · ready to save</small></div></div></div>
      <div class="floating-chip chip-lock"><span>⌑</span> Private by design</div><div class="floating-chip chip-speed"><span>↯</span> Fast in-browser tools</div>
    </div>
  </section>

  <section class="quick-section" id="popular-section" aria-label="Popular tools">
    <div class="quick-head"><h2>Popular tools</h2><a class="quick-browse" href="#tools">Browse all tools <span aria-hidden="true">→</span></a></div>
    <div class="quick-grid" id="popular-grid">
      {popular.map(tool => (
        <a href={tool.section === 'tools' ? `/tools/${tool.slug}/` : `/${tool.slug}/`} class="quick-card" data-tool={tool.id} data-tool-id={tool.id}>
          <span set:html={icon(tool)} />
          <b>{tool.cardTitle}</b>
        </a>
      ))}
    </div>
  </section>

  <section class="trust-strip" aria-label="iLoveMyFiles benefits">
    <div><span class="trust-icon" aria-hidden="true">◎</span><span><b>Private by default</b><small>Files stay on your device</small></span></div>
    <div><span class="trust-icon" aria-hidden="true">ϟ</span><span><b>Simple and focused</b><small>Choose a tool, get it done</small></span></div>
    <div><span class="trust-icon" aria-hidden="true">♧</span><span><b>Free to use</b><small>No account or subscription</small></span></div>
  </section>

  <section class="quick-section" id="recent-section" hidden aria-label="Recently used tools">
    <div class="quick-head">
      <h2>Recently used <span class="recent-count" id="recent-count" aria-hidden="true"></span></h2>
      <button type="button" class="recent-clear" data-clear-recent title="Clear recently used tools" aria-label="Clear recently used tools">Clear</button>
    </div>
    <div class="quick-grid" id="recent-grid"></div>
  </section>

  <section class="tools-section" id="tools">
    <div class="section-heading">
      <div><div class="eyebrow">THE TOOLKIT</div><h2>What would you like to do?</h2><p>Search {TOOLS.length} tools, or browse by the kind of task you need to finish.</p></div>
      <div class="search-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="tool-search" type="search" placeholder="Try ‘merge PDF’ or ‘resize image’" aria-label="Search tools" aria-describedby="search-hint" autocomplete="off"><span id="search-hint" class="sr-only">Search tool names, descriptions and keywords. Results update as you type.</span><kbd class="search-shortcut" aria-hidden="true">/</kbd></div>
    </div>
    <div class="category-tabs" id="category-tabs" role="group" aria-label="Filter tools">
      {CATEGORIES.map(cat => (
        <button type="button" class={`category-tab${cat.id === 'all' ? ' active' : ''}`} data-filter={cat.id} aria-pressed={cat.id === 'all' ? 'true' : 'false'}><span class="category-symbol" aria-hidden="true">{categoryIcons[cat.id] ?? '•'}</span><span class="category-label">{cat.label}</span><span class="category-count">{categoryCount(cat.id)}</span></button>
      ))}
    </div>
    <div class="tool-catalog-meta" aria-live="polite"><span><b>{TOOLS.length}</b> tools available</span><span>Choose a category or search all tools</span></div>
    <div class="tool-grid" id="tool-grid">
      {TOOLS.map(tool => (
        <a href={tool.section === 'tools' ? `/tools/${tool.slug}/` : `/${tool.slug}/`} class="tool-card" data-tool={tool.id} data-tool-id={tool.id} data-category={tool.category} data-search={`${tool.cardTitle} ${tool.cardText} ${tool.keywords.join(' ')}`.toLowerCase()}>
          <span set:html={icon(tool)} />
          <span class="tool-card-content">
            <b>{tool.cardTitle}</b>
            <span>{tool.cardText}</span>
            <small>{tool.tag}</small>
          </span>
          <span class="tool-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
      <a href={`/${cbseTool.slug}/`} class="tool-card" data-tool={cbseTool.id} data-tool-id={cbseTool.id} data-category={cbseTool.category} data-country-gated={cbseTool.id} hidden>
        <span set:html={icon(cbseTool)} />
        <span class="tool-card-content">
          <b>{cbseTool.cardTitle}</b>
          <span>{cbseTool.cardText}</span>
          <small>{cbseTool.tag}</small>
        </span>
        <span class="tool-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
    <div id="no-results" class="no-results" hidden><b>No matching tools yet</b><p>Try a shorter search, a different keyword, or select “All tools”.</p><button type="button" class="button button-ghost" id="clear-tool-search">Clear search and filters</button></div>
    <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
  </section>

  <section class="privacy-section" id="privacy">
    <div class="privacy-visual" aria-hidden="true"><div class="privacy-circle"><svg viewBox="0 0 64 64"><path d="M32 6 51 13v16c0 13-8 23-19 29C21 52 13 42 13 29V13z" fill="none" stroke="currentColor" stroke-width="2.6"/><rect x="24" y="27" width="16" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M27 27v-4a5 5 0 0 1 10 0v4" fill="none" stroke="currentColor" stroke-width="2.4"/></svg></div><span class="privacy-spark spark-a">✦</span><span class="privacy-spark spark-b">✧</span></div>
    <div class="privacy-copy"><div class="eyebrow">YOUR PRIVACY MATTERS</div><h2>Your files stay yours.<br><span>That’s the point.</span></h2>    <p>iLoveMyFiles processes files locally in your browser. Your selected files aren't sent to an iLoveMyFiles server. You stay in control from start to finish.</p><ul><li><span aria-hidden="true">✓</span> No file uploads for processing</li><li><span aria-hidden="true">✓</span> No account or sign-up required</li><li><span aria-hidden="true">✓</span> Your originals stay untouched</li></ul><p class="privacy-note">Your browser uses memory to process files. Large documents may take longer; close the tool when finished, especially on a shared device.</p></div>  </section>

  <section class="how-section" id="how-it-works">
    <div class="section-heading centered"><div><div class="eyebrow">THREE SIMPLE STEPS</div><h2>From file to finished.</h2><p>No confusing settings. No complicated workflow.</p></div></div>
    <ol class="steps-grid"><li class="step"><span class="step-number" aria-hidden="true">01</span><div class="step-symbol" aria-hidden="true">↥</div><h3>Choose your files</h3><p>Select one or more files from your device. They remain in your browser.</p></li><li class="step"><span class="step-number" aria-hidden="true">02</span><div class="step-symbol" aria-hidden="true">✳</div><h3>Set your options</h3><p>Choose the format, size or pages you want to work with.</p></li><li class="step"><span class="step-number" aria-hidden="true">03</span><div class="step-symbol" aria-hidden="true">↓</div><h3>Download the result</h3><p>Save your converted file or ZIP archive straight to your device.</p></li></ol>
  </section>
  <section class="bottom-cta"><div><h2>Ready to get it done?</h2><p>Your next file task is just a few clicks away.</p></div><a href="/#tools" class="button button-light">Choose a tool <span aria-hidden="true">↗</span></a></section>
  <HomeToolFilters />
</BaseLayout>
