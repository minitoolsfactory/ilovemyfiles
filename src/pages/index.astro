---
import toolData from '../data/tools.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeStyles from '../components/HomeStyles.astro';

const { TOOLS } = toolData;
const popularIds = ['image-compress','pdf-compress','pdf-to-images','images-pdf','image-resize','pdf-merge','pdf-split','image-convert'];
const featuredIds = ['image-compress','pdf-compress','pdf-to-images','images-pdf','image-resize','pdf-merge'];
const byId = id => TOOLS.find(tool => tool.id === id);
const popular = popularIds.map(byId).filter(Boolean);
const featured = featuredIds.map(byId).filter(Boolean);
const categories = [
  {id:'pdf-tools',label:'PDF tools',description:'Merge, compress, convert and protect PDF documents.',icon:'▤'},
  {id:'image',label:'Image tools',description:'Resize, convert, crop and optimise images.',icon:'▧'},
  {id:'data',label:'Data & text',description:'Format, convert and work with everyday data.',icon:'{}'},
  {id:'developer',label:'Developer tools',description:'Utilities for code, data and web workflows.',icon:'⌘'},
  {id:'ai',label:'AI tools',description:'Helpers for AI prompts and model usage.',icon:'✧'},
  {id:'seo',label:'SEO tools',description:'Practical tools for site checks and search work.',icon:'⌕'},
  {id:'games',label:'Games',description:'Fun browser-based games and quizzes.',icon:'🎮'},
];
const countFor = id => id === 'pdf-tools'
  ? TOOLS.filter(tool => tool.category === 'to-pdf' || tool.category.endsWith('-pdf')).length
  : TOOLS.filter(tool => tool.category === id).length;
const toolPath = tool => tool.section === 'tools' ? `/tools/${tool.slug}/` : tool.section === 'games' ? `/games/${tool.slug}/` : `/${tool.slug}/`;
const icon = tool => `<span class="tool-icon icon-${tool.icon}" aria-hidden="true"><svg viewBox="0 0 24 24">${tool.svg}</svg></span>`;
---
<BaseLayout>
  <HomeStyles />
  <Fragment slot="head">
    <meta name="description" content="Free online tools to convert, compress and manage files. Browse the complete toolkit and process files locally where supported.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://ilovemyfiles.com/">
    <title>iLoveMyFiles - Free Online File Tools</title>
  </Fragment>

  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-icon" aria-hidden="true">✦</span> {TOOLS.length}+ Free Online File Tools</div>
      <h1>Convert, compress,<br>edit &amp; <span>manage files.</span></h1>
      <p class="hero-subtitle">A thoughtful collection of free tools for everyday file tasks. Simple to use, with privacy-minded processing wherever supported.</p>
      <form class="hero-search" action="/tools/" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
        <input id="hero-tool-search" type="search" placeholder="Search tools, file types or tasks…" aria-label="Search file tools" autocomplete="off" aria-controls="hero-search-suggestions" aria-expanded="false">
        <kbd aria-hidden="true">/</kbd><button class="button button-primary" type="submit">Search</button>
        <div class="hero-search-suggestions" id="hero-search-suggestions" role="listbox" aria-label="Matching tools" hidden></div>
      </form>
      <div class="hero-actions"><a class="button button-primary" href="/tools/">Explore all tools <span aria-hidden="true">→</span></a></div>
      <div class="hero-benefits" aria-label="Benefits"><span><i aria-hidden="true">✓</i> 100% Free</span><span><i aria-hidden="true">⌑</i> No signup</span><span><i aria-hidden="true">◇</i> Privacy first</span></div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-art-glow"></div>
      <div class="hero-document document-main"><span class="doc-tag">PDF</span><i></i><i></i><i></i><b>report.pdf</b></div>
      <div class="hero-document document-output"><span class="doc-tag image-tag">IMG</span><div class="doc-photo"><span></span></div><b>Optimised image</b><small>Reduced file size</small></div>
      <div class="process-link">→</div><div class="hero-shield"><span>✓</span><small>Processed<br>securely</small></div>
      <div class="hero-art-caption"><span class="caption-dot"></span> Files stay in your control</div>
    </div>
  </section>

  <nav class="category-rail" aria-label="Popular tool categories">
    <a class="category-rail-all" href="/tools/">All tools</a>
    <a href="/tools/?category=pdf-tools"><span aria-hidden="true">▤</span> PDF Tools</a>
    <a href="/tools/?category=image"><span aria-hidden="true">▧</span> Image Tools</a>
    <a href="/tools/?category=data"><span aria-hidden="true">▤</span> Document Tools</a>
    <a href="/tools/?category=video"><span aria-hidden="true">▶</span> Video Tools</a>
    <a href="/tools/?category=audio"><span aria-hidden="true">♫</span> Audio Tools</a>
    <a href="/tools/?category=developer"><span aria-hidden="true">⌘</span> Developer Tools</a>
    <a href="/games/"><span aria-hidden="true">🎮</span> Games</a>
    <a href="/tools/#categories" class="category-rail-more">More <span aria-hidden="true">→</span></a>
  </nav>

  <section class="quick-section home-section" id="popular-section" aria-labelledby="popular-title">
    <div class="home-section-heading"><div><div class="eyebrow">GET STARTED</div><h2 id="popular-title">Popular tools</h2><p>Quick access to tools people use every day.</p></div><a class="quick-browse" href="/tools/">View all tools <span aria-hidden="true">→</span></a></div>
    <div class="quick-grid" id="popular-grid">{popular.map(tool => <a href={toolPath(tool)} class="quick-card" data-tool={tool.id} data-tool-id={tool.id}><span set:html={icon(tool)} /><span class="popular-copy"><b>{tool.cardTitle}</b><small>{tool.cardText}</small></span><span class="popular-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>

  <section class="featured-section home-section" aria-labelledby="featured-title">
    <div class="home-section-heading"><div><div class="eyebrow">CURATED PICKS</div><h2 id="featured-title">Featured tools</h2><p>Reliable essentials for common file tasks.</p></div><a class="quick-browse" href="/tools/">Explore the full directory <span aria-hidden="true">→</span></a></div>
    <div class="featured-grid">{featured.map((tool,index) => <a class={`featured-card featured-card-${index+1}`} href={toolPath(tool)}><span set:html={icon(tool)} /><span class="featured-copy"><small>FEATURED TOOL</small><b>{tool.cardTitle}</b><span>{tool.cardText}</span></span><span class="featured-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>

  <section class="browse-category-section home-section" id="categories" aria-labelledby="browse-categories-title">
    <div class="home-section-heading"><div><div class="eyebrow">BROWSE BY CATEGORY</div><h2 id="browse-categories-title">Find the right toolkit</h2><p>Explore tools grouped around the work you need to do.</p></div><a class="quick-browse" href="/tools/#categories">All categories <span aria-hidden="true">→</span></a></div>
    <div class="browse-category-grid">{categories.map(category => <a class="browse-category-card" href={category.id === 'games' ? '/games/' : `/tools/?category=${category.id}`}><span class="browse-category-icon" aria-hidden="true">{category.icon}</span><span class="browse-category-heading"><b>{category.label}</b><small>{countFor(category.id)} tools</small></span><p>{category.description}</p><span class="browse-category-link">Explore category <i aria-hidden="true">→</i></span></a>)}</div>
  </section>

  <section class="why-compact" id="about" aria-label="Why iLoveMyFiles">
    <div class="why-intro"><div class="eyebrow">MADE FOR EVERYDAY WORK</div><h2>Useful tools.<br>No unnecessary friction.</h2><p>Use supported tools without an account. When a tool processes files locally, your files stay in the browser; some features may rely on online services.</p></div>
    <ul class="why-points"><li><b>Free to use</b><span>No subscription to get started.</span></li><li><b>No registration</b><span>Open a tool and get straight to work.</span></li><li><b>Privacy-minded</b><span>Local processing where supported.</span></li><li><b>Works across devices</b><span>Responsive on mobile and desktop.</span></li></ul>
  </section>

  <section class="how-section home-section" id="how-it-works" aria-labelledby="how-title">
    <div class="home-section-heading centered"><div><div class="eyebrow">THREE SIMPLE STEPS</div><h2 id="how-title">From file to finished.</h2><p>A straightforward workflow, whatever the task.</p></div></div>
    <ol class="steps-grid"><li class="step"><span class="step-number" aria-hidden="true">01</span><div class="step-symbol" aria-hidden="true">⌕</div><h3>Select a tool</h3><p>Find the right tool from the catalogue or search.</p></li><li class="step"><span class="step-number" aria-hidden="true">02</span><div class="step-symbol" aria-hidden="true">↑</div><h3>Choose your file</h3><p>Upload or select a file as the tool requires.</p></li><li class="step"><span class="step-number" aria-hidden="true">03</span><div class="step-symbol" aria-hidden="true">↓</div><h3>Process and download</h3><p>Adjust the options, process and save your result.</p></li></ol>
  </section>

  <section class="home-faq home-section" aria-labelledby="home-faq-title"><div class="home-section-heading"><div><div class="eyebrow">HELP CENTRE</div><h2 id="home-faq-title">Frequently asked questions</h2></div></div><div class="home-faq-grid"><details><summary>Are the tools free to use?</summary><p>Yes. The tools are free to use; there is no subscription required to get started.</p></details><details><summary>Are my files uploaded?</summary><p>Many tools process files locally in your browser. Processing behavior depends on the individual tool; check its page for details.</p></details><details><summary>Do I need an account?</summary><p>No account is required for supported tools. Open a tool and follow its instructions.</p></details><details><summary>Can I use the tools on mobile?</summary><p>The site is responsive and works on modern mobile browsers, though some large files may work better on desktop.</p></details></div></section>
  <script>
    import tools from '../data/tools.json';
    const input = document.querySelector('#hero-tool-search');
    const list = document.querySelector('#hero-search-suggestions');
    const route = tool => tool.section === 'tools' ? `/tools/${tool.slug}/` : tool.section === 'games' ? `/games/${tool.slug}/` : `/${tool.slug}/`;
    const synonyms = {reduce:['compress','smaller','shrink'],photo:['image','picture'],join:['merge','combine'],convert:['change format','to'],cut:['split','separate']};
    let activeIndex = -1;
    let results = [];
    function search() {
      const query = input.value.trim().toLowerCase();
      results = query ? tools.TOOLS.map(tool => {
        const expanded = query.split(/\s+/).flatMap(word => [word, ...(synonyms[word] ?? [])]).join(' ');
        const haystack = `${tool.cardTitle} ${tool.cardText} ${tool.keywords.join(' ')}`.toLowerCase();
        const exact = haystack.includes(query);
        const score = (exact ? 10 : 0) + expanded.split(/\s+/).filter(word => haystack.includes(word)).length;
        return {tool,score};
      }).filter(item => item.score > 0).sort((a,b) => b.score-a.score).slice(0,6).map(item => item.tool) : [];
      activeIndex = -1;
      list.replaceChildren();
      if (!query) { list.hidden = true; input.setAttribute('aria-expanded','false'); return; }
      if (!results.length) { const empty = document.createElement('p'); empty.className='suggestion-empty'; empty.textContent='No matching tools. Try a different search.'; list.append(empty); }
      results.forEach((tool,index) => { const link=document.createElement('a'); link.href=route(tool); link.setAttribute('role','option'); link.setAttribute('aria-selected','false'); link.dataset.index=String(index); const title=document.createElement('b'); title.textContent=tool.cardTitle; const meta=document.createElement('small'); meta.textContent=tool.cardText; link.append(title,meta); list.append(link); });
      const all=document.createElement('a'); all.className='suggestion-all'; all.href=`/tools/?q=${encodeURIComponent(query)}`; all.textContent='See all matching tools →'; list.append(all);
      list.hidden=false; input.setAttribute('aria-expanded','true');
    }
    function setActive(index) { const options=[...list.querySelectorAll('[role="option"]')]; if(!options.length)return; activeIndex=(index+options.length)%options.length; options.forEach((option,i)=>{option.setAttribute('aria-selected',String(i===activeIndex)); if(i===activeIndex)option.scrollIntoView({block:'nearest'});}); }
    input.addEventListener('input',search);
    input.addEventListener('keydown',event=>{if(event.key==='ArrowDown'&&!list.hidden){event.preventDefault();setActive(activeIndex+1);}else if(event.key==='ArrowUp'&&!list.hidden){event.preventDefault();setActive(activeIndex-1);}else if(event.key==='Enter'&&activeIndex>=0){event.preventDefault();list.querySelector(`[data-index="${activeIndex}"]`)?.click();}else if(event.key==='Escape'){list.hidden=true;input.setAttribute('aria-expanded','false');}});
    document.addEventListener('click',event=>{if(!event.target.closest('.hero-search')){list.hidden=true;input.setAttribute('aria-expanded','false');}});
    document.addEventListener('keydown',event=>{if(event.key==='/'&&!event.metaKey&&!event.ctrlKey&&!event.altKey&&!/^(INPUT|TEXTAREA|SELECT)$/.test(event.target?.tagName??'')){event.preventDefault();input.focus();}});
  </script>
</BaseLayout>
