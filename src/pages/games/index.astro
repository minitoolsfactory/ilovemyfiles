---
import toolData from '../../data/tools.json';
import arcadeGames from '../../data/arcade-games.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArcadeRuntime from '../../components/client/ArcadeRuntime.astro';

const retiredGames = new Set(['file-memory', 'file-format-quiz']);
const games = [...toolData.TOOLS.filter(tool => tool.section === 'games' && !retiredGames.has(tool.slug)), ...arcadeGames];
const toolIcon = (tool) => `<span class="tool-icon icon-${tool.icon}" aria-hidden="true"><svg viewBox="0 0 24 24">${tool.svg}</svg></span>`;
---
<BaseLayout>
  <Fragment slot="head">
    <title>Free Online File Games & Arcade | iLoveMyFiles</title>
    <meta name="description" content="Play free browser-based file games, puzzles, and arcade challenges. No files, uploads, or sign-up needed.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://ilovemyfiles.com/games/">
    <meta property="og:title" content="Free Online File Games & Arcade | iLoveMyFiles">
    <meta property="og:description" content="Play free browser-based file games, puzzles, and arcade challenges. No files or uploads needed.">
    <meta property="og:url" content="https://ilovemyfiles.com/games/">
    <meta property="og:type" content="website">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Games",
      "description": "Free browser-based file puzzles and arcade games on iLoveMyFiles.",
      "url": "https://ilovemyfiles.com/games/",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": games.map((game, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `https://ilovemyfiles.com/games/${game.slug}/`,
          "name": game.cardTitle
        }))
      }
    })} />
  </Fragment>

  <div class="games-page" data-games-page>
    <div class="games-content">
      <header class="games-hero">
        <nav class="breadcrumb directory-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="breadcrumb-separator" aria-hidden="true">/</span><span aria-current="page">Games</span></nav>
        <div class="hero-copy">
          <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> BREAKROOM & PRODUCTIVITY CHILL ZONE</div>
          <h1>Play while your files <span>upload, convert & render.</span></h1>
          <p>Quick browser games for file wranglers and curious minds. Merge file sizes, crack a regex grid, chase bugs, or play a quiet hand of solitaire.</p>
        </div>
        <div class="hero-stats" aria-label="Arcade stats">
          <div class="hero-stat"><strong data-arcade-high-score>0</strong><span>Your high score</span></div>
          <div class="hero-stat"><strong>{games.length + 1}</strong><span>Games to play</span></div>
          <div class="hero-stat"><strong>0</strong><span>Files uploaded</span></div>
        </div>
      </header>

      <section class="arcade-section" id="arcade-game" aria-labelledby="arcade-title">
        <div class="section-heading">
          <div>
            <div class="section-kicker"><span aria-hidden="true"></span> INSTANT PLAY</div>
            <h2 id="arcade-title">Byte Sorter: Packet Drop</h2>
            <p>Catch file packets, dodge corrupted data, and see how long you can keep your buffer alive.</p>
          </div>
          <a class="rules-link" href="#byte-sorter-help">How to play <span aria-hidden="true">↓</span></a>
        </div>
        <ArcadeRuntime />
      </section>

      <section class="catalog-section" aria-labelledby="catalog-title">
        <div class="catalog-heading">
          <div>
            <div class="section-kicker"><span aria-hidden="true"></span> PICK YOUR NEXT BREAK</div>
            <h2 id="catalog-title">Arcade directory</h2>
            <p>Pick a puzzle, coding challenge, or arcade classic. Every game is playable right in your browser.</p>
          </div>
          <div class="game-filters" role="group" aria-label="Filter games">
            <button type="button" class="game-filter" data-filter="all" aria-pressed="true">All <span>{games.length + 1}</span></button>
            <button type="button" class="game-filter" data-filter="played" aria-pressed="false">Played <span data-progress-count="played">0</span></button>
            <button type="button" class="game-filter" data-filter="not-played" aria-pressed="false">Not played <span data-progress-count="not-played">{games.length + 1}</span></button>
            <button type="button" class="game-filter" data-filter="brain" aria-pressed="false">Brain & logic</button>
            <button type="button" class="game-filter" data-filter="arcade" aria-pressed="false">Speed & arcade</button>
            <button type="button" class="game-filter" data-filter="casual" aria-pressed="false">Casual breaks</button>
          </div>
        </div>

        <div class="games-grid" aria-live="polite">
            <a href="#arcade-game" class="game-card-link" data-game-card data-game-id="byte-sorter" data-category="arcade">
              <span class="game-card-icon arcade-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 8.5h10a4 4 0 0 1 3.8 5.2l-.6 2a2 2 0 0 1-3.3.8l-1.6-1.5H8.7l-1.6 1.5a2 2 0 0 1-3.3-.8l-.6-2A4 4 0 0 1 7 8.5Z"/><path d="M8 10.5v4m-2-2h4m6-1h.01M18 13h.01"/></svg>
              </span>
              <span class="game-card-body">
                <span class="game-card-tag">LIVE ARCADE</span>
                <h3>Byte Sorter: Packet Drop</h3>
                <p>Catch useful file packets, avoid corrupted data, and build a high score.</p>
              </span>
              <span class="game-progress" data-game-progress data-game-id="byte-sorter">Not played yet</span>
              <span class="game-card-arrow">Play now <span aria-hidden="true">→</span></span>
            </a>
            {games.map(game => (
              <a href={`/games/${game.slug}/`} class="game-card-link" data-game-card data-game-id={game.slug} data-category={game.gameCategory}>
                <span class="game-card-icon" set:html={toolIcon(game)} />
                <span class="game-card-body">
                  <span class="game-card-tag">{game.tag}</span>
                  <h3>{game.cardTitle}</h3>
                  <p>{game.cardText}</p>
                </span>
                <span class="game-progress" data-game-progress data-game-id={game.slug}>Not played yet</span>
                <span class="game-card-arrow">Play now <span aria-hidden="true">→</span></span>
              </a>
            ))}
        </div>
      </section>

      <section class="games-info" aria-labelledby="games-info-title">
        <h2 id="games-info-title">A little fun, no file handling</h2>
        <div class="games-info-grid">
          <div><b>Learn as you play</b><p>Build familiarity with file extensions, formats, and useful facts.</p></div>
          <div><b>Runs in your browser</b><p>Games stay on your device. No uploads, account, or sign-up needed.</p></div>
          <div><b>Made for quick breaks</b><p>Play a fast round between tasks, on desktop or mobile.</p></div>
        </div>
      </section>
    </div>
  </div>

  <script>
    import { gameProgressLabel, readGameProgress } from '../../scripts/game-progress.js';

    const gamesPage = document.querySelector('[data-games-page]');
    if (gamesPage instanceof HTMLElement) {
      const filters = gamesPage.querySelectorAll('[data-filter]');
      const cards = gamesPage.querySelectorAll('[data-game-card]');
      let activeFilter = 'all';

      const updateProgress = () => {
        const progress = readGameProgress();
        let playedCount = 0;
        cards.forEach((card) => {
          const gameId = card.getAttribute('data-game-id');
          const record = gameId ? progress[gameId] : null;
          const played = Boolean(record?.played);
          if (played) playedCount++;
          const status = card.querySelector('[data-game-progress]');
          if (status instanceof HTMLElement) {
            status.textContent = gameProgressLabel(record);
            status.dataset.played = String(played);
          }
          card.dataset.played = String(played);
        });
        gamesPage.querySelector('[data-progress-count="played"]')?.replaceChildren(String(playedCount));
        gamesPage.querySelector('[data-progress-count="not-played"]')?.replaceChildren(String(cards.length - playedCount));
        applyFilter();
      };

      function applyFilter() {
        cards.forEach((card) => {
          const isPlayed = card.dataset.played === 'true';
          const matches = activeFilter === 'all' ||
            (activeFilter === 'played' && isPlayed) ||
            (activeFilter === 'not-played' && !isPlayed) ||
            card.getAttribute('data-category') === activeFilter;
          card.toggleAttribute('hidden', !matches);
        });
      }

      filters.forEach(filter => {
        filter.addEventListener('click', () => {
          activeFilter = filter.getAttribute('data-filter') ?? 'all';
          filters.forEach((button) => {
            button.setAttribute('aria-pressed', String(button === filter));
          });
          applyFilter();
        });
      });

      updateProgress();
      window.addEventListener('game-progress-updated', updateProgress);
      window.addEventListener('storage', updateProgress);
    }
  </script>

  <style>
    .games-page{--arcade-bg:#090d16;--arcade-surface:#121b30;--arcade-border:rgba(255,255,255,.1);--arcade-text:#f8fafc;--arcade-muted:#cbd5e1;--arcade-dim:#9aa8be;--arcade-purple:#a5b4fc;--arcade-cyan:#67e8f9;position:relative;isolation:isolate;overflow:hidden;padding:32px 22px 72px;background-color:var(--arcade-bg);background-image:radial-gradient(ellipse at 18% 0%,rgba(79,70,229,.2),transparent 38%),radial-gradient(ellipse at 90% 50%,rgba(6,182,212,.11),transparent 34%),linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:auto,auto,32px 32px,32px 32px;color:var(--arcade-text)}
    .games-content{max-width:1180px;margin:0 auto}
    .games-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(340px,.9fr);align-items:center;gap:40px;margin-bottom:44px;padding:24px 0 0}
    .directory-breadcrumb{grid-column:1/-1;display:flex;align-items:center;gap:9px;margin:0 0 -12px;color:var(--arcade-dim);font-size:12px}
    .directory-breadcrumb a{color:var(--arcade-muted);text-decoration:none}
    .directory-breadcrumb a:hover{color:var(--arcade-cyan)}
    .hero-copy{max-width:670px}
    .eyebrow,.section-kicker{display:flex;align-items:center;gap:9px;color:var(--arcade-cyan);font-size:11px;font-weight:800;letter-spacing:1.35px}
    .status-dot{width:8px;height:8px;border-radius:50%;background:#34d399;box-shadow:0 0 14px #34d399}
    .games-hero h1{max-width:640px;margin:18px 0 14px;color:var(--arcade-text);font-size:clamp(34px,5vw,58px);font-weight:850;line-height:1.04;letter-spacing:-2px}
    .games-hero h1 span{display:block;color:var(--arcade-purple)}
    .hero-copy>p{max-width:610px;margin:0;color:var(--arcade-muted);font-size:15px;line-height:1.7}
    .hero-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .hero-stat{display:flex;min-height:94px;flex-direction:column;justify-content:center;align-items:center;gap:8px;padding:12px 8px;border:1px solid var(--arcade-border);border-radius:16px;background:rgba(18,27,48,.85);text-align:center}
    .hero-stat strong{color:var(--arcade-text);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:25px;line-height:1}
    .hero-stat span{color:var(--arcade-muted);font-size:10px;font-weight:700;letter-spacing:.55px;text-transform:uppercase}
    .arcade-section,.catalog-section,.games-info{margin-top:42px}
    .section-heading,.catalog-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:16px}
    .section-kicker{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
    .section-kicker>span{width:8px;height:8px;border-radius:2px;background:var(--arcade-cyan)}
    .section-heading h2,.catalog-heading h2{margin:8px 0 5px;color:var(--arcade-text);font-size:25px;line-height:1.2;letter-spacing:-.6px}
    .section-heading p,.catalog-heading p{margin:0;color:var(--arcade-muted);font-size:13px;line-height:1.55}
    .rules-link{min-height:44px;display:inline-flex;align-items:center;gap:8px;padding:0 4px;color:var(--arcade-purple);font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap}
    .rules-link:hover{color:var(--arcade-cyan)}
    .catalog-heading{align-items:flex-end;padding-bottom:16px;border-bottom:1px solid var(--arcade-border)}
    .game-filters{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}
    .game-filter{min-height:40px;padding:0 13px;border:1px solid var(--arcade-border);border-radius:10px;background:rgba(18,27,48,.8);color:var(--arcade-muted);font-size:12px;font-weight:700;transition:background .16s,border-color .16s,color .16s}
    .game-filter:hover{border-color:rgba(129,140,248,.55);color:var(--arcade-text)}
    .game-filter[aria-pressed="true"]{border-color:#6366f1;background:#4f46e5;color:#fff}
    .game-filter span{margin-left:5px;color:#c7d2fe}
    .games-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:14px;margin-top:18px}
    .game-card-link{display:flex;min-height:245px;flex-direction:column;align-items:flex-start;gap:14px;padding:20px;border:1px solid var(--arcade-border);border-radius:16px;background:linear-gradient(145deg,rgba(19,29,54,.96),rgba(15,23,42,.92));color:var(--arcade-text);text-decoration:none;transition:transform .18s,border-color .18s,box-shadow .18s}
    .game-card-link:hover{transform:translateY(-3px);border-color:rgba(129,140,248,.65);box-shadow:0 14px 34px rgba(0,0,0,.24),0 0 24px rgba(99,102,241,.12)}
    .game-card-link[hidden]{display:none}
    .game-card-icon{display:grid;width:48px;height:48px;place-items:center;border:1px solid rgba(129,140,248,.22);border-radius:14px;background:linear-gradient(145deg,rgba(79,70,229,.28),rgba(6,182,212,.18));color:var(--arcade-cyan)}
    .game-card-icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    :global(.game-card-icon .tool-icon){display:grid;width:48px;height:48px;place-items:center;border-radius:14px}
    .game-card-body{display:block}
    .game-card-tag{display:inline-block;margin-bottom:7px;color:var(--arcade-cyan);font-size:10px;font-weight:800;letter-spacing:.9px}
    .game-card-body h3{margin:0 0 7px;color:var(--arcade-text);font-size:18px;letter-spacing:-.25px}
    .game-card-body p{margin:0;color:var(--arcade-muted);font-size:13px;line-height:1.55}
    .game-progress{display:inline-flex;min-height:28px;align-items:center;padding:0 9px;border:1px solid rgba(148,163,184,.22);border-radius:8px;background:rgba(9,13,22,.55);color:var(--arcade-dim);font-size:11px;font-weight:700}
    .game-progress[data-played="true"]{border-color:rgba(52,211,153,.3);color:#a7f3d0}
    .game-card-arrow{display:flex;align-items:center;gap:7px;margin-top:auto;padding-top:12px;color:var(--arcade-purple);font-size:12px;font-weight:750}
    .games-info{padding:22px;border:1px solid var(--arcade-border);border-radius:18px;background:rgba(18,27,48,.74)}
    .games-info h2{margin:0 0 16px;color:var(--arcade-text);font-size:20px;text-align:center}
    .games-info-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .games-info-grid>div{padding:16px;border:1px solid rgba(255,255,255,.08);border-radius:12px;background:rgba(9,13,22,.55)}
    .games-info-grid b{display:block;margin-bottom:6px;color:var(--arcade-text);font-size:13px}
    .games-info-grid p{margin:0;color:var(--arcade-muted);font-size:12px;line-height:1.55}
    @media(max-width:850px){.games-hero{grid-template-columns:1fr;gap:22px}.hero-stats{max-width:560px}.section-heading,.catalog-heading{align-items:flex-start;flex-direction:column}.game-filters{justify-content:flex-start}}
    @media(max-width:600px){.games-page{padding:22px 16px 48px}.games-hero{gap:20px;margin-bottom:32px;padding-top:12px}.directory-breadcrumb{margin-bottom:-4px}.games-hero h1{font-size:clamp(34px,10vw,46px);letter-spacing:-1.5px}.hero-copy>p{font-size:14px}.hero-stats{gap:7px}.hero-stat{min-height:82px;padding:10px 5px}.hero-stat strong{font-size:21px}.hero-stat span{font-size:9px}.arcade-section,.catalog-section,.games-info{margin-top:32px}.section-heading h2,.catalog-heading h2{font-size:22px}.games-grid{grid-template-columns:1fr}.game-card-link{min-height:210px}.games-info{padding:18px}.games-info-grid{grid-template-columns:1fr}}
    @media(prefers-reduced-motion:reduce){.game-card-link,.game-filter{transition:none}.game-card-link:hover{transform:none}}
  </style>
</BaseLayout>
