---
import BaseLayout from '../../layouts/BaseLayout.astro';
import toolData from '../../data/tools.json';
import arcadeGames from '../../data/arcade-games.json';
import ArcadeGameComponent from '../../components/client/game-arcade.astro';

const retiredGames = new Set(['file-memory', 'file-format-quiz']);
const games = [
  ...toolData.TOOLS.filter(game => game.section === 'games' && !retiredGames.has(game.slug)),
  ...arcadeGames,
];

export function getStaticPaths() {
  const retiredGames = new Set(['file-memory', 'file-format-quiz']);
  const games = [
    ...toolData.TOOLS.filter(game => game.section === 'games' && !retiredGames.has(game.slug)),
    ...arcadeGames,
  ];
  return games.map(game => ({
    params: { slug: game.slug },
  }));
}

const game = games.find(g => g.slug === Astro.params.slug);

if (!game) {
  return new Response(null, { status: 404 });
}

const title = `${game.cardTitle} - Play Free Online | iLoveMyFiles`;
const description = game.seo?.description ?? game.cardText;
const canonical = `https://ilovemyfiles.com/games/${game.slug}/`;
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Game",
      "name": game.cardTitle,
      "description": description,
      "url": canonical,
      "applicationCategory": "Game",
      "operatingSystem": "Any modern browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ilovemyfiles.com/" },
        { "@type": "ListItem", "position": 2, "name": "Games", "item": "https://ilovemyfiles.com/games/" },
        { "@type": "ListItem", "position": 3, "name": game.cardTitle, "item": canonical },
      ],
    })} />
  </Fragment>

  <div class="games-page game-detail-page">
    <div class="game-detail-content">
      <header class="game-hero">
        <nav class="game-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/games/">Games</a><span aria-hidden="true">/</span>
          <span aria-current="page">{game.cardTitle}</span>
        </nav>
        <div class="game-hero-copy">
          <div class="game-tag"><span aria-hidden="true"></span>{game.tag}</div>
          <h1>{game.cardTitle}</h1>
          <p>{game.cardText}</p>
          <span class="game-info">BROWSER GAME <span aria-hidden="true">·</span> NO UPLOADS <span aria-hidden="true">·</span> FREE TO PLAY</span>
        </div>
        <a class="game-back-link" href="/games/">← <span>All games</span></a>
      </header>

      <section class="game-play-section" aria-label={`Play ${game.cardTitle}`}>
        <div class="game-play-label"><span aria-hidden="true"></span> INSTANT PLAY</div>
        <div class="game-page-wrap">
          <ArcadeGameComponent game={game.slug} />
        </div>
      </section>

      <section class="game-howto" aria-labelledby="game-howto-title">
        <div class="detail-section-kicker">QUICK START</div>
        <h2 id="game-howto-title">How to play</h2>
        {game.seo?.intro && <p class="game-intro">{game.seo.intro}</p>}
        <ol>
          {game.seo?.steps?.map(step => <li>{step}</li>)}
        </ol>
      </section>

      <section class="game-faq" aria-labelledby="game-faq-title">
        <div class="detail-section-kicker">GOOD TO KNOW</div>
        <h2 id="game-faq-title">Frequently asked questions</h2>
        <div class="faq-list">
          {game.seo?.faqs?.map(([q, a]) => (
            <details class="faq-item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="game-cta">
        <a href="/games/">← Back to the arcade directory</a>
      </div>
    </div>
  </div>
  <style>
    .games-page{--arcade-bg:#090d16;--arcade-surface:#121b30;--arcade-border:rgba(255,255,255,.1);--arcade-text:#f8fafc;--arcade-muted:#cbd5e1;--arcade-dim:#9aa8be;--arcade-purple:#a5b4fc;--arcade-cyan:#67e8f9;position:relative;isolation:isolate;overflow:hidden;padding:32px 22px 72px;background-color:var(--arcade-bg);background-image:radial-gradient(ellipse at 18% 0%,rgba(79,70,229,.2),transparent 38%),radial-gradient(ellipse at 90% 50%,rgba(6,182,212,.11),transparent 34%),linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:auto,auto,32px 32px,32px 32px;color:var(--arcade-text)}
    .game-detail-content{max-width:1180px;margin:0 auto}
    .game-hero{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:22px;margin-bottom:28px;padding-top:12px}
    .game-breadcrumb{display:flex;flex-basis:100%;align-items:center;gap:9px;margin-bottom:0;color:var(--arcade-dim);font-size:12px}
    .game-breadcrumb a,.game-back-link,.game-cta a{color:var(--arcade-muted);text-decoration:none}
    .game-breadcrumb a:hover,.game-back-link:hover,.game-cta a:hover{color:var(--arcade-cyan)}
    .game-hero-copy{max-width:760px}
    .game-tag{display:inline-flex;align-items:center;gap:8px;color:var(--arcade-cyan);font-size:10px;font-weight:800;letter-spacing:1.3px}
    .game-tag span,.game-play-label span{width:8px;height:8px;border-radius:2px;background:var(--arcade-cyan)}
    .game-hero h1{margin:12px 0;color:var(--arcade-text);font-size:clamp(34px,5vw,52px);font-weight:850;line-height:1.05;letter-spacing:-1.6px}
    .game-hero-copy>p{max-width:700px;margin:0;color:var(--arcade-muted);font-size:15px;line-height:1.65}
    .game-info{display:inline-block;margin-top:14px;color:var(--arcade-dim);font-size:10px;font-weight:800;letter-spacing:.7px}
    .game-info span{padding:0 6px;color:var(--arcade-cyan)}
    .game-back-link{min-height:44px;display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700}
    .game-play-section{margin-top:14px}
    .game-play-label,.detail-section-kicker{display:flex;align-items:center;gap:9px;color:var(--arcade-cyan);font:800 10px/1.4 ui-monospace,monospace;letter-spacing:1.2px}
    .game-page-wrap{width:100%;margin-top:12px}
    .game-howto,.game-faq{margin-top:24px;padding:24px;border:1px solid var(--arcade-border);border-radius:16px;background:rgba(18,27,48,.85);color:var(--arcade-text)}
    .game-howto h2,.game-faq h2{margin:8px 0 12px;color:var(--arcade-text);font-size:21px;letter-spacing:-.3px}
    .game-intro,.game-howto ol,.faq-item p{color:var(--arcade-muted);font-size:13px;line-height:1.65}
    .game-howto ol{margin:12px 0 0;padding-left:22px}
    .game-howto li{padding:3px 0}
    .faq-list{display:flex;flex-direction:column;gap:8px}
    .faq-item{border:1px solid var(--arcade-border);border-radius:10px;background:rgba(9,13,22,.55)}
    .faq-item summary{min-height:44px;padding:12px 14px;color:var(--arcade-text);font-size:13px;font-weight:700;cursor:pointer}
    .faq-item summary:hover{color:var(--arcade-cyan)}
    .faq-item p{margin:0;padding:0 14px 14px}
    .game-cta{display:flex;justify-content:center;margin-top:24px}
    .game-cta a{min-height:44px;display:inline-flex;align-items:center;font-size:13px;font-weight:700}
    :global(body:has(.game-detail-page) .topnav>a[href="/games/"]){color:#67e8f9}
    @media(max-width:640px){.games-page{padding:22px 16px 48px}.game-hero{gap:16px;padding-top:8px}.game-hero h1{font-size:clamp(32px,9vw,44px);letter-spacing:-1.1px}.game-hero-copy>p{font-size:14px}.game-back-link{min-height:40px}.game-howto,.game-faq{padding:18px}.game-howto h2,.game-faq h2{font-size:19px}}
    @media(prefers-reduced-motion:reduce){.game-back-link,.game-cta a{scroll-behavior:auto}}
  </style>
</BaseLayout>