<script>
  window.iLoveMyFilesModulesReady = (window.iLoveMyFilesModulesReady ?? Promise.resolve()).then(() => {
    window.iLoveMyFilesModules ??= {};
  let pdfjsPromise = null;
  const pdfDataCache = new WeakMap();
  
  async function getPdfjs() {
    if (!pdfjsPromise) {
      pdfjsPromise = (async () => {
        const pdfjs = await import('pdfjs-dist');
        const workerUrl = (await import('pdfjs-dist/build/pdf.worker.min.mjs?url')).default;
        pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;
        return pdfjs;
      })();
    }
    return pdfjsPromise;
  }
  
  async function loadPdfDocument(file) {
    const pdfjs = await getPdfjs();
    let dataPromise = pdfDataCache.get(file);
    if (!dataPromise) {
      dataPromise = file.arrayBuffer();
      pdfDataCache.set(file, dataPromise);
    }
    const buffer = await dataPromise;
    // pdf.js transfers (detaches) the underlying ArrayBuffer to its worker,
    // so hand it a fresh copy to keep the cached buffer reusable.
    const data = new Uint8Array(buffer.slice(0));
    return pdfjs.getDocument({ data, isEvalSupported: false }).promise;
  }
  
  async function renderPageToCanvas(page, scale, opaque = false, options = {}) {
    const viewport = page.getViewport({ scale, rotation: options.rotation });
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.ceil(viewport.width));
    canvas.height = Math.max(1, Math.ceil(viewport.height));
    const context = canvas.getContext('2d', { alpha: !opaque });
    if (!context) throw new Error('This browser could not create a canvas for the PDF preview.');
    if (opaque) { context.fillStyle = '#fff'; context.fillRect(0, 0, canvas.width, canvas.height); }
    try {
      const task = page.render({ canvasContext: context, viewport, background: opaque ? '#ffffff' : undefined });
      options.onTask?.(task);
      await task.promise;
      return canvas;
    } catch (error) {
      canvas.width = 1;
      canvas.height = 1;
      throw error;
    }
  }
  
  async function renderPageToBlob(page, scale, type = 'image/png', quality = 0.92) {
    const canvas = await renderPageToCanvas(page, scale, type === 'image/jpeg');
    const blob = await new Promise((resolve, reject) => {
      try {
        canvas.toBlob(result => result ? resolve(result) : reject(new Error('Canvas encoding returned no image data.')), type, quality);
      } catch (error) { reject(error); }
    });
    const width = canvas.width, height = canvas.height;
    canvas.width = 1; canvas.height = 1;
    return { blob, width, height };
  }
  
  async function renderThumbnail(page, targetWidth = 64, quality = 0.3) {
    const base = page.getViewport({ scale: 1 });
    let lastError = null;
    for (const width of [targetWidth, 48, 32]) {
      if (!width || width <= 0) continue;
      const scale = Math.max(0.1, width / base.width);
      try {
        return await renderPageToBlob(page, scale, 'image/jpeg', quality);
      } catch (error) {
        lastError = error;
      }
    }
    throw lastError || new Error('Thumbnail could not be rendered.');
  }
      window.iLoveMyFilesModules['pdf-render'] = { loadPdfDocument, renderPageToCanvas, renderPageToBlob, renderThumbnail };
  });
</script>
