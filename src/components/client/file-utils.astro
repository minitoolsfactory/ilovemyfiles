<script>
  window.iLoveMyFilesModulesReady = (window.iLoveMyFilesModulesReady ?? Promise.resolve()).then(() => {
    window.iLoveMyFilesModules ??= {};
  const formatBytes = (bytes) => {
    if (!Number.isFinite(bytes) || bytes < 0) return '-';
    if (bytes < 1024) return `${bytes} B`;
    const units = ['KB', 'MB', 'GB'];
    let value = bytes / 1024, index = 0;
    while (value >= 1024 && index < units.length - 1) { value /= 1024; index++; }
    return `${value.toFixed(value >= 100 ? 0 : value >= 10 ? 1 : 2)} ${units[index]}`;
  };
  
  function safeBaseName(name) {
    const base = name.replace(/\.[^.]+$/, '').normalize('NFKD').replace(/[\u0300-\u036f]/g, '');
    const cleaned = base
      .replace(/[^\p{L}\p{N}]+/gu, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
    return cleaned || 'file';
  }
  
  function downloadBlob(blob, filename) {
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = filename;
    anchor.style.display = 'none';
    document.body.append(anchor);
    anchor.click();
    anchor.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
  }
  
  function readFileAsArrayBuffer(file) {
    return file.arrayBuffer();
  }
  
  function loadImage(file) {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const image = new Image();
      image.onload = () => { URL.revokeObjectURL(url); resolve(image); };
      image.onerror = () => { URL.revokeObjectURL(url); reject(new Error(`Could not read image: ${file.name}`)); };
      image.src = url;
    });
  }
  
  function canvasToBlob(canvas, type, quality) {
    return new Promise((resolve, reject) => canvas.toBlob(blob => {
      if (blob) resolve(blob);
      else reject(new Error(`This browser could not encode ${type}. Try JPG or PNG.`));
    }, type, quality));
  }
  
  function makeCanvas(width, height) {
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(width));
    canvas.height = Math.max(1, Math.round(height));
    return canvas;
  }
  
  function updateProgress(callback, index, total, label = 'Processing files…') {
    callback?.({ percent: Math.round((index / Math.max(total, 1)) * 100), label });
  }
  
  function parsePageOrder(text, maxPages) {
    const order = [];
    const chunks = text.split(',').map(part => part.trim()).filter(Boolean);
    if (!chunks.length) throw new Error('Enter the new page order, such as 3, 1, 2.');
    const push = page => {
      if (page < 1 || page > maxPages) throw new Error(`Page ${page} is outside 1–${maxPages}.`);
      order.push(page - 1);
    };
    for (const chunk of chunks) {
      const match = chunk.match(/^(\d+)\s*-\s*(\d+)$/);
      if (match) {
        const start = Number(match[1]), end = Number(match[2]);
        const step = start <= end ? 1 : -1;
        for (let page = start; page !== end + step; page += step) push(page);
      } else if (/^\d+$/.test(chunk)) push(Number(chunk));
      else throw new Error(`Invalid page entry: "${chunk}".`);
    }
    return order;
  }
  
  function parsePageSelection(text, maxPages) {
    const selected = new Set();
    const chunks = text.split(',').map(part => part.trim()).filter(Boolean);
    if (!chunks.length) throw new Error('Enter page numbers, such as 1-3, 5.');
    for (const chunk of chunks) {
      const match = chunk.match(/^(\d+)\s*-\s*(\d+)$/);
      if (match) {
        const start = Number(match[1]), end = Number(match[2]);
        if (start < 1 || end < start || end > maxPages) throw new Error(`Page range "${chunk}" is outside 1–${maxPages}.`);
        for (let page = start; page <= end; page++) selected.add(page - 1);
      } else if (/^\d+$/.test(chunk)) {
        const page = Number(chunk);
        if (page < 1 || page > maxPages) throw new Error(`Page ${page} is outside 1–${maxPages}.`);
        selected.add(page - 1);
      } else throw new Error(`Invalid page selection: "${chunk}".`);
    }
    return [...selected].sort((a, b) => a - b);
  }
      window.iLoveMyFilesModules['file-utils'] = { formatBytes, safeBaseName, downloadBlob, readFileAsArrayBuffer, loadImage, canvasToBlob, makeCanvas, updateProgress, parsePageOrder, parsePageSelection };
  });
</script>
