<script>
  window.iLoveMyFilesModulesReady = (window.iLoveMyFilesModulesReady ?? Promise.resolve()).then(() => {
    window.iLoveMyFilesModules ??= {};

  const MAX_FILE_BYTES = 25 * 1024 * 1024;
  const MAX_PAGES = 200;
  const MAX_RECORDS = 20000;

  let parserModule = null;
  let analyticsModule = null;
  let validateModule = null;
  let exporterModule = null;
  let correctionsModule = null;
  let subjectsModule = null;

  async function loadCore() {
    if (!parserModule) {
      const [parser, analytics, validate, exporters, corrections, subjects] = await Promise.all([
        import('../../lib/cbse/parse-gazette.js'),
        import('../../lib/cbse/analytics.js'),
        import('../../lib/cbse/validate.js'),
        import('../../lib/cbse/exporters.js'),
        import('../../lib/cbse/corrections.js'),
        import('../../lib/cbse/subjects.js')
      ]);
      parserModule = parser;
      analyticsModule = analytics;
      validateModule = validate;
      exporterModule = exporters;
      correctionsModule = corrections;
      subjectsModule = subjects;
    }
    return { parserModule, analyticsModule, validateModule, exporterModule, correctionsModule };
  }

  const state = {
    datasets: [],
    activeId: null,
    overrides: {},
    corrections: {},
    bands: null,
    topCount: 10,
    filters: { year: null, className: null, school: null, region: null, subject: null, status: null, grade: null, scoreMin: null, scoreMax: null },
    sort: { key: null, direction: 'asc', toggles: 0 },
    page: 1,
    pageSize: 50,
    step: 'upload',
    maxStep: 'upload',
    studentQuery: '',
    sequence: 0
  };

  /**
   * The subject overrides of the gazette that is being reviewed. Overrides
   * are kept per file, so a name or a maximum that was set for one gazette
   * never leaks into another one.
   */
  function activeOverrides() {
    if (!state.activeId) return {};
    if (!state.overrides[state.activeId]) state.overrides[state.activeId] = {};
    return state.overrides[state.activeId];
  }

  function $(selector, root = document) {
    return root.querySelector(selector);
  }

  function $$(selector, root = document) {
    return [...root.querySelectorAll(selector)];
  }

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined && text !== null) node.textContent = String(text);
    return node;
  }

  function setStatus(message, tone = 'info') {
    const status = $('#cbse-status');
    if (!status) return;
    status.textContent = message ?? '';
    status.className = `status-message status-${tone}`;
    status.hidden = !message;
  }

  function setProgress(percent, label) {
    const wrap = $('#cbse-progress');
    const bar = $('#cbse-progress-bar');
    const text = $('#cbse-progress-label');
    if (!wrap) return;
    if (percent === null) {
      wrap.hidden = true;
      return;
    }
    wrap.hidden = false;
    if (bar) bar.style.width = `${Math.max(0, Math.min(100, percent))}%`;
    if (text) text.textContent = label ?? '';
  }

  const STEP_ORDER = ['upload', 'review', 'dashboard'];

  function show(step) {
    state.step = step;
    for (const name of ['review', 'dashboard']) {
      const node = $(`#cbse-${name}`);
      if (node) node.hidden = name !== step;
    }
    const upload = $('#cbse-upload-step');
    if (upload) upload.hidden = step !== 'upload';
    const tabs = $$('.cbse-step');
    for (const tab of tabs) {
      const reached = STEP_ORDER.indexOf(tab.dataset.step) <= STEP_ORDER.indexOf(state.maxStep);
      tab.classList.toggle('is-current', tab.dataset.step === step);
      tab.setAttribute('aria-current', tab.dataset.step === step ? 'step' : 'false');
      tab.disabled = !reached;
      tab.title = reached ? `Go to the ${tab.textContent.replace(/^\d\s*/, '').trim()} step` : 'Reach this step first';
    }
    const back = $('#cbse-back');
    if (back) {
      const index = STEP_ORDER.indexOf(step);
      back.hidden = index <= 0;
      back.textContent = index === 1 ? '← Back to the upload' : '← Back to the review';
    }
  }

  /**
   * Move to a step the reader can reach, keeping the corrections they made.
   *
   * @param {string} step
   */
  function goToStep(step) {
    if (STEP_ORDER.indexOf(step) > STEP_ORDER.indexOf(state.maxStep)) return;
    show(step);
    if (step === 'review') renderReview();
    if (step === 'dashboard') renderDashboard();
    const top = $('#cbse-app');
    if (top) top.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }

  /**
   * Extract the text of an uploaded file.
   * Text based PDFs are read through the PDF text layer, scanned PDFs fall
   * back to on-device OCR.
   */
  async function extractText(file, onProgress) {
    const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
    if (!isPdf) {
      const buffer = await file.arrayBuffer();
      let text = new TextDecoder('utf-8', { fatal: false }).decode(buffer);
      if (text.includes('\u0000')) {
        text = new TextDecoder('utf-16le', { fatal: false }).decode(buffer);
      }
      if (text.charCodeAt(0) === 0xfeff) text = text.slice(1);
      return { text, mode: 'text', pages: 1 };
    }

    const { loadPdfDocument } = window.iLoveMyFilesModules['pdf-render'];
    const document_ = await loadPdfDocument(file);
    if (document_.numPages > MAX_PAGES) {
      throw new Error(`This PDF has ${document_.numPages} pages. The analyzer reads up to ${MAX_PAGES} pages, so split the gazette into smaller files.`);
    }
    const lines = [];
    for (let pageNumber = 1; pageNumber <= document_.numPages; pageNumber += 1) {
      const page = await document_.getPage(pageNumber);
      const content = await page.getTextContent();
      const pageLines = itemsToLines(content.items || []);
      const text = pageLines.join('\n');
      lines.push(text);
      onProgress?.({
        percent: 10 + Math.round((pageNumber / document_.numPages) * 45),
        label: `Reading the text layer of page ${pageNumber} of ${document_.numPages}…`
      });
      const letters = text.replace(/[^A-Za-z]/g, '').length;
      if (letters < 200 && document_.numPages <= 30) {
        onProgress?.({ percent: 58, label: 'This PDF looks like a scan. Running on-device OCR…' });
        const { ocrFile } = window.iLoveMyFilesModules['ocr'];
        const result = await ocrFile(file, { lang: 'eng' }, progress => {
          onProgress?.({ percent: 60 + Math.round((progress?.percent ?? 0) * 0.3), label: `OCR: ${progress?.label ?? 'recognising text'}` });
        });
        return { text: result.text, mode: 'ocr', pages: document_.numPages };
      }
    }
    return { text: lines.join('\n'), mode: 'pdf-text', pages: document_.numPages };
  }

  /**
   * Rebuild the printed monospace layout of a PDF page from its text items.
   */
  function itemsToLines(items) {
    const usable = items.filter(item => item.str && item.str.length);
    if (!usable.length) return [];
    const widths = usable
      .map(item => (item.width && item.str.length ? item.width / item.str.length : 0))
      .filter(value => value > 0.01)
      .sort((a, b) => a - b);
    const charWidth = widths.length ? widths[Math.floor(widths.length / 2)] : 0;
    const originX = Math.min(...usable.map(item => item.transform[4]));

    const rows = new Map();
    for (const item of usable) {
      const y = Math.round(item.transform[5] * 2) / 2;
      if (!rows.has(y)) rows.set(y, []);
      rows.get(y).push(item);
    }

    const lines = [];
    for (const [y, rowItems] of [...rows.entries()].sort((a, b) => b[0] - a[0])) {
      rowItems.sort((a, b) => a.transform[4] - b.transform[4]);
      let text = '';
      let cursor = originX;
      for (const item of rowItems) {
        const gap = charWidth > 0 ? Math.max(0, Math.round((item.transform[4] - cursor) / charWidth)) : 0;
        text += ' '.repeat(gap) + item.str;
        cursor = item.transform[4] + (item.width || item.str.length * charWidth);
      }
      lines.push(text.replace(/\s+$/, ''));
    }
    return lines;
  }

  function validateFile(file) {
    const name = file.name.toLowerCase();
    const isPdf = file.type === 'application/pdf' || name.endsWith('.pdf');
    const isText = file.type.startsWith('text/') || name.endsWith('.txt') || name.endsWith('.csv');
    if (!isPdf && !isText) {
      throw new Error(`"${file.name}" is not supported. Upload a CBSE gazette as a PDF or a TXT file.`);
    }
    if (file.size > MAX_FILE_BYTES) {
      throw new Error(`"${file.name}" is ${(file.size / 1024 / 1024).toFixed(1)} MB. The limit is ${MAX_FILE_BYTES / 1024 / 1024} MB.`);
    }
    if (file.size === 0) {
      throw new Error(`"${file.name}" is empty.`);
    }
  }

  async function handleFiles(fileList) {
    const files = [...fileList];
    if (!files.length) return;
    setStatus('');
    setProgress(4, 'Reading the file…');
    try {
      await loadCore();
      for (const file of files) {
        validateFile(file);
        const extracted = await extractText(file, setProgress);
        if (!extracted.text.trim()) {
          throw new Error(`No readable text was found in "${file.name}". If it is a scan, make sure the page is not blank and try again.`);
        }
        const datasetId = `ds${Date.now().toString(36)}${state.sequence++}`;
        const parsed = parserModule.parseGazette(extracted.text, {
          sourceFileName: file.name,
          datasetId,
          layout: 'auto'
        });
        if (parsed.candidates.length > MAX_RECORDS) {
          throw new Error(`"${file.name}" contains more than ${MAX_RECORDS} records. Split it into smaller files.`);
        }
        if (!parsed.candidates.length) {
          throw new Error(`No candidate records were found in "${file.name}". Check that it is a school or roll-number wise CBSE gazette.`);
        }
        parsed.sourceMode = extracted.mode;
        parsed.pageCount = extracted.pages;
        state.datasets.push(parsed);
        state.activeId = datasetId;
      }
      setProgress(100, 'Parsed');
      setTimeout(() => setProgress(null), 400);
      clearFilters();
      renderReview();
      state.maxStep = 'review';
      show('review');
      const total = state.datasets.reduce((sum, item) => sum + item.candidates.length, 0);
      setStatus(`Read ${total} candidate record(s) from ${state.datasets.length} file(s). Check the figures below, then build the report.`, 'success');
    } catch (error) {
      setProgress(null);
      setStatus(error?.message ?? 'The file could not be read.', 'error');
    }
  }

  function activeDataset() {
    return state.datasets.find(item => item.datasetId === state.activeId) ?? state.datasets[state.datasets.length - 1] ?? null;
  }

  function refreshDataset() {
    const dataset = activeDataset();
    if (!dataset) return null;
    const corrected = correctionsModule.applyCorrections(dataset, state.corrections);
    corrected.subjectTable = analyticsModule.buildSubjectTable(corrected, activeOverrides());
    return corrected;
  }

  function renderReview() {
    const dataset = refreshDataset();
    if (!dataset) return;
    const analytics = analyticsModule.computeAnalytics(dataset, { bands: state.bands ?? analyticsModule.DEFAULT_BANDS, topCount: state.topCount });
    const validation = validateModule.validateDataset(dataset, analytics);

    $('#cbse-review-datasets').innerHTML = '';
    const datasetPicker = $('#cbse-review-datasets');
    for (const item of state.datasets) {
      const option = el('option', null, `${item.meta.sourceFileName} (${item.candidates.length} records)`);
      option.value = item.datasetId;
      option.selected = item.datasetId === state.activeId;
      datasetPicker.appendChild(option);
    }
    datasetPicker.hidden = state.datasets.length < 2;

    renderMetaEditor(dataset);
    renderSubjectEditor(dataset);
    renderValidation(validation);
    renderFlagged(validation);
    renderSubjectLibrary($('#cbse-kb-search')?.value ?? '', dataset.meta?.class ?? null);
    renderSummaryTable(dataset, analytics);
    const applied = correctionsModule.countCorrections(state.corrections);
    const note = $('#cbse-corrections-note');
    if (note) {
      note.textContent = applied
        ? `${applied} record(s) were corrected by hand. The corrections are shown in the report and the printed value is kept in the export.`
        : '';
      note.hidden = !applied;
    }
  }

  function renderMetaEditor(dataset) {
    const body = $('#cbse-meta-body');
    body.innerHTML = '';
    const fields = [
      ['School code', 'schoolCode'],
      ['School name', 'schoolName'],
      ['Region', 'region'],
      ['Examination', 'examName'],
      ['Year', 'year'],
      ['Class', 'class'],
      ['Session', 'session'],
      ['Gazette date', 'gazetteDate'],
      ['Source file', 'sourceFileName'],
      ['Imported at', 'importedAt']
    ];
    for (const [label, key] of fields) {
      const row = el('div', 'cbse-field-row');
      const caption = el('label', 'cbse-field-label', label);
      const input = el('input', 'cbse-field-input');
      input.type = key === 'year' ? 'number' : 'text';
      input.value = dataset.meta[key] ?? '';
      input.title = dataset.meta[key] ?? '';
      input.dataset.metaKey = key;
      input.setAttribute('aria-label', label);
      caption.htmlFor = `cbse-meta-${key}`;
      input.id = `cbse-meta-${key}`;
      row.appendChild(caption);
      row.appendChild(input);
      body.appendChild(row);
    }
  }

  function renderSubjectEditor(dataset) {
    const body = $('#cbse-subject-body');
    body.innerHTML = '';
    const table = dataset.subjectTable ?? [];
    if (!table.length) {
      body.appendChild(el('p', 'field-help', 'No subject codes were found in this file.'));
      return;
    }
    // The pristine table is the one without any override, so the editor can
    // tell a value the reviewer typed apart from a value the analyzer worked
    // out on its own.
    const pristine = analyticsModule.buildSubjectTable(dataset, {});
    const rows = table.map(subject => {
      const original = pristine.find(entry => entry.code === subject.code) ?? subject;
      const row = el('tr');
      const code = el('td', 'cbse-mono', subject.code);
      const nameCell = el('td');
      const name = el('input', 'cbse-field-input');
      name.type = 'text';
      name.value = subject.name;
      name.dataset.subjectName = subject.code;
      name.dataset.originalName = original.name;
      name.setAttribute('aria-label', `Name for subject code ${subject.code}`);
      nameCell.appendChild(name);
      const maxCell = el('td', 'cbse-max-cell');
      const max = el('input', 'cbse-field-input cbse-field-input-narrow');
      max.type = 'number';
      max.min = '1';
      max.max = '300';
      max.value = subject.max ?? '';
      max.dataset.subjectMax = subject.code;
      max.dataset.originalMax = original.max ?? '';
      max.setAttribute('aria-label', `Maximum marks for subject code ${subject.code}`);
      maxCell.appendChild(max);
      const published = original.publishedScales?.length ? original.publishedScales : (original.publishedMax ? [original.publishedMax] : []);
      if (published.length && !published.includes(original.max)) {
        maxCell.appendChild(el('span', 'cbse-field-hint', `published ${published.join(' or ')}`));
      }
      const flagCell = el('td');
      const flagList = el('div', 'cbse-flag-list');
      for (const flag of subject.flags) {
        flagList.appendChild(el('span', 'cbse-flag', flag.replace(/-/g, ' ')));
      }
      flagCell.appendChild(flagList);
      row.appendChild(code);
      row.appendChild(nameCell);
      row.appendChild(maxCell);
      row.appendChild(flagCell);
      return row;
    });
    for (const row of rows) body.appendChild(row);
  }

  /**
   * The CBSE subject code library: every code the board publishes, with the
   * official name and the total mark a gazette prints for it.
   */
  function renderSubjectLibrary(query = '', className = null) {
    const body = $('#cbse-kb-body');
    const count = $('#cbse-kb-count');
    if (!body) return;
    body.innerHTML = '';
    const needle = String(query ?? '').trim().toLowerCase();
    const classKey = subjectsModule.subjectClassKey(className);
    const subjects = subjectsModule.allSubjects(classKey);
    const filtered = needle
      ? subjects.filter(subject => subject.code.includes(needle) || subject.name.toLowerCase().includes(needle))
      : subjects;
    for (const subject of filtered.slice(0, 300)) {
      const row = el('tr');
      row.appendChild(el('td', 'cbse-mono', subject.code));
      row.appendChild(el('td', null, subject.name));
      row.appendChild(el('td', 'cbse-mono', subject.group));
      row.appendChild(el('td', 'cbse-mono', String(subject.max)));
      const action = el('td');
      const input = document.querySelector(`#cbse-subject-body [data-subject-name="${subject.code}"]`);
      if (input) {
        const button = el('button', 'cbse-kb-use', 'Use this name');
        button.type = 'button';
        button.title = `Use "${subject.name}" for subject code ${subject.code} in this gazette`;
        button.addEventListener('click', () => {
          input.value = subject.name;
          input.classList.add('cbse-applied');
          setStatus(`Subject ${subject.code} is now called "${subject.name}". Build the report to apply it.`, 'info');
          input.scrollIntoView({ block: 'center', behavior: 'smooth' });
        });
        action.appendChild(button);
      } else {
        action.appendChild(el('span', 'field-help', 'not in this gazette'));
      }
      row.appendChild(action);
      body.appendChild(row);
    }
    if (count) {
      count.textContent = filtered.length === subjects.length
        ? `${subjects.length} subject codes in the library.`
        : `${filtered.length} of ${subjects.length} subject codes match "${query}".`;
    }
  }

  function renderFlagged(validation) {
    const body = $('#cbse-flagged-body');
    const table = body.closest('table');
    const wrap = body.closest('.cbse-table-scroll');
    const empty = $('#cbse-flagged-empty');
    body.innerHTML = '';
    if (!validation.reviewRecords.length) {
      if (table) table.hidden = true;
      if (wrap) wrap.hidden = true;
      if (empty) {
        empty.textContent = 'No record needs a second look. Every record was read cleanly and no printed value has to be confirmed by hand.';
        empty.hidden = false;
      }
      return;
    }
    if (table) table.hidden = false;
    if (wrap) wrap.hidden = false;
    if (empty) empty.hidden = true;
    for (const record of validation.reviewRecords.slice(0, 40)) {
      const row = el('tr');
      const rollCell = el('td', 'cbse-mono');
      const roll = el('input', 'cbse-field-input cbse-field-input-narrow');
      roll.type = 'text';
      roll.value = record.rollNo ?? '';
      roll.setAttribute('aria-label', `Roll number of record ${record.recordId}`);
      roll.addEventListener('change', event => {
        saveCorrection(record.recordId, { rollNo: event.target.value.trim() });
      });
      rollCell.appendChild(roll);

      const nameCell = el('td');
      const name = el('input', 'cbse-field-input');
      name.type = 'text';
      name.value = record.name ?? '';
      name.setAttribute('aria-label', `Candidate name of record ${record.recordId}`);
      name.addEventListener('change', event => {
        saveCorrection(record.recordId, { name: event.target.value.trim() });
      });
      nameCell.appendChild(name);

      const statusCell = el('td');
      const status = el('select', 'field-control');
      for (const option of [
        ['PASS', 'Passed'],
        ['COMPARTMENT', 'Compartment'],
        ['ESSENTIAL_REPEAT', 'Essential repeat'],
        ['ABSENT', 'Absent'],
        ['OTHER', 'Other / unknown']
      ]) {
        const node = el('option', null, option[1]);
        node.value = option[0];
        if (option[0] === record.status) node.selected = true;
        status.appendChild(node);
      }
      status.setAttribute('aria-label', `Result status of record ${record.recordId}`);
      status.addEventListener('change', event => {
        saveCorrection(record.recordId, { status: event.target.value });
      });
      statusCell.appendChild(status);

      const whyCell = el('td');
      const whyList = el('div', 'cbse-flag-list');
      for (const warning of record.warnings) {
        whyList.appendChild(el('span', 'cbse-flag', warning.replace(/-/g, ' ')));
      }
      if (!record.warnings.length) whyList.appendChild(el('span', 'cbse-flag', 'low confidence'));
      whyCell.appendChild(whyList);

      row.appendChild(rollCell);
      row.appendChild(nameCell);
      row.appendChild(statusCell);
      row.appendChild(whyCell);
      body.appendChild(row);
    }
  }

  function saveCorrection(recordId, patch) {
    const current = state.corrections[recordId] ?? {};
    state.corrections[recordId] = { ...current, ...patch };
    const applied = correctionsModule.countCorrections(state.corrections);
    const note = $('#cbse-corrections-note');
    if (note) {
      note.textContent = applied
        ? `${applied} record(s) were corrected by hand. The corrections are shown in the report and the printed value is kept in the export.`
        : '';
      note.hidden = !applied;
    }
    // The summary and the checks are rebuilt, the editable row is left alone so
    // the field the reviewer is typing in keeps the focus.
    const dataset = refreshDataset();
    if (!dataset) return;
    const analytics = analyticsModule.computeAnalytics(dataset, { bands: state.bands ?? analyticsModule.DEFAULT_BANDS, topCount: state.topCount });
    renderSummaryTable(dataset, analytics);
    renderValidation(validateModule.validateDataset(dataset, analytics));
  }

  function renderSummaryTable(dataset, analytics) {
    const body = $('#cbse-summary-body');
    body.innerHTML = '';
    const rows = [
      ['Total candidates', analytics.totals.candidates],
      ['Passed', analytics.totals.passed],
      ['Compartment', analytics.totals.compartment],
      ['Essential repeat', analytics.totals.essentialRepeat],
      ['Absent', analytics.totals.absent],
      ['Appeared candidates', analytics.totals.appeared],
      ['Pass percentage (of appeared)', analytics.totals.passPercentage == null ? 'Not available' : `${analytics.totals.passPercentage}%`],
      ['Pass percentage (of all candidates)', analytics.totals.passPercentageOfAll == null ? 'Not available' : `${analytics.totals.passPercentageOfAll}%`]
    ];
    for (const [label, value] of rows) {
      const row = el('tr');
      row.appendChild(el('th', null, label));
      row.appendChild(el('td', 'cbse-mono', value));
      body.appendChild(row);
    }
    const printed = dataset.printedSummary;
    const printedBox = $('#cbse-summary-printed');
    if (printedBox) {
      printedBox.innerHTML = '';
      printedBox.hidden = !printed;
      if (printed) {
        printedBox.appendChild(el('span', 'cbse-summary-printed-label', 'Printed in the gazette'));
        const list = el('span', 'cbse-summary-totals');
        const totals = [
          ['total', printed.totalCandidates],
          ['pass', printed.totalPass],
          ['compartment', printed.compartment],
          ['essential repeat', printed.essentialRepeat],
          ['absent', printed.absent]
        ];
        for (const [label, value] of totals) {
          const chip = el('span', 'cbse-summary-chip');
          chip.appendChild(el('span', 'cbse-summary-chip-label', label));
          chip.appendChild(el('b', null, value));
          list.appendChild(chip);
        }
        printedBox.appendChild(list);
      }
    }
  }

  function applyReview() {
    const dataset = activeDataset();
    if (!dataset) return;
    for (const input of $$('#cbse-meta-body [data-meta-key]')) {
      const key = input.dataset.metaKey;
      dataset.meta[key] = input.type === 'number' ? (input.value === '' ? null : Number(input.value)) : input.value;
    }
    // Only a value the reviewer actually changed becomes an override. A maximum
    // that the analyzer worked out on its own stays an inference, so the
    // report keeps saying where the scale came from.
    const overrides = {};
    for (const input of $$('#cbse-subject-body [data-subject-name]')) {
      const code = input.dataset.subjectName;
      const maxInput = $(`#cbse-subject-body [data-subject-max="${code}"]`);
      const entry = {};
      const name = input.value.trim();
      const originalName = input.dataset.originalName ?? '';
      const placeholder = `Subject ${code}`;
      if (name && name !== originalName && name !== placeholder) entry.name = name;
      if (maxInput && maxInput.value) {
        const max = Number(maxInput.value);
        const originalMax = Number(maxInput.dataset.originalMax);
        if (Number.isFinite(max) && max > 0 && max !== originalMax) entry.max = max;
      }
      if (Object.keys(entry).length) overrides[code] = entry;
    }
    state.overrides[state.activeId] = overrides;
    refreshDataset();
    renderDashboard();
    state.maxStep = 'dashboard';
    show('dashboard');
    setStatus('The report has been rebuilt with your corrections.', 'success');
    $('#cbse-dashboard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function buildFilterOptions() {
    const dataset = activeDataset();
    if (!dataset) return;
    const analytics = analyticsModule.computeAnalytics(dataset, { bands: state.bands ?? analyticsModule.DEFAULT_BANDS, topCount: state.topCount });
    const subjectSelect = $('#cbse-filter-subject');
    const currentSubject = subjectSelect.value;
    subjectSelect.innerHTML = '';
    subjectSelect.appendChild(new Option('All subjects', ''));
    for (const subject of analytics.subjects) {
      subjectSelect.appendChild(new Option(`${subject.name} (${subject.code})`, subject.code));
    }
    subjectSelect.value = currentSubject;

    const statusSelect = $('#cbse-filter-status');
    const currentStatus = statusSelect.value;
    statusSelect.innerHTML = '';
    statusSelect.appendChild(new Option('All statuses', ''));
    for (const entry of analytics.statusDistribution) {
      statusSelect.appendChild(new Option(entry.label, entry.key));
    }
    statusSelect.value = currentStatus;

    const gradeSelect = $('#cbse-filter-grade');
    const currentGrade = gradeSelect.value;
    gradeSelect.innerHTML = '';
    gradeSelect.appendChild(new Option('All grades', ''));
    const grades = new Set();
    for (const candidate of dataset.candidates) {
      for (const subject of candidate.subjects) {
        if (subject.grade.value) grades.add(subject.grade.value);
      }
    }
    for (const grade of [...grades].sort()) gradeSelect.appendChild(new Option(grade, grade));
    gradeSelect.value = currentGrade;
  }

  function readFilters() {
    const value = selector => {
      const node = $(selector);
      return node && node.value !== '' ? node.value : null;
    };
    const number = selector => {
      const node = $(selector);
      return node && node.value !== '' ? Number(node.value) : null;
    };
    state.filters = {
      year: value('#cbse-filter-year'),
      className: value('#cbse-filter-class'),
      school: value('#cbse-filter-school'),
      region: value('#cbse-filter-region'),
      subject: value('#cbse-filter-subject'),
      status: value('#cbse-filter-status'),
      grade: value('#cbse-filter-grade'),
      scoreMin: number('#cbse-filter-score-min'),
      scoreMax: number('#cbse-filter-score-max')
    };
  }

  const FILTER_INPUTS = [
    '#cbse-filter-year', '#cbse-filter-class', '#cbse-filter-school', '#cbse-filter-region',
    '#cbse-filter-subject', '#cbse-filter-status', '#cbse-filter-grade',
    '#cbse-filter-score-min', '#cbse-filter-score-max'
  ];

  /**
   * Clear the filters. A filter belongs to one gazette, so it is dropped
   * whenever another file becomes the one being read.
   */
  function clearFilters() {
    for (const id of FILTER_INPUTS) {
      const node = $(id);
      if (node) node.value = '';
    }
    readFilters();
  }

  function renderDashboard() {
    const dataset = refreshDataset();
    if (!dataset) return;
    const bands = state.bands ?? analyticsModule.DEFAULT_BANDS;
    const analytics = analyticsModule.computeAnalytics(dataset, { filters: state.filters, bands, topCount: state.topCount });
    const validation = validateModule.validateDataset(dataset, analytics);
    state.analytics = analytics;
    state.validation = validation;
    state.filteredCandidates = analyticsModule.applyFilters(dataset, state.filters);

    buildFilterOptions();
    renderKpis(analytics);
    renderCharts(analytics, dataset);
    renderTopPerformers(analytics);
    renderSubjectTable(analytics);
    renderGenderTable(analytics);
    renderValidation(validation);
    renderStudentList(analytics);
  }

  function renderKpis(analytics) {
    const container = $('#cbse-kpis');
    container.innerHTML = '';
    const tiles = exporterModule.buildHeadlineTiles(analytics);
    for (const tile of tiles) {
      const card = el('div', 'cbse-kpi');
      card.appendChild(el('span', 'cbse-kpi-label', tile.label));
      card.appendChild(el('strong', 'cbse-kpi-value', tile.value));
      card.appendChild(el('span', 'cbse-kpi-note', tile.note));
      container.appendChild(card);
    }
  }

  function renderCharts(analytics, dataset) {
    const { renderChart } = window.iLoveMyFilesModules['cbse-charts'];
    const colors = ['#5d5cf6', '#0f9d9d', '#d98237', '#d05d9a', '#4089e9', '#1a9f70', '#b88b21', '#d9567f'];
    const bands = state.bands ?? analyticsModule.DEFAULT_BANDS;

    const statusContainer = $('#cbse-chart-status');
    renderChart(statusContainer, {
      type: 'donut',
      title: 'Result status distribution',
      description: 'How the candidates of this gazette are distributed across the printed result statuses.',
      categories: analytics.statusDistribution.map(entry => entry.label),
      series: [{ name: 'Candidates', values: analytics.statusDistribution.map(entry => entry.count) }],
      centreLabel: 'Candidates',
      valueFormat: value => `${value}`
    });

    const subjectContainer = $('#cbse-chart-subjects');
    renderChart(subjectContainer, {
      type: 'bar',
      title: 'Average marks by subject',
      description: 'The average of the numeric marks printed for each subject.',
      categories: analytics.subjects.map(subject => subject.code),
