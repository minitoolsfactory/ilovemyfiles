      valueFormat: value => `${value}`
    });

    const gradeContainer = $('#cbse-chart-grades');
    renderChart(gradeContainer, {
      type: 'stacked',
      title: 'Grade distribution by subject',
      description: 'How many marks were printed for each grade in each subject.',
