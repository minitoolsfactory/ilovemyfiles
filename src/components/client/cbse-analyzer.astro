      xLabel: 'Subject code',
      yLabel: 'Marks',
      valueFormat: value => `${value}`
    });

    const rangeContainer = $('#cbse-chart-range');
    renderChart(rangeContainer, {
      type: 'range',
      title: 'Lowest, average and highest marks by subject',
      description: 'The spread of the marks printed for each subject.',
      categories: analytics.subjects.map(subject => subject.code),
      series: [{
        name: 'Marks',
        values: analytics.subjects.map(subject => ({ min: subject.minimum ?? 0, avg: subject.average ?? 0, max: subject.maximum ?? 0 }))
      }],
