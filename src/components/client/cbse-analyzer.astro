      series: (analytics.gradeDistribution.length ? analytics.gradeDistribution.map(entry => entry.grade) : ['(none)']).map((grade, index) => ({
        name: grade,
        color: colors[index % colors.length],
        values: analytics.subjects.map(subject => subject.gradeCounts[grade] ?? 0)
      })),
      xLabel: 'Subject code',
