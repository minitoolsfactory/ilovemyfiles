        { name: 'Absent', key: 'absent' },
        { name: 'Other', key: 'other' }
      ];
      renderChart(genderContainer, {
        type: 'bar',
        title: 'Boys and girls',
        description: 'The result status of the candidates, split by the gender printed in the gazette.',
        categories: genders.map(entry => entry.label),
        series: statuses.map((status, index) => ({
          name: status.name,
          color: colors[index % colors.length],
          values: genders.map(entry => entry[status.key] ?? 0)
        })),
        xLabel: 'Gender',
        yLabel: 'Candidates',
        valueFormat: value => `${value}`
      });
    }

    const confidenceContainer = $('#cbse-chart-confidence');
    renderChart(confidenceContainer, {
      type: 'bar',
      title: 'Extraction confidence',
      description: 'How many records fell into each confidence band.',
      categories: analytics.confidence.distribution.map(entry => entry.label),
      series: [{ name: 'Records', values: analytics.confidence.distribution.map(entry => entry.count), color: colors[4] }],
      xLabel: 'Confidence band',
      yLabel: 'Records',
      valueFormat: value => `${value}`
    });
  }

  function renderSubjectTable(analytics) {
    const body = $('#cbse-subject-results-body');
    body.innerHTML = '';
    // A gazette that prints the grades without the marks has no statistics to
    // show, so the grade distribution takes their place.
    const hasMarks = analytics.subjects.some(subject => subject.valid > 0);
    const header = hasMarks
      ? ['Code', 'Subject', 'Max', 'Students', 'Average', 'Median', 'Lowest', 'Highest', 'Std dev', 'Average %', 'Grades']
      : ['Code', 'Subject', 'Max', 'Candidates', 'Grades printed'];
    const table = $('#cbse-subject-results');
    const head = table.querySelector('thead');
    head.innerHTML = '';
    const headRow = el('tr');
    for (const label of header) {
      const th = el('th', null, label);
      th.scope = 'col';
      headRow.appendChild(th);
    }
    head.appendChild(headRow);
    for (const subject of analytics.subjects) {
      const row = el('tr');
      const gradeText = Object.entries(subject.gradeCounts ?? {})
        .map(([grade, count]) => `${grade}: ${count}`)
        .join(', ') || '-';
      const cells = hasMarks
        ? [
            subject.code,
            subject.name,
            subject.max ?? 'Unknown',
            subject.valid,
            subject.average ?? '-',
            subject.median ?? '-',
            subject.minimum ?? '-',
            subject.maximum ?? '-',
            subject.stdDev ?? '-',
            subject.averagePercent == null ? '-' : `${subject.averagePercent}%`,
            gradeText
          ]
        : [subject.code, subject.name, subject.max ?? 'Unknown', subject.occurrences, gradeText];
      cells.forEach((value, index) => {
        const cell = el('td', index === 0 ? 'cbse-mono' : null, value);
        row.appendChild(cell);
      });
      body.appendChild(row);
    }
  }

  /** Fixed column widths of the student table, in pixels. */
  const COLUMNS = { roll: 108, name: 190, gender: 72, status: 112, subject: 92 };
  /** Fixed column widths of the top candidate table, in pixels. */
  const TOP_COLUMNS = { rank: 64, roll: 108, name: 190, gender: 72, result: 104, total: 84, available: 96, percent: 110 };

  /**
   * The gender printed in the gazette, as a short label.
   *
   * @param {string} gender
   * @returns {string}
   */
  function genderLabel(gender) {
    const value = String(gender ?? '').trim().toUpperCase();
    if (value === 'F') return 'F';
    if (value === 'M') return 'M';
    return '-';
  }

  /**
   * The subject columns of the student and top candidate tables: one column
   * for every subject code the gazette prints, in the order it prints them.
   *
   * @param {Object} analytics
   * @returns {string[]}
   */
  function subjectColumns(analytics) {
    return analytics?.subjectCodes ?? [];
  }

  /**
   * The name and the published maximum of a subject, for the column heading.
   *
   * @param {Object} analytics
   * @param {string} code
   * @returns {{ name: string, max: number|null }}
   */
  function subjectMeta(analytics, code) {
    const entry = (analytics?.subjects ?? []).find(subject => subject.code === code);
    return { name: entry?.name ?? `Subject ${code}`, max: entry?.max ?? null };
  }

  /**
   * Build the header cells for the subject columns. Each heading carries the
   * code, the official name and the maximum in force, and it sorts the table.
   *
   * @param {Object} analytics
   * @param {HTMLTableSectionElement} head
   * @param {string[]} leading the header cells that come before the subjects
   * @param {string[]} sortable the leading columns that can be sorted
   */
  function buildSubjectHead(analytics, head, leading, sortable = [], widths = null) {
    if (!head) return;
    const row = el('tr');
    leading.forEach((label, index) => {
      const key = sortable[index] ?? '';
      const th = el('th', key ? 'cbse-sortable' : null);
      th.scope = 'col';
      th.dataset.sortKey = key;
      if (widths?.[index]) th.style.width = `${widths[index]}px`;
      if (key) {
        const button = el('button', 'cbse-sort-button');
        button.type = 'button';
        button.appendChild(el('span', null, label));
        button.appendChild(el('span', 'cbse-sort-arrow', ''));
        button.addEventListener('click', () => toggleSort(key));
        th.appendChild(button);
      } else {
        th.textContent = label;
      }
      row.appendChild(th);
    });
    for (const code of subjectColumns(analytics)) {
      const meta = subjectMeta(analytics, code);
      const th = el('th', 'cbse-subject-head cbse-sortable');
      th.scope = 'col';
      th.colSpan = 2;
      th.dataset.sortKey = `subject:${code}`;
      th.title = `${code} ${meta.name} - maximum in force ${meta.max ?? 'unknown'}. Click to sort by this subject.`;
      const button = el('button', 'cbse-sort-button cbse-sort-button-block');
      button.type = 'button';
      button.appendChild(el('span', 'cbse-th-code', code));
      button.appendChild(el('span', 'cbse-th-name', meta.name));
      button.appendChild(el('span', 'cbse-th-max', `max ${meta.max ?? '?'}`));
      button.appendChild(el('span', 'cbse-sort-arrow', ''));
      button.addEventListener('click', () => toggleSort(`subject:${code}`));
      th.appendChild(button);
      row.appendChild(th);
    }
    head.innerHTML = '';
    head.appendChild(row);
    applySortState(head);
    const table = head.closest('table');
    if (table) {
      const leadingWidth = leading.reduce((sum, _, index) => sum + (widths?.[index] ?? 110), 0);
      const width = leadingWidth + (widths?.subject ?? COLUMNS.subject) * subjectColumns(analytics).length;
      table.style.width = `${width}px`;
    }
  }

  /**
   * Sort the table by a column. Clicking the same column again flips the
   * direction, a third click goes back to the printed order.
   */
  function toggleSort(key) {
    if (state.sort.key === key) {
      state.sort.direction = state.sort.direction === 'asc' ? 'desc' : 'asc';
    } else {
      state.sort = { key, direction: 'asc', toggles: 1 };
    }
    state.page = 1;
    renderStudentList(state.analytics ?? {});
    updateSortControls();
  }

  function applySortState(head) {
    for (const th of head.querySelectorAll('th[data-sort-key]')) {
      const key = th.dataset.sortKey;
      if (!key) continue;
      const active = state.sort.key === key;
      th.setAttribute('aria-sort', active ? (state.sort.direction === 'asc' ? 'ascending' : 'descending') : 'none');
      const arrow = th.querySelector('.cbse-sort-arrow');
      if (arrow) arrow.textContent = active ? (state.sort.direction === 'asc' ? '▲' : '▼') : '';
    }
  }

  /**
   * Sort the candidate list for the table.
   *
   * @param {Object[]} candidates
   * @returns {Object[]}
   */
  function sortCandidates(candidates) {
    const { key, direction } = state.sort;
    if (!key) return candidates;
    const factor = direction === 'asc' ? 1 : -1;
    const sorted = [...candidates].sort((a, b) => {
      if (key.startsWith('subject:')) {
        const code = key.slice(8);
        const left = a.subjects.find(subject => subject.code === code)?.marks.value ?? null;
        const right = b.subjects.find(subject => subject.code === code)?.marks.value ?? null;
        // A candidate with no mark in the subject always sorts last, in both
        // directions, so an absent candidate never tops the list.
        if (left === null && right === null) return a.rollNo.localeCompare(b.rollNo);
        if (left === null) return 1;
        if (right === null) return -1;
        if (left === right) return a.rollNo.localeCompare(b.rollNo);
        return (left - right) * factor;
      }
      if (key === 'roll') return a.rollNo.localeCompare(b.rollNo) * factor;
      if (key === 'name') return a.name.localeCompare(b.name) * factor;
      if (key === 'status') return a.status.localeCompare(b.status) * factor;
      return 0;
    });
    return sorted;
  }

  /**
   * The cell of one subject for one candidate. A candidate who was not
   * offered the subject gets a dash, and so does a subject with no printed
   * mark. The two are told apart in the tooltip.
   *
   * @param {Object} candidate
   * @param {string} code
   * @returns {{ text: string, title: string }}
   */
  function subjectCell(candidate, code) {
    const subject = (candidate.subjects ?? []).find(item => item.code === code);
    if (!subject) {
      return { mark: '-', grade: '-', title: `Subject ${code} was not offered to this candidate` };
    }
    const mark = subject.marks.value;
    const grade = subject.grade.value;
    const printed = subject.marks.raw || '';
    if (mark == null && printed) {
      return { mark: printed, grade: grade ?? '-', title: `Subject ${code}: the gazette prints ${printed}, the candidate was absent for it` };
    }
    if (mark == null && !grade) {
      return { mark: '-', grade: '-', title: `Subject ${code} has no printed mark and no printed grade` };
    }
    if (mark == null) {
      return { mark: '-', grade: grade ?? '-', title: `Subject ${code}: grade ${grade}, the gazette prints no mark` };
    }
    return {
      mark: String(mark),
      grade: grade ?? '-',
      title: `Subject ${code}: mark ${mark}${grade ? `, grade ${grade}` : ''}`
    };
  }

  /**
   * Build the header cells for the subject columns.
   *
   * @param {Object} analytics
   * @param {HTMLTableSectionElement} head
   * @param {string[]} leading the header cells that come before the subjects
   */
  function renderTopPerformers(analytics) {
    const note = $('#cbse-top-note');
    if (note) {
      const hasMarks = (analytics.subjects ?? []).some(subject => subject.valid > 0);
      note.textContent = hasMarks
        ? 'The candidates with the highest total, ranked by the marks they scored as a percentage of the marks available to them. Candidates with the same percentage share a rank, and the result status is shown as printed.'
        : 'This gazette prints the subject grades without the marks, so there is no total to rank by. The candidates are listed in the printed order with the grade of every subject.';
    }
    const body = $('#cbse-top-body');
    const table = $('#cbse-top-table');
    const wrap = table?.closest('.cbse-table-scroll');
    const empty = $('#cbse-top-empty');
    body.innerHTML = '';
    const rows = analytics.topPerformers ?? [];
    if (!rows.length) {
      if (table) table.hidden = true;
      if (wrap) wrap.hidden = true;
      if (empty) empty.hidden = false;
      return;
    }
    if (table) table.hidden = false;
    if (wrap) wrap.hidden = false;
    if (empty) empty.hidden = true;
    buildSubjectHead(analytics, $('#cbse-top-head'), ['Rank', 'Roll number', 'Name', 'Gender', 'Result', 'Total', 'Available', 'Percentage'], [],
      [TOP_COLUMNS.rank, TOP_COLUMNS.roll, TOP_COLUMNS.name, TOP_COLUMNS.gender, TOP_COLUMNS.result, TOP_COLUMNS.total, TOP_COLUMNS.available, TOP_COLUMNS.percent]);
    for (const entry of rows) {
      const row = el('tr');
      row.appendChild(el('td', 'cbse-rank', entry.rank));
      row.appendChild(el('td', 'cbse-mono', entry.rollNo));
      row.appendChild(el('td', 'cbse-name-cell', entry.name));
      row.appendChild(el('td', 'cbse-gender-cell', genderLabel(entry.gender)));
      row.appendChild(el('td', 'cbse-status-cell', entry.status));
      row.appendChild(el('td', 'cbse-mono cbse-number', entry.total ?? '-'));
      row.appendChild(el('td', 'cbse-mono cbse-number', entry.available ?? '-'));
      row.appendChild(el('td', 'cbse-mono cbse-number cbse-percent', entry.percent == null ? '-' : `${entry.percent}%`));
      const byCode = new Map((entry.subjects ?? []).map(subject => [subject.code, subject]));
      for (const code of subjectColumns(analytics)) {
        const subject = byCode.get(code);
        let text = '-';
        let title = `Subject ${code} was not offered to this candidate`;
        let gradeText = '-';
        if (subject) {
          const mark = subject.marks;
          const grade = subject.grade;
          const printed = subject.marksRaw || '';
          if (mark == null && printed) {
            text = printed;
            title = `Subject ${code}: the gazette prints ${printed}, the candidate was absent for it`;
          } else if (mark == null && !grade) {
            title = `Subject ${code} has no printed mark and no printed grade`;
          } else if (mark == null) {
            gradeText = grade ?? '-';
            title = `Subject ${code}: grade ${grade}, the gazette prints no mark`;
          } else {
            text = String(mark);
            gradeText = grade ?? '-';
            title = `Subject ${code}: mark ${mark}${grade ? `, grade ${grade}` : ''}`;
          }
        }
        const cell = el('td', 'cbse-mono cbse-subject-cell', text);
        cell.title = title;
        row.appendChild(cell);
        const gradeCell = el('td', 'cbse-mono cbse-grade-cell', gradeText);
        gradeCell.title = title;
        row.appendChild(gradeCell);
      }
      body.appendChild(row);
    }
  }

  function renderGenderTable(analytics) {
    const body = $('#cbse-gender-body');
    if (!body) return;
    body.innerHTML = '';
    for (const entry of analytics.genderBreakdown ?? []) {
      const row = el('tr');
      row.appendChild(el('th', null, entry.label));
      row.appendChild(el('td', 'cbse-mono', entry.candidates));
      row.appendChild(el('td', 'cbse-mono', entry.passed));
      row.appendChild(el('td', 'cbse-mono', entry.appeared));
      row.appendChild(el('td', 'cbse-mono', entry.passPercentage == null ? '-' : `${entry.passPercentage}%`));
      body.appendChild(row);
    }
    if (!(analytics.genderBreakdown ?? []).length) {
      const row = el('tr');
      const cell = el('td', 'field-help', 'This gazette prints no gender.');
      cell.colSpan = 5;
      row.appendChild(cell);
      body.appendChild(row);
    }
  }

  /**
   * The data quality checks, kept for reference. They are folded away in the
   * review step, so only the summary line is visible until they are opened.
   *
   * @param {Object} validation
   */
  function renderValidation(validation) {
    const container = $('#cbse-checks');
    if (container) {
      container.innerHTML = '';
      for (const check of validation.checks) {
        const item = el('li', `cbse-check cbse-check-${check.status}`);
        item.appendChild(el('span', 'cbse-check-badge', check.status.toUpperCase()));
        const copy = el('div');
        copy.appendChild(el('b', null, check.label));
        copy.appendChild(el('span', 'cbse-check-detail', check.detail));
        item.appendChild(copy);
        container.appendChild(item);
      }
    }
    const summary = $('#cbse-checks-summary');
    if (summary) {
      const failed = validation.checks.filter(check => check.status === 'fail').length;
      const warned = validation.checks.filter(check => check.status === 'warn').length;
      const passed = validation.checks.filter(check => check.status === 'pass').length;
      summary.textContent = failed
        ? `${failed} to look at, ${warned} warning(s), ${passed} passed`
        : warned
          ? `${warned} warning(s), ${passed} passed`
          : `${passed} checks passed`;
    }
  }

  /**
   * The candidates of the student table: the current selection, narrowed by the
   * search box and ordered by the sort.
   *
   * @returns {Object[]}
   */
  function studentRows() {
    const all = state.filteredCandidates ?? [];
    const needle = String(state.studentQuery ?? '').trim().toUpperCase();
    const matched = needle
      ? all.filter(candidate => candidate.rollNo.toUpperCase().includes(needle) || candidate.name.toUpperCase().includes(needle))
      : all;
    return sortCandidates(matched);
  }

  function renderStudentList(analytics) {
    const body = $('#cbse-student-body');
    body.innerHTML = '';
    const candidates = studentRows();
    const size = Math.max(1, state.pageSize);
    const pages = Math.max(1, Math.ceil(candidates.length / size));
    if (state.page > pages) state.page = pages;
    if (state.page < 1) state.page = 1;
    const start = (state.page - 1) * size;
    const rows = candidates.slice(start, start + size);

    buildSubjectHead(analytics, $('#cbse-student-head'), ['Roll number', 'Name', 'Gender', 'Status'], ['roll', 'name', 'gender', 'status'],
      [COLUMNS.roll, COLUMNS.name, COLUMNS.gender, COLUMNS.status]);
    buildSortOptions(analytics);
    applySortState($('#cbse-student-head'));

    for (const candidate of rows) {
      body.appendChild(studentRow(candidate, analytics));
    }
    if (!rows.length) {
      const row = el('tr');
      const cell = el('td', 'field-help', 'No record matches the current filters.');
      cell.colSpan = 3 + subjectColumns(analytics).length;
      row.appendChild(cell);
      body.appendChild(row);
    }

    const count = $('#cbse-student-count');
    if (count) {
      count.textContent = candidates.length
        ? `Showing ${start + 1}-${Math.min(start + size, candidates.length)} of ${candidates.length} record(s)`
        : 'No record matches the current filters';
    }
    const label = $('#cbse-page-label');
    if (label) label.textContent = `Page ${state.page} of ${pages}`;
    for (const [id, disabled] of [['#cbse-page-first', state.page <= 1], ['#cbse-page-prev', state.page <= 1], ['#cbse-page-next', state.page >= pages], ['#cbse-page-last', state.page >= pages]]) {
      const button = $(id);
      if (button) button.disabled = disabled;
    }
  }

  /**
   * Fill the "sort by" control with the columns of the table.
   *
   * @param {Object} analytics
   */
  function buildSortOptions(analytics) {
    const select = $('#cbse-sort-key');
    if (!select) return;
    const current = state.sort.key ?? '';
    select.innerHTML = '';
    select.appendChild(new Option('Printed order', ''));
    select.appendChild(new Option('Roll number', 'roll'));
    select.appendChild(new Option('Name', 'name'));
    select.appendChild(new Option('Result status', 'status'));
    for (const code of subjectColumns(analytics)) {
      const meta = subjectMeta(analytics, code);
      select.appendChild(new Option(`${code} ${meta.name}`, `subject:${code}`));
    }
    select.value = current;
    updateSortControls();
  }

  function updateSortControls() {
    const direction = $('#cbse-sort-direction');
    if (!direction) return;
    const active = Boolean(state.sort.key);
    direction.textContent = state.sort.direction === 'asc' ? 'Ascending ▲' : 'Descending ▼';
    direction.setAttribute('aria-pressed', active && state.sort.direction === 'desc' ? 'true' : 'false');
    direction.title = active
      ? `The table is sorted ${state.sort.direction === 'asc' ? 'ascending' : 'descending'}. Click to reverse the order.`
      : 'Choose a column to sort by first.';
  }

  /**
   * One row of the student table: the identity, the printed status and one
   * cell for every subject code of the gazette.
   *
   * @param {Object} candidate
   * @param {Object} analytics
   * @returns {HTMLTableRowElement}
   */
  function studentRow(candidate, analytics) {
    const row = el('tr');
    row.appendChild(el('td', 'cbse-mono', candidate.rollNo));
    row.appendChild(el('td', null, candidate.name));
    row.appendChild(el('td', 'cbse-gender-cell', genderLabel(candidate.gender)));
    row.appendChild(el('td', null, candidate.status));
    for (const code of subjectColumns(analytics)) {
      const value = subjectCell(candidate, code);
      const markCell = el('td', 'cbse-mono cbse-subject-cell', value.mark);
      markCell.title = value.title;
      row.appendChild(markCell);
      const gradeCell = el('td', 'cbse-mono cbse-grade-cell', value.grade);
      gradeCell.title = value.title;
      row.appendChild(gradeCell);
    }
    return row;
  }

  function searchStudents(query) {
    state.studentQuery = query ?? '';
    state.page = 1;
    renderStudentList(state.analytics ?? {});
  }

  /**
   * A short plain text summary of the headline numbers, so a figure can be
   * pasted into a message or a document without opening the export.
   */
  function buildHeadlineText() {
    const dataset = refreshDataset() ?? activeDataset();
    if (!dataset) return '';
    const analytics = state.analytics ?? analyticsModule.computeAnalytics(dataset, { filters: state.filters, bands: state.bands ?? analyticsModule.DEFAULT_BANDS, topCount: state.topCount });
    const meta = dataset.meta ?? {};
    const totals = analytics.totals;
    const lines = [];
    const title = [meta.schoolCode, meta.schoolName, meta.class, meta.year].filter(Boolean).join(' · ');
    lines.push(title ? `CBSE result analysis - ${title}` : 'CBSE result analysis');
    if (meta.sourceFileName) lines.push(`Source: ${meta.sourceFileName}`);
    lines.push(`Total candidates: ${totals.candidates}`);
    lines.push(`Passed: ${totals.passed}${totals.passPercentage == null ? '' : ` (${totals.passPercentage}% of ${totals.appeared} appeared)`}`);
    lines.push(`Compartment: ${totals.compartment}`);
    lines.push(`Essential repeat: ${totals.essentialRepeat}`);
    lines.push(`Absent: ${totals.absent}`);
    lines.push(`Appeared candidates: ${totals.appeared}`);
    if (analytics.subjects.length) {
      lines.push('');
      lines.push('Subject averages:');
      for (const subject of analytics.subjects) {
        const average = subject.average == null ? 'no marks' : `${subject.average}/${subject.max ?? '?'}`;
        const percent = subject.averagePercent == null ? '' : ` (${subject.averagePercent}%)`;
        lines.push(`- ${subject.code} ${subject.name}: ${average}${percent}`);
      }
    }
    const confidence = analytics.confidence?.mean;
    if (confidence != null) lines.push('', `Mean extraction confidence: ${Math.round(confidence * 100)}%`);
    return lines.join('\n');
  }

  async function copyHeadline() {
    try {
      const text = buildHeadlineText();
      if (!text) throw new Error('There is no report to copy yet.');
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
      } else {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', 'readonly');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        document.execCommand('copy');
        area.remove();
      }
      setStatus('The headline numbers were copied to the clipboard.', 'success');
    } catch (error) {
      setStatus(error?.message ?? 'The summary could not be copied.', 'error');
    }
  }

  function buildExportContext() {    const dataset = refreshDataset() ?? activeDataset();
    const analytics = state.analytics ?? analyticsModule.computeAnalytics(dataset, { filters: state.filters, bands: state.bands ?? analyticsModule.DEFAULT_BANDS, topCount: state.topCount });
    const validation = state.validation ?? validateModule.validateDataset(dataset, analytics);
    const model = exporterModule.buildExportModel(analytics, dataset, validation.checks, {
      corrections: correctionsModule.countCorrections(state.corrections),
      candidates: state.filteredCandidates ?? dataset.candidates
    });
    return { dataset, analytics, validation, model };
  }

  function downloadBlob(blob, filename) {
    const { downloadBlob: save } = window.iLoveMyFilesModules['file-utils'];
    save(blob, filename);
  }

  async function exportCsv() {
    try {
      const { model } = buildExportContext();
      const bundle = exporterModule.buildCsvBundle(model);
      const { default: JSZip } = await import('jszip');
      const zip = new JSZip();
      for (const [name, text] of Object.entries(bundle)) zip.file(name, text);
      const blob = await zip.generateAsync({ type: 'blob' });
      downloadBlob(blob, 'cbse-result-analysis.zip');
      setStatus('The CSV bundle was downloaded.', 'success');
    } catch (error) {
      setStatus(error?.message ?? 'The export failed.', 'error');
    }
  }

  async function exportXlsx() {
    try {
      const { model } = buildExportContext();
      const blob = await exporterModule.buildXlsx(exporterModule.buildWorkbookSheets(model));
      downloadBlob(blob, 'cbse-result-analysis.xlsx');
      setStatus('The Excel workbook was downloaded.', 'success');
    } catch (error) {
      setStatus(error?.message ?? 'The export failed.', 'error');
    }
  }

  async function exportResultSheet() {
    try {
      const { model, analytics, dataset, validation } = buildExportContext();
      const blob = await exporterModule.buildResultSheetPdf(model, analytics, dataset, validation.checks, {
        candidates: state.filteredCandidates ?? dataset.candidates,
        subjectCodes: analytics.subjectCodes ?? [],
        subjectTable: analytics.subjects ?? [],
        hasMarks: (analytics.subjects ?? []).some(subject => subject.valid > 0)
      });
      downloadBlob(blob, 'cbse-result-sheet.pdf');
      setStatus('The result sheet was downloaded. It holds the candidate results only, one line per candidate.', 'success');
    } catch (error) {
      setStatus(error?.message ?? 'The export failed.', 'error');
    }
  }

  async function exportPdf() {
    try {
      const { model, analytics, dataset, validation } = buildExportContext();
      const sections = exporterModule.buildReportSections(analytics, dataset, validation.checks, {
        candidates: state.filteredCandidates ?? dataset.candidates,
        subjectCodes: analytics.subjectCodes ?? [],
        subjectNames: new Map((analytics.subjects ?? []).map(subject => [subject.code, subject.name])),
        subjectTable: analytics.subjects ?? [],
        hasMarks: (analytics.subjects ?? []).some(subject => subject.valid > 0)
      });
      renderReportPreview(sections, model);
      const dialog = $('#cbse-report-dialog');
      if (dialog?.showModal) dialog.showModal();
      else setStatus('The preview could not be opened, so the PDF was not built.', 'error');
    } catch (error) {
      setStatus(error?.message ?? 'The preview could not be built.', 'error');
    }
  }

  /**
   * Build the key that names the subject codes of a table. It is written in
   * the same type as the marks of the table below it.
   *
   * @param {Array<{ code: string, name: string }>} entries
   * @returns {HTMLTableElement}
   */
  function buildLegend(entries) {
    const pairs = 2;
    const perColumn = Math.ceil(entries.length / pairs);
    const table = el('table', 'cbse-report-legend');
    const body = el('tbody');
    for (let row = 0; row < perColumn; row += 1) {
      const tr = el('tr');
      for (let column = 0; column < pairs; column += 1) {
        const entry = entries[row + column * perColumn];
        const code = el('td', 'cbse-report-legend-code', entry?.code ?? '');
        const name = el('td', null, entry?.name ?? '');
        tr.appendChild(code);
        tr.appendChild(name);
      }
      body.appendChild(tr);
    }
    table.appendChild(body);
    return table;
  }

  /**
   * Render the report preview. It shows the same sections the PDF contains.
   *
   * @param {Object[]} sections
   * @param {Object} model
   */
  function renderReportPreview(sections, model) {
    const host = $('#cbse-report-preview');
    if (!host) return;
    host.innerHTML = '';
    const meta = document.createElement('div');
    meta.className = 'cbse-report-meta';
    meta.appendChild(el('h4', null, 'CBSE Result Analysis Report'));
    meta.appendChild(el('p', null, `${exporterModule.titleCaseName(model.meta.examName) || 'CBSE examination'}${model.meta.year ? ` - ${model.meta.year}` : ''}`));
    meta.appendChild(el('p', null, `${exporterModule.titleCaseName(model.meta.schoolName) || 'School not printed'}${model.meta.schoolCode ? ` (code ${model.meta.schoolCode})` : ''}`));
    meta.appendChild(el('p', 'cbse-report-source', `Region ${exporterModule.titleCaseName(model.meta.region) || 'not printed'} | Gazette date ${model.meta.gazetteDate || 'not printed'}`));
    host.appendChild(meta);

    for (const section of sections) {
      const block = el('section', 'cbse-report-section');
      block.appendChild(el('h4', null, section.title));
      if (section.type === 'meta') {
        const table = el('table', 'cbse-table cbse-table-compact');
        const body = el('tbody');
        for (const [label, value] of section.rows) {
          const row = el('tr');
          row.appendChild(el('th', null, label));
          row.appendChild(el('td', 'cbse-mono', String(value)));
          body.appendChild(row);
        }
        table.appendChild(body);
        block.appendChild(table);
      } else if (section.type === 'headline') {
        const grid = el('div', 'cbse-report-tiles');
        for (const item of section.items) {
          const tile = el('div', 'cbse-report-tile');
          tile.appendChild(el('b', null, item.value));
          tile.appendChild(el('span', null, item.label));
          grid.appendChild(tile);
        }
        block.appendChild(grid);
      } else if (section.type === 'table') {
        const numeric = section.columns.map((_, index) => section.rows.length > 0 && section.rows.every(row => {
          const value = String(row[index] ?? '').trim();
          return value === '' || value === '-' || /^[\d.,%+-]+$/.test(value);
        }));
        if (section.legend?.length) block.appendChild(buildLegend(section.legend));
        const table = el('table', 'cbse-table');
        const head = el('thead');
        const headRow = el('tr');
        section.columns.forEach((column, index) => {
          const th = el('th', numeric[index] ? 'cbse-report-num' : null, column);
          th.scope = 'col';
          headRow.appendChild(th);
        });
        head.appendChild(headRow);
        table.appendChild(head);
        const body = el('tbody');
        for (const row of section.rows) {
          const tr = el('tr');
          row.forEach((cell, index) => tr.appendChild(el('td', numeric[index] ? 'cbse-report-num' : null, String(cell))));
          body.appendChild(tr);
        }
        table.appendChild(body);
        block.appendChild(table);
      } else if (section.type === 'checks') {
        const list = el('ul', 'cbse-checks');
        for (const item of section.items) {
          const li = el('li', `cbse-check cbse-check-${item.status}`);
          li.appendChild(el('span', 'cbse-check-badge', item.status.toUpperCase()));
          const copy = el('div');
          copy.appendChild(el('b', null, item.label));
          copy.appendChild(el('span', 'cbse-check-detail', item.detail));
          li.appendChild(copy);
          list.appendChild(li);
        }
        block.appendChild(list);
      } else if (section.type === 'definitions') {
        const list = el('dl', 'cbse-report-definitions');
        for (const item of section.items) {
          list.appendChild(el('dt', null, item.label));
          list.appendChild(el('dd', null, item.value));
        }
        block.appendChild(list);
      }
      host.appendChild(block);
    }
  }

  async function exportCharts() {
    try {
      const { exportChartPng } = window.iLoveMyFilesModules['cbse-charts'];
      const containers = $$('.cbse-chart');
      if (!containers.length) throw new Error('There are no charts to export yet.');
      for (const container of containers) {
        const id = container.id.replace('cbse-chart-', '');
        await exportChartPng(container, `cbse-${id}.png`);
        await new Promise(resolve => setTimeout(resolve, 120));
      }
      setStatus('The chart images were downloaded.', 'success');
    } catch (error) {
      setStatus(error?.message ?? 'The chart export failed.', 'error');
    }
  }

  function resetAll() {
    state.datasets = [];
    state.activeId = null;
    state.overrides = {};
    state.corrections = {};
    state.filters = { year: null, className: null, school: null, region: null, subject: null, status: null, grade: null, scoreMin: null, scoreMax: null };
    $('#cbse-review').hidden = true;
    $('#cbse-dashboard').hidden = true;
    $('#cbse-upload-step').hidden = false;
    const input = $('#cbse-file');
    if (input) input.value = '';
    setStatus('Everything was cleared. The uploaded gazette is no longer held in this tab.', 'info');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function bind() {
    const drop = $('#cbse-drop');
    const input = $('#cbse-file');
    if (!drop || !input) return;

    input.addEventListener('change', event => handleFiles(event.target.files));
    // The header control stays available in every step, so another gazette can
    // be added without going back to the upload step.
    $('#cbse-file-more')?.addEventListener('change', event => {
      handleFiles(event.target.files);
      event.target.value = '';
    });
    drop.addEventListener('dragover', event => {
      event.preventDefault();
      drop.classList.add('dragging-over');
    });
    drop.addEventListener('dragleave', () => drop.classList.remove('dragging-over'));
    drop.addEventListener('drop', event => {
      event.preventDefault();
      drop.classList.remove('dragging-over');
      handleFiles(event.dataTransfer?.files ?? []);
    });

    $('#cbse-apply')?.addEventListener('click', applyReview);
    for (const tab of $$('.cbse-step')) {
      tab.addEventListener('click', () => goToStep(tab.dataset.step));
    }
    $('#cbse-back')?.addEventListener('click', () => {
      const index = STEP_ORDER.indexOf(state.step);
      if (index > 0) goToStep(STEP_ORDER[index - 1]);
    });
    $('#cbse-reparse')?.addEventListener('click', () => {
      const dataset = activeDataset();
      if (!dataset) return;
      state.datasets = state.datasets.filter(item => item.datasetId !== dataset.datasetId);
      state.activeId = state.datasets[state.datasets.length - 1]?.datasetId ?? null;
      if (!state.datasets.length) {
        resetAll();
        return;
      }
      renderReview();
      setStatus('The gazette was removed. Upload it again to parse it once more.', 'info');
    });
    $('#cbse-reset')?.addEventListener('click', resetAll);
    $('#cbse-review-datasets')?.addEventListener('change', event => {
      state.activeId = event.target.value;
      clearFilters();
      renderReview();
    });

    for (const id of FILTER_INPUTS) {
      $(id)?.addEventListener('change', () => {
        readFilters();
        renderDashboard();
      });
    }
    $('#cbse-filters-reset')?.addEventListener('click', () => {
      clearFilters();
      renderDashboard();
    });

    $('#cbse-top-count')?.addEventListener('change', event => {
      const value = Number(event.target.value);
      if (!Number.isFinite(value) || value < 1) return;
      state.topCount = value;
      renderDashboard();
    });

    $('#cbse-student-search')?.addEventListener('input', event => searchStudents(event.target.value));
    $('#cbse-sort-key')?.addEventListener('change', event => {
      if (!event.target.value) {
        state.sort = { key: null, direction: 'asc', toggles: 0 };
      } else {
        const same = state.sort.key === event.target.value;
        state.sort = { key: event.target.value, direction: same ? (state.sort.direction === 'asc' ? 'desc' : 'asc') : 'asc', toggles: 1 };
      }
      state.page = 1;
      renderStudentList(state.analytics ?? {});
    });
    $('#cbse-sort-direction')?.addEventListener('click', () => {
      if (!state.sort.key) {
        setStatus('Choose a column to sort by first.', 'info');
        return;
      }
      state.sort.direction = state.sort.direction === 'asc' ? 'desc' : 'asc';
      state.page = 1;
      renderStudentList(state.analytics ?? {});
    });
    $('#cbse-sort-clear')?.addEventListener('click', () => {
      state.sort = { key: null, direction: 'asc', toggles: 0 };
      state.page = 1;
      renderStudentList(state.analytics ?? {});
    });
    $('#cbse-page-size')?.addEventListener('change', event => {
      state.pageSize = Number(event.target.value) || 50;
      state.page = 1;
      renderStudentList(state.analytics ?? {});
    });
    for (const [id, delta] of [['#cbse-page-first', -Infinity], ['#cbse-page-prev', -1], ['#cbse-page-next', 1], ['#cbse-page-last', Infinity]]) {
      $(id)?.addEventListener('click', () => {
        const candidates = studentRows();
        const size = Math.max(1, state.pageSize);
        const pages = Math.max(1, Math.ceil(candidates.length / size));
        if (delta === -Infinity) state.page = 1;
        else if (delta === Infinity) state.page = pages;
        else state.page = Math.min(pages, Math.max(1, state.page + delta));
        renderStudentList(state.analytics ?? {});
        $('#cbse-student-title')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      });
    }

    $('#cbse-export-csv')?.addEventListener('click', exportCsv);
    $('#cbse-export-xlsx')?.addEventListener('click', exportXlsx);
    $('#cbse-export-pdf')?.addEventListener('click', exportPdf);
    $('#cbse-export-sheet')?.addEventListener('click', exportResultSheet);
    $('#cbse-report-close')?.addEventListener('click', () => $('#cbse-report-dialog')?.close());
    $('#cbse-report-cancel')?.addEventListener('click', () => $('#cbse-report-dialog')?.close());
    $('#cbse-report-download')?.addEventListener('click', async () => {
      try {
        const { model, analytics, dataset, validation } = buildExportContext();
        const blob = await exporterModule.buildPdfReport(model, analytics, dataset, validation.checks, {
          candidates: state.filteredCandidates ?? dataset.candidates,
          subjectCodes: analytics.subjectCodes ?? [],
          subjectNames: new Map((analytics.subjects ?? []).map(subject => [subject.code, subject.name])),
          subjectTable: analytics.subjects ?? [],
          hasMarks: (analytics.subjects ?? []).some(subject => subject.valid > 0)
        });
        downloadBlob(blob, 'cbse-result-analysis.pdf');
        setStatus('The PDF summary report was downloaded.', 'success');
        $('#cbse-report-dialog')?.close();
      } catch (error) {
        setStatus(error?.message ?? 'The export failed.', 'error');
      }
    });
    $('#cbse-kb-search')?.addEventListener('input', event => renderSubjectLibrary(event.target.value, activeDataset()?.meta?.class ?? null));
    $('#cbse-export-charts')?.addEventListener('click', exportCharts);
    $('#cbse-copy-summary')?.addEventListener('click', copyHeadline);
    $('#cbse-delete-all')?.addEventListener('click', resetAll);

    $('#cbse-band-editor')?.addEventListener('change', event => {
      const value = event.target.value;
      const { DEFAULT_BANDS } = analyticsModule;
      const presets = {
        deciles: DEFAULT_BANDS,
        quartiles: [
          { id: 'q0', label: '0-24%', min: 0, max: 25 },
          { id: 'q1', label: '25-49%', min: 25, max: 50 },
          { id: 'q2', label: '50-74%', min: 50, max: 75 },
          { id: 'q3', label: '75-100%', min: 75, max: 100.0001 }
        ],
        halves: [
          { id: 'h0', label: '0-49%', min: 0, max: 50 },
          { id: 'h1', label: '50-100%', min: 50, max: 100.0001 }
        ]
      };
      state.bands = presets[value] ?? DEFAULT_BANDS;
      renderDashboard();
    });

    show(state.step);

    window.addEventListener('resize', () => {
      clearTimeout(window.__cbseResizeTimer);
      window.__cbseResizeTimer = setTimeout(() => {
        const analytics = state.analytics;
        if (analytics) renderCharts(analytics, activeDataset());
      }, 220);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bind, { once: true });
  } else {
    bind();
  }

  window.iLoveMyFilesModules['cbse-analyzer'] = { resetAll, state };
  });
</script>
