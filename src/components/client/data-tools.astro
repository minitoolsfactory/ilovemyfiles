  }

  const FONT_FORMATS = {
    ttf: { type: 'ttf', mime: 'font/ttf', ext: 'ttf' },
    otf: { type: 'otf', mime: 'font/otf', ext: 'otf' },
    woff: { type: 'woff', mime: 'font/woff', ext: 'woff' },
    woff2: { type: 'woff2', mime: 'font/woff2', ext: 'woff2' }
  };

  async function convertFont(file, target) {
