  }

  function formatSql(text) {
    if (!text.trim()) throw new Error('Enter SQL to format.');
    return text.trim().replace(/\s+/g, ' ').replace(/\b(SELECT|FROM|WHERE|GROUP BY|ORDER BY|HAVING|LIMIT|INSERT INTO|VALUES|UPDATE|SET|DELETE FROM|JOIN|LEFT JOIN|RIGHT JOIN|INNER JOIN|ON|AND|OR)\b/gi, '\n$1').replace(/^\n/, '');
