    if (!FONT_FORMATS[sourceFormat]) throw new Error('Supported inputs are TTF, OTF, WOFF and WOFF2.');
    if (!FONT_FORMATS[target]) throw new Error('Choose TTF, OTF, WOFF or WOFF2 as output.');
