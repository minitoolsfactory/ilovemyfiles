---
const { aiPricing } = Astro.props;
---
<script>
  let aiPricing;
  window.iLoveMyFilesModulesReady = (window.iLoveMyFilesModulesReady ?? Promise.resolve()).then(() => {
    window.iLoveMyFilesModules ??= {};
  function formatJson(text, { minify = false, indent = 2 } = {}) {
    if (!text.trim()) throw new Error('Paste some JSON first.');
    let parsed;
    try { parsed = JSON.parse(text); }
    catch (error) { throw new Error(`Invalid JSON - ${error.message}`); }
    return minify ? JSON.stringify(parsed) : JSON.stringify(parsed, null, Math.max(0, Math.min(8, Number(indent) || 2)));
  }

  function htmlEntities(text, { mode = 'encode' } = {}) {
    if (!text.length) throw new Error('Enter text or HTML first.');
    if (mode === 'encode') {
      return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');
    }
    const document = new DOMParser().parseFromString(text, 'text/html');
    return document.documentElement.textContent ?? '';
  }

  async function jsonYaml(text, { direction = 'json-to-yaml' } = {}) {
    if (!text.trim()) throw new Error('Paste JSON or YAML first.');
    const { parse, stringify } = await import('yaml');
    if (direction === 'yaml-to-json') {
      let value;
      try { value = parse(text); }
      catch (error) { throw new Error(`Invalid YAML - ${error.message}`); }
      return JSON.stringify(value, null, 2);
    }
    let value;
    try { value = JSON.parse(text); }
    catch (error) { throw new Error(`Invalid JSON - ${error.message}`); }
    return stringify(value, { lineWidth: 0 });
  }

  function compareText(text, reference = '') {
    if (!text.length && !reference.length) throw new Error('Enter text in both boxes to compare.');
    const before = reference.split(/\r\n|\r|\n/);
    const after = text.split(/\r\n|\r|\n/);
    if (before.length + after.length > 100000) throw new Error('Each version is limited to 50,000 lines to keep comparisons responsive.');
    // Hirschberg's LCS finds an exact shortest-edit diff in linear memory,
    // unlike the usual full LCS table which can exhaust memory on long text.
    const lcsLengths = (aStart, aEnd, bStart, bEnd, reverse = false) => {
      const width = bEnd - bStart;
      let previous = new Uint32Array(width + 1);
      for (let ai = 0; ai < aEnd - aStart; ai++) {
        const current = new Uint32Array(width + 1);
        const aValue = before[reverse ? aEnd - 1 - ai : aStart + ai];
        for (let bi = 0; bi < width; bi++) {
          const bValue = after[reverse ? bEnd - 1 - bi : bStart + bi];
          current[bi + 1] = aValue === bValue ? previous[bi] + 1 : Math.max(previous[bi + 1], current[bi]);
        }
        previous = current;
      }
      return previous;
    };
    const operations = [];
    const solve = (aStart, aEnd, bStart, bEnd) => {
      if (aStart === aEnd) { for (let j = bStart; j < bEnd; j++) operations.push(['+', after[j]]); return; }
      if (bStart === bEnd) { for (let i = aStart; i < aEnd; i++) operations.push(['-', before[i]]); return; }
      if (aEnd - aStart === 1) {
        const match = after.indexOf(before[aStart], bStart);
        if (match < 0 || match >= bEnd) {
          operations.push(['-', before[aStart]]);
          for (let j = bStart; j < bEnd; j++) operations.push(['+', after[j]]);
        } else {
          for (let j = bStart; j < match; j++) operations.push(['+', after[j]]);
          operations.push([' ', before[aStart]]);
          for (let j = match + 1; j < bEnd; j++) operations.push(['+', after[j]]);
        }
        return;
      }
      const aMid = aStart + Math.floor((aEnd - aStart) / 2);
      const left = lcsLengths(aStart, aMid, bStart, bEnd);
      const right = lcsLengths(aMid, aEnd, bStart, bEnd, true);
      let split = 0, best = -1;
      for (let k = 0; k <= bEnd - bStart; k++) {
        const score = left[k] + right[bEnd - bStart - k];
        if (score > best) { best = score; split = k; }
      }
      const bMid = bStart + split;
      solve(aStart, aMid, bStart, bMid);
      solve(aMid, aEnd, bMid, bEnd);
    };
    solve(0, before.length, 0, after.length);
    return operations.map(([kind, line]) => `${kind} ${line}`).join('\n');
  }

  function formatXml(text) {
    if (!text.trim()) throw new Error('Paste XML first.');
    const document = new DOMParser().parseFromString(text, 'application/xml');
    const error = document.querySelector('parsererror');
    if (error) throw new Error(`Invalid XML: ${error.textContent.trim().slice(0, 180)}`);
    const escapeText = value => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escapeAttr = value => escapeText(value).replace(/"/g, '&quot;');
    const serialize = (node, depth = 0) => {
      const pad = '  '.repeat(depth);
      const attrs = [...node.attributes].map(attribute => ` ${attribute.name}="${escapeAttr(attribute.value)}"`).join('');
      const children = [...node.childNodes].filter(child => child.nodeType === 1 || (child.nodeType === 3 || child.nodeType === 4) && child.nodeValue.trim());
      if (!children.length) return `${pad}<${node.nodeName}${attrs}/>`;
      if (children.every(child => child.nodeType !== 1)) return `${pad}<${node.nodeName}${attrs}>${children.map(child => escapeText(child.nodeValue.trim())).join('')}</${node.nodeName}>`;
      return `${pad}<${node.nodeName}${attrs}>\n${children.map(child => child.nodeType === 1 ? serialize(child, depth + 1) : `${'  '.repeat(depth + 1)}${escapeText(child.nodeValue.trim())}`).join('\n')}\n${pad}</${node.nodeName}>`;
    };
    return `<?xml version="1.0" encoding="UTF-8"?>\n${serialize(document.documentElement)}`;
  }
  
  function utf8ToBase64(value) {
    const bytes = new TextEncoder().encode(value);
    let binary = '';
    bytes.forEach(byte => { binary += String.fromCharCode(byte); });
    return btoa(binary);
  }
  
  function base64ToUtf8(value) {
    let binary;
    try { binary = atob(value.replace(/\s+/g, '')); }
    catch { throw new Error('Input is not valid Base64.'); }
    const bytes = Uint8Array.from(binary, character => character.charCodeAt(0));
    return new TextDecoder().decode(bytes);
  }
  
  function base64Convert(text, { mode = 'encode' } = {}) {
    if (!text.length) throw new Error('Enter some text first.');
    return mode === 'decode' ? base64ToUtf8(text.trim()) : utf8ToBase64(text);
  }
  
  async function digestBytes(buffer, algorithm = 'SHA-256') {
    if (!globalThis.crypto?.subtle) throw new Error('Hashing needs a secure context (https or localhost).');
    if (algorithm === 'MD5') {
      const { md5 } = await import('hash-wasm');
      return md5(new Uint8Array(buffer));
    }
    if (!['SHA-1', 'SHA-256', 'SHA-384', 'SHA-512'].includes(algorithm)) throw new Error(`${algorithm} is not a supported digest algorithm.`);
    const digest = await crypto.subtle.digest(algorithm, buffer);
    return [...new Uint8Array(digest)].map(byte => byte.toString(16).padStart(2, '0')).join('');
  }
  
  async function hashText(text, algorithm = 'SHA-256') {
    if (!text.length) throw new Error('Enter some text to hash.');
    return digestBytes(new TextEncoder().encode(text), algorithm);
  }
  
  async function hashFile(file, algorithm = 'SHA-256') {
    if (!file) throw new Error('Choose a file to hash.');
    const buffer = await file.arrayBuffer();
    return digestBytes(buffer, algorithm);
  }
  
  async function hashFiles(files, algorithm = 'SHA-256') {
    if (!files?.length) throw new Error('Choose at least one file to hash.');
    const lines = [];
    for (const file of files) {
      const hash = await hashFile(file, algorithm);
      lines.push(`${file.name}\t${hash}`);
    }
    return lines.join('\n');
  }
  
  function countText(text) {
    const words = text.trim() ? (text.trim().match(/\S+/g) || []).length : 0;
    const characters = [...text].length;
    const charactersNoSpaces = [...text.replace(/\s/g, '')].length;
    const lines = text.length ? text.split(/\r\n|\r|\n/).length : 0;
    const sentences = text.trim() ? (text.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || []).length : 0;
    const paragraphs = text.trim() ? text.trim().split(/\n\s*\n/).filter(Boolean).length : 0;
    const readingMinutes = words ? Math.max(1, Math.round(words / 200)) : 0;
    return { words, characters, charactersNoSpaces, lines, sentences, paragraphs, readingMinutes };
  }
  
  function countTextReport(text) {
    const stats = countText(text);
    return [
      `Characters: ${stats.characters}`,
      `Characters (no spaces): ${stats.charactersNoSpaces}`,
      `Words: ${stats.words}`,
      `Lines: ${stats.lines}`,
      `Sentences: ${stats.sentences}`,
      `Paragraphs: ${stats.paragraphs}`,
      `Reading time: ~${stats.readingMinutes} min`
    ].join('\n');
  }
  
  function csvEscape(value) {
    const string = value == null ? '' : String(value);
    return /[",\n\r]/.test(string) ? `"${string.replace(/"/g, '""')}"` : string;
  }
  
  function jsonToCsv(text) {
    let data;
    try { data = JSON.parse(text); }
    catch (error) { throw new Error(`Invalid JSON - ${error.message}`); }
    if (!Array.isArray(data)) throw new Error('JSON must be an array of objects.');
    if (!data.length) throw new Error('The JSON array is empty.');
    const headers = [...new Set(data.flatMap(row => Object.keys(row || {})))];
    if (!headers.length) throw new Error('Objects have no keys to convert.');
    const lines = [headers.map(csvEscape).join(',')];
    data.forEach(row => lines.push(headers.map(header => csvEscape(row?.[header])).join(',')));
    return lines.join('\n');
  }
  
  function parseCsv(text) {
    const rows = [];
    let row = [], field = '', inQuotes = false;
    for (let index = 0; index < text.length; index++) {
      const character = text[index];
      if (inQuotes) {
        if (character === '"') {
          if (text[index + 1] === '"') { field += '"'; index++; }
          else inQuotes = false;
        } else field += character;
      } else if (character === '"') inQuotes = true;
      else if (character === ',') { row.push(field); field = ''; }
      else if (character === '\n' || character === '\r') {
        if (character === '\r' && text[index + 1] === '\n') index++;
        row.push(field); rows.push(row); row = []; field = '';
      } else field += character;
    }
    if (field.length || row.length) { row.push(field); rows.push(row); }
    return rows.filter(values => values.some(value => value !== ''));
  }
  
  function csvToJson(text) {
    const rows = parseCsv(text);
    if (rows.length < 2) throw new Error('Enter a CSV with a header row and at least one data row.');
    const headers = rows[0];
    const records = rows.slice(1).map(values => {
      const record = {};
      headers.forEach((header, index) => { record[header] = values[index] ?? ''; });
      return record;
    });
    return JSON.stringify(records, null, 2);
  }

  function csvJsonl(text, { direction = 'csv-to-jsonl' } = {}) {
    if (!text.trim()) throw new Error('Paste CSV or JSON Lines first.');
    if (text.length > 2_000_000) throw new Error('Input is limited to 2 MB to keep conversion responsive.');
    if (direction === 'jsonl-to-csv') {
      const records = text.split(/\r\n|\r|\n/).filter(line => line.trim()).map((line, index) => {
        try {
          const value = JSON.parse(line);
          if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Expected an object.');
          return value;
        } catch (error) { throw new Error(`Invalid JSON on line ${index + 1}: ${error.message}`); }
      });
      if (!records.length) throw new Error('Enter at least one JSON object.');
      const headers = [...new Set(records.flatMap(record => Object.keys(record)))];
      if (!headers.length) throw new Error('JSON objects have no properties to convert.');
      return [headers.map(csvEscape).join(','), ...records.map(record => headers.map(key => csvEscape(record[key])).join(','))].join('\n');
    }
    const rows = parseCsv(text);
    if (rows.length < 2) throw new Error('Enter a CSV with a header row and at least one data row.');
    const headers = rows[0];
    if (new Set(headers).size !== headers.length) throw new Error('CSV headers must be unique to create JSON objects.');
    return rows.slice(1).map(values => JSON.stringify(Object.fromEntries(headers.map((header, index) => [header, values[index] ?? ''])))).join('\n');
  }

  async function extractImagePalette(file, { count = 6 } = {}) {
    if (!file || !file.type?.startsWith('image/')) throw new Error('Choose a supported image first.');
    const bitmap = await createImageBitmap(file);
    try {
      const scale = Math.min(1, 96 / Math.max(bitmap.width, bitmap.height));
      const width = Math.max(1, Math.round(bitmap.width * scale));
      const height = Math.max(1, Math.round(bitmap.height * scale));
      const canvas = document.createElement('canvas');
      canvas.width = width; canvas.height = height;
      const context = canvas.getContext('2d', { willReadFrequently: true });
      if (!context) throw new Error('This browser could not read pixels from the image.');
      context.drawImage(bitmap, 0, 0, width, height);
      const pixels = context.getImageData(0, 0, width, height).data;
      const buckets = new Map();
      for (let i = 0; i < pixels.length; i += 4 * 2) {
        const alpha = pixels[i + 3];
        if (alpha < 96) continue;
        const r = Math.min(255, Math.round(pixels[i] / 32) * 32);
        const g = Math.min(255, Math.round(pixels[i + 1] / 32) * 32);
        const b = Math.min(255, Math.round(pixels[i + 2] / 32) * 32);
        const hex = `#${[r, g, b].map(value => value.toString(16).padStart(2, '0')).join('')}`;
        buckets.set(hex, (buckets.get(hex) ?? 0) + alpha);
      }
      if (!buckets.size) throw new Error('No visible colours were found in this image.');
      return [...buckets.entries()].sort((a, b) => b[1] - a[1]).slice(0, Math.max(1, Math.min(12, Number(count) || 6)))
        .map(([color, weight]) => `${color}\t${weight}`).join('\n');
    } finally { bitmap.close?.(); }
  }

  function decodeJwt(token) {
    const parts = String(token ?? '').trim().split('.');
    if (parts.length !== 3 || parts.some(part => !part)) throw new Error('A compact JWT must contain three non-empty dot-separated parts.');
    const decodePart = (part, label) => {
      let binary;
      try {
        const normalized = part.replace(/-/g, '+').replace(/_/g, '/');
        binary = atob(normalized + '='.repeat((4 - normalized.length % 4) % 4));
      } catch { throw new Error(`The JWT ${label} is not valid Base64URL.`); }
      const bytes = Uint8Array.from(binary, character => character.charCodeAt(0));
      let value;
      try { value = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes)); }
      catch { throw new Error(`The JWT ${label} is not valid UTF-8 JSON.`); }
      if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(`The JWT ${label} must decode to a JSON object.`);
      return value;
    };
    const header = decodePart(parts[0], 'header');
    const payload = decodePart(parts[1], 'payload');
    const claimLines = [];
    for (const claim of ['iss', 'sub', 'aud', 'iat', 'nbf', 'exp', 'jti']) {
      if (payload[claim] == null) continue;
      let display = Array.isArray(payload[claim]) ? payload[claim].join(', ') : String(payload[claim]);
      if (['iat', 'nbf', 'exp'].includes(claim) && Number.isFinite(Number(payload[claim]))) {
        const date = new Date(Number(payload[claim]) * 1000);
        display += Number.isNaN(date.getTime()) ? '' : ` (${date.toISOString()})`;
      }
      claimLines.push(`${claim}: ${display}`);
    }
    const now = Math.floor(Date.now() / 1000);
    const expiration = Number(payload.exp);
    const expStatus = Number.isFinite(expiration)
      ? expiration <= now ? `Expired at ${new Date(expiration * 1000).toISOString()}` : `Expires at ${new Date(expiration * 1000).toISOString()}`
      : 'No numeric exp claim';
    return `Header:\n${JSON.stringify(header, null, 2)}\n\nPayload:\n${JSON.stringify(payload, null, 2)}\n\nStandard claims:\n${claimLines.length ? claimLines.join('\n') : 'None found'}\n\nExpiration: ${expStatus}\n\nSecurity note: Payload is decoded, not signature-verified. This does not establish token authenticity.`;
  }

  function generateSeoMeta(options = {}) {
    const clean = value => String(value ?? '').trim();
    const escape = value => clean(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const title = escape(options.title);
    const description = escape(options.description);
    const url = clean(options.url);
    if (!title) throw new Error('Enter a page title.');
    if (!description) throw new Error('Enter a meta description.');
    let canonical = '';
    if (url) {
      try {
        const parsed = new URL(url);
        if (!['http:', 'https:'].includes(parsed.protocol)) throw new Error();
        canonical = parsed.href;
      } catch { throw new Error('Enter a valid http or https canonical URL.'); }
    }
    const image = clean(options.image);
    const lines = [`<title>${title}</title>`, `<meta name="description" content="${description}">`];
    if (canonical) lines.push(`<link rel="canonical" href="${escape(canonical)}">`);
    lines.push(`<meta property="og:title" content="${title}">`, `<meta property="og:description" content="${description}">`, '<meta property="og:type" content="website">');
    if (canonical) lines.push(`<meta property="og:url" content="${escape(canonical)}">`);
    if (image) lines.push(`<meta property="og:image" content="${escape(image)}">`);
    return lines.join('\n');
  }

  function validateRobotsTxt(text) {
    if (!text.trim()) throw new Error('Paste robots.txt content first.');
    const issues = [], groups = [];
    let current = null;
    const lines = text.split(/\r\n|\r|\n/);
    lines.forEach((line, index) => {
      const content = line.replace(/#.*$/, '').trim();
      if (!content) return;
      const colon = content.indexOf(':');
      if (colon < 1) { issues.push(`Line ${index + 1}: expected a directive in name: value form.`); return; }
      const name = content.slice(0, colon).trim().toLowerCase();
      const value = content.slice(colon + 1).trim();
      if (name === 'user-agent') {
        if (!value) { issues.push(`Line ${index + 1}: User-agent needs a value.`); current = null; return; }
        current = { agents: [value.toLowerCase()], directives: 0 };
        groups.push(current);
        return;
      }
      if (name === 'sitemap') {
        try { if (!/^https?:\/\//i.test(value) || !new URL(value)) throw new Error(); }
        catch { issues.push(`Line ${index + 1}: Sitemap should be an absolute http(s) URL.`); }
        return;
      }
      if (['allow', 'disallow', 'crawl-delay', 'clean-param', 'host'].includes(name)) {
        if (!current) { issues.push(`Line ${index + 1}: ${name} appears before a User-agent group.`); return; }
        current.directives++;
        if (['allow', 'disallow'].includes(name) && !value) issues.push(`Line ${index + 1}: ${name} has an empty path; use / if you mean the whole site.`);
        if (name === 'crawl-delay' && (!/^\d+(?:\.\d+)?$/.test(value))) issues.push(`Line ${index + 1}: Crawl-delay should be a non-negative number.`);
        return;
      }
      issues.push(`Line ${index + 1}: unknown directive “${name}”.`);
    });
    if (!groups.length) issues.push('No User-agent group was found.');
    return `Robots.txt syntax check (offline only)\nGroups: ${groups.length}\n\n${issues.length ? `Findings:\n${issues.map(issue => `- ${issue}`).join('\n')}` : 'No obvious syntax issues found.'}\n\nThis check does not fetch URLs, determine crawler access in production, or guarantee indexing.`;
  }

  function validateSitemapXml(text) {
    if (!text.trim()) throw new Error('Paste sitemap XML first.');
    if (text.length > 2_000_000) throw new Error('Sitemap input is limited to 2 MB.');
    const doc = new DOMParser().parseFromString(text, 'application/xml');
    if (doc.querySelector('parsererror')) throw new Error('Invalid XML. Check the markup and try again.');
    const root = doc.documentElement;
    if (!root || root.localName !== 'urlset' || root.namespaceURI !== 'http://www.sitemaps.org/schemas/sitemap/0.9') throw new Error('Expected a Sitemap protocol <urlset> root element.');
    const entries = [...root.children].filter(node => node.localName === 'url');
    if (!entries.length) throw new Error('No <url> entries were found.');
    const issues = [], seen = new Set();
    entries.forEach((entry, index) => {
      const loc = entry.getElementsByTagNameNS('*', 'loc')[0]?.textContent?.trim();
      if (!loc) { issues.push(`URL entry ${index + 1}: missing <loc>.`); return; }
      try {
        const parsed = new URL(loc);
        if (!['http:', 'https:'].includes(parsed.protocol)) throw new Error();
        if (parsed.hash) issues.push(`URL entry ${index + 1}: fragment identifiers are not appropriate in sitemap URLs.`);
      } catch { issues.push(`URL entry ${index + 1}: <loc> must be an absolute http(s) URL.`); }
      if (seen.has(loc)) issues.push(`URL entry ${index + 1}: duplicate URL ${loc}`);
      seen.add(loc);
      const lastmod = entry.getElementsByTagNameNS('*', 'lastmod')[0]?.textContent?.trim();
      if (lastmod && Number.isNaN(Date.parse(lastmod))) issues.push(`URL entry ${index + 1}: invalid lastmod date.`);
    });
    return `Sitemap XML syntax check (offline only)\nURLs checked: ${entries.length}\n\n${issues.length ? `Findings:\n${issues.map(issue => `- ${issue}`).join('\n')}` : 'No obvious XML or URL issues found.'}\n\nA valid sitemap does not indicate that URLs are accessible, canonical, submitted, or indexed.`;
  }

  function checkPromptSecurity(text) {
    if (!text.trim()) throw new Error('Paste prompt text to scan.');
    if (text.length > 200_000) throw new Error('Prompt input is limited to 200,000 characters.');
    const findings = [];
    const checks = [
      ['Instruction override wording', /\b(ignore|disregard|override|bypass)\b.{0,80}\b(previous|prior|system|developer|safety|instructions?)\b/ig],
      ['Role or policy override wording', /\b(you are now|act as|new system prompt|reveal|print|show)\b.{0,80}\b(system prompt|hidden instructions|secrets?|credentials?)\b/ig],
      ['Secret or key disclosure request', /\b(exfiltrate|leak|send|post|transmit|expose)\b.{0,80}\b(api keys?|tokens?|passwords?|secrets?|credentials?)\b/ig],
      ['Possible API key pattern', /\b(?:sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}|gh[pousr]_[A-Za-z0-9]{20,})\b/g]
    ];
    for (const [label, pattern] of checks) {
      pattern.lastIndex = 0;
      for (const match of text.matchAll(pattern)) {
        const start = Math.max(0, match.index - 36), end = Math.min(text.length, match.index + match[0].length + 50);
        const excerpt = text.slice(start, end).replace(/[\r\n]+/g, ' ');
        findings.push(`${label} near character ${match.index + 1}: “…${excerpt}…”`);
        if (findings.length >= 50) break;
      }
    }
    return `Prompt security heuristic scan\nFindings: ${findings.length}\n\n${findings.length ? findings.map((finding, index) => `${index + 1}. ${finding}`).join('\n') : 'No configured suspicious patterns detected.'}\n\nThis local heuristic may produce false positives and miss attacks. It is not a complete security review.`;
  }

  const TYPE_RESERVED = new Set(['string','number','boolean','any','unknown','never','object','function','new','delete','default','class','const','let','var','return','export','import','interface','type','enum','extends','implements','private','public','readonly','static','null','undefined','this','true','false']);
  const safeTypeName = (name, fallback = 'Root') => {
    const words = String(name || '').match(/[A-Za-z0-9_$]+/g) || [];
    let result = words.map(word => word[0]?.toUpperCase() + word.slice(1)).join('') || fallback;
    if (/^\d/.test(result)) result = `_${result}`;
    return result;
  };
  function generateTsZod(text, { rootName = 'Root', optional = false } = {}) {
    if (!text.trim()) throw new Error('Paste a JSON sample first.');
    if (text.length > 1_000_000) throw new Error('JSON sample is limited to 1 MB.');
    let sample;
    try { sample = JSON.parse(text); }
