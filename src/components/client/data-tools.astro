  function parseSqlInserts(text) {
    if (!text.trim()) throw new Error('Paste one or more SQL INSERT statements.');
    const statements = text.split(/;\s*(?:\r?\n|$)/).map(statement => statement.trim()).filter(Boolean);
    const records = [];
    for (const statement of statements) {
      const match = /^INSERT\s+INTO\s+[`"\[]?([\w.]+)[`"\]]?\s*(?:\(([^)]*)\))?\s*VALUES\s*([\s\S]+)$/i.exec(statement);
      if (!match) throw new Error('Only standard INSERT INTO … [(columns)] VALUES (…) statements are supported.');
      const columns = match[2] ? match[2].split(',').map(column => column.trim().replace(/^[`"\[]|[`"\]]$/g, '')) : null;
      const tuples = [];
      const source = match[3];
      let index = 0;
      while (index < source.length) {
        while (/[\s,]/.test(source[index] || '')) index++;
        if (index >= source.length) break;
        if (source[index] !== '(') throw new Error('Could not parse a VALUES row in the INSERT statement.');
        index++;
        const values = [];
        let token = '', quoted = false, depth = 0;
        while (index < source.length) {
          const character = source[index++];
          if (quoted) {
            if (character === "'" && source[index] === "'") { token += "'"; index++; }
            else if (character === "'") quoted = false;
            else if (character === '\\' && index < source.length) token += source[index++];
            else token += character;
          } else if (character === "'") quoted = true;
          else if (character === '(') { depth++; token += character; }
          else if (character === ')' && depth) { depth--; token += character; }
          else if ((character === ',' || character === ')') && depth === 0) {
            values.push(parseSqlValue(token.trim())); token = '';
            if (character === ')') break;
          } else token += character;
        }
        if (quoted) throw new Error('Unclosed SQL string literal.');
        if (columns && columns.length !== values.length) throw new Error('The number of values does not match the column list.');
        const names = columns || values.map((_, i) => `column${i + 1}`);
      records.push({ ...Object.fromEntries(names.map((name, i) => [name, values[i]])) });
        tuples.push(values);
      }
      if (!tuples.length) throw new Error('No VALUES rows were found in an INSERT statement.');
    }
    return records;
  }

  function parseSqlValue(value) {
    if (/^null$/i.test(value)) return null;
    if (/^(true|false)$/i.test(value)) return value.toLowerCase() === 'true';
    if (/^[+-]?(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?$/i.test(value)) return Number(value);
