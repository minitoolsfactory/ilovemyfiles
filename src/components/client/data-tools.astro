  }

  function chmodDetails(value) {
    const input = String(value).trim().replace(/^0/, '');
    if (!/^[0-7]{3,4}$/.test(input)) throw new Error('Enter a three- or four-digit octal permission such as 755 or 0644.');
    const digits = input.slice(-3).split('').map(Number);
    const symbolic = digits.map(digit => `${digit & 4 ? 'r' : '-'}${digit & 2 ? 'w' : '-'}${digit & 1 ? 'x' : '-'}`).join('');
