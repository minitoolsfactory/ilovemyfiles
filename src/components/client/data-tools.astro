      while ((match = expression.exec(text)) && iterations++ < 1000) {
        matches.push({ match: match[0], index: match.index, groups: [...match].slice(1) });
        if (!match[0].length) expression.lastIndex++;
      }
      if (iterations >= 1000) throw new Error('Stopped after 1,000 matches.');
