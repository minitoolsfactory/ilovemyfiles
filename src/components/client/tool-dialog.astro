      headingRow.append(heading);
    });
    head.append(headingRow);
    table.append(head);
    const tbody = document.createElement('tbody');
    info.items.forEach(item => {
      const tr = document.createElement('tr');
      const prop = document.createElement('td');
      prop.className = 'meta-prop';
      prop.textContent = item.label;
      if (item.custom) {
        const badge = document.createElement('span');
        badge.className = 'meta-badge'; badge.textContent = 'CUSTOM';
        prop.append(badge);
      }
      const val = document.createElement('td');
      if (item.set) { val.className = 'meta-value'; val.textContent = item.value; }
      else { val.className = 'meta-notset'; val.textContent = 'Not set'; }
      const act = document.createElement('td');
      if (item.removable && item.set) {
        const label = document.createElement('label');
        label.className = 'meta-check';
        const box = document.createElement('input');
        box.type = 'checkbox'; box.dataset.metaId = item.id;
        if (item.group === 'info') box.dataset.key = item.key;
        box.setAttribute('aria-label', `Remove ${item.label}`);
        box.title = `Remove ${item.label}`;
        label.append(box);
        act.append(label);
      } else {
        const muted = document.createElement('span');
        muted.className = 'meta-muted';
        muted.textContent = item.removable ? 'Not set' : 'Info only';
        act.append(muted);
      }
      tr.append(prop, val, act);
      tbody.append(tr);
    });
    table.append(tbody);
    scroll.append(table);
    panel.append(scroll);
  
    if (info.xmp.present) {
      const details = document.createElement('details');
      details.className = 'meta-adv';
      const summary = document.createElement('summary');
      summary.textContent = 'View raw XMP metadata';
      const pre = document.createElement('pre');
      pre.textContent = info.xmp.raw || '(empty)';
      details.append(summary, pre);
      panel.append(details);
    }
  
    selectAll.addEventListener('click', () => {
      panel.querySelectorAll('[data-meta-id]:not(:disabled)').forEach(box => { box.checked = true; });
      updateMetadataSelection();
    });
    clearAll.addEventListener('click', () => {
      panel.querySelectorAll('[data-meta-id]').forEach(box => { box.checked = false; });
      updateMetadataSelection();
    });
    updateMetadataSelection();
  }
  
  function updateMetadataSelection() {
    const panel = $('#metadata-panel');
    if (!panel) return;
    const boxes = [...panel.querySelectorAll('[data-meta-id]')];
    const checked = boxes.filter(box => box.checked).length;
    const count = panel.querySelector('.meta-count');
    if (count) count.textContent = `${checked} of ${boxes.length} selected`;
    if (activeTool === 'pdf-remove-metadata' && !busy) runButton.disabled = checked === 0;
  }
  
  function metadataSelection() {
    const keys = [];
    let removeXmp = false;
    let removeLang = false;
    const panel = $('#metadata-panel');
    panel?.querySelectorAll('[data-meta-id]:checked').forEach(box => {
      if (box.dataset.key) keys.push(box.dataset.key);
      else if (box.dataset.metaId === 'xmp') removeXmp = true;
      else if (box.dataset.metaId === 'lang') removeLang = true;
    });
    return { keys, removeXmp, removeLang };
  }
  
  function askConfirm(labels, fileName) {
    if (!confirmDialog) return Promise.resolve(true);
    confirmBody.replaceChildren();
    const message = document.createElement('p');
    message.className = 'meta-note';
    message.textContent = `You are about to remove ${labels.length} propert${labels.length === 1 ? 'y' : 'ies'} from “${fileName}”.`;
    const list = document.createElement('ul');
    list.className = 'meta-list';
    labels.forEach(text => { const li = document.createElement('li'); li.textContent = text; list.append(li); });
    confirmBody.append(message, list);
    return new Promise(resolve => {
      let settled = false;
      const finish = value => {
        if (settled) return;
        settled = true;
        confirmOk.removeEventListener('click', onOk);
        confirmCancel.removeEventListener('click', onCancel);
        confirmClose.removeEventListener('click', onCancel);
        confirmDialog.removeEventListener('close', onClose);
        if (confirmDialog.open) confirmDialog.close();
        resolve(value);
      };
      const onOk = () => finish(true);
      const onCancel = () => finish(false);
      const onClose = () => finish(false);
      confirmOk.addEventListener('click', onOk);
      confirmCancel.addEventListener('click', onCancel);
      confirmClose.addEventListener('click', onCancel);
      confirmDialog.addEventListener('close', onClose);
      confirmDialog.showModal();
    });
  }
  
  async function runMetadataTool() {
    if (!metadataInspection) return;
    const selection = metadataSelection();
    if (!selection.keys.length && !selection.removeXmp && !selection.removeLang) {
      showStatus('Select at least one property to remove.', 'error');
      return;
    }
    const labels = [];
    metadataInspection.items.forEach(item => {
      if (!item.set) return;
      if (item.id === 'xmp' && selection.removeXmp) labels.push('XMP metadata stream');
      else if (item.id === 'lang' && selection.removeLang) labels.push('Document language');
      else if (item.group === 'info' && selection.keys.includes(item.key)) labels.push(item.label);
    });
    if (!(await askConfirm(labels, files[0].name))) return;
    setBusy(true); status.hidden = true; results.hidden = true; results.replaceChildren();
    progressWrap.hidden = false; setProgress({ percent: 0, label: 'Preparing…' });
    try {
      const output = await removePdfMetadata(files[0], { ...selection, before: metadataInspection }, setProgress);
      setProgress({ percent: 100, label: 'Done' });
      renderMetadataResults(output);
      showStatus(output.partial ? 'Finished with warnings. Review the before/after table below.' : 'Finished. Your cleaned PDF is ready to download.', output.partial ? 'info' : 'success');
      revealResults();
    } catch (error) {
      showStatus(error?.message || 'Could not remove metadata.', 'error');
    } finally { setBusy(false); }
  }
  
  function renderMetadataResults(output) {
    results.replaceChildren(); results.hidden = false;
    const row = document.createElement('div'); row.className = 'result-row';
    const icon = document.createElement('span'); icon.className = 'result-check'; icon.textContent = '✓';
    const info = document.createElement('span'); info.className = 'result-info';
    const name = document.createElement('b'); name.textContent = output.name;
    const meta = document.createElement('small'); meta.textContent = output.details || formatBytes(output.blob.size);
    info.append(name, meta);
    const preview = document.createElement('button');
    preview.type = 'button'; preview.className = 'button button-small preview-button'; preview.textContent = 'Preview';
    preview.addEventListener('click', () => openPreview({ name: output.name, blob: output.blob }));
    const download = document.createElement('button');
    download.type = 'button'; download.className = 'button button-small'; download.textContent = 'Download';
    download.addEventListener('click', () => downloadBlob(output.blob, output.name));
    const actions = document.createElement('span'); actions.className = 'result-actions';
    actions.append(preview, download);
    row.append(icon, info, actions);
    results.append(row);
  
    const pillLabels = { removed: 'Removed', remaining: 'Still present', untouched: 'Kept', 'was-empty': 'Was empty', info: 'Info' };
    const scroll = document.createElement('div'); scroll.className = 'compare-scroll';
    const table = document.createElement('table'); table.className = 'meta-table';
    const head = document.createElement('thead');
    const headingRow = document.createElement('tr');
    ['Property', 'Before', 'After', 'Result'].forEach(text => {
      const heading = document.createElement('th');
      heading.scope = 'col';
      heading.textContent = text;
      headingRow.append(heading);
    });
    head.append(headingRow);
    table.append(head);
    const tbody = document.createElement('tbody');
    output.comparison.forEach(item => {
      const tr = document.createElement('tr');
      const prop = document.createElement('td'); prop.className = 'meta-prop'; prop.textContent = item.label;
      const before = document.createElement('td');
      before.className = item.before === 'Not set' ? 'meta-notset' : 'meta-value';
      before.textContent = item.before;
      const after = document.createElement('td');
      after.className = item.after === 'Not set' ? 'meta-notset' : 'meta-value';
      after.textContent = item.after;
      const result = document.createElement('td');
      const pill = document.createElement('span');
      pill.className = `result-pill ${item.result}`;
      pill.textContent = pillLabels[item.result] || item.result;
      result.append(pill);
      tr.append(prop, before, after, result);
      tbody.append(tr);
    });
    table.append(tbody); scroll.append(table);
    results.append(scroll);
  
    const again = document.createElement('button');
    again.type = 'button'; again.className = 'button button-small button-full'; again.textContent = 'Process another PDF';
    again.addEventListener('click', () => {
      files = []; metadataInspection = null;
      results.replaceChildren(); results.hidden = true;
      renderSelected(); runButton.disabled = true;
      setRunButtonLabel('Choose files to start →');
      inspectMetadataForFiles();
    });
    results.append(again);
  }
  
  function setProgress({ percent, label }) {
    progressWrap.hidden = false;
    progressBar.style.width = `${Math.max(0, Math.min(100, percent))}%`;
    progressPercent.textContent = `${percent}%`;
    progressLabel.textContent = label || 'Processing files…';
  }
  
  function setBusy(value) {
    busy = value; runButton.disabled = value || !canRun(); closeButton.disabled = value;
    const idle = textTools.has(activeTool) ? 'Run tool →' : 'Process files →';
    setRunButtonLabel(value ? 'Working…' : idle);
