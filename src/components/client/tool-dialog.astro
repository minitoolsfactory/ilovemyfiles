  function imagePreviewCacheKey(file) {
    let id = imagePreviewIds.get(file);
    if (!id) { id = ++nextImagePreviewId; imagePreviewIds.set(file, id); }
    const panel = optionPanels.find(item => item.dataset.toolOptions === activeTool);
    const values = [...(panel?.querySelectorAll('input, select, textarea') || [])]
      .map(control => [control.id, control.value, control.checked]);
    const activeButtons = [...(panel?.querySelectorAll('button.active, button[aria-pressed="true"]') || [])]
      .map(button => [button.dataset.ext || '', button.textContent.trim()]);
    const transform = activeTool === 'image-rotate' ? transformFor(file) : null;
    return `${id}:${activeTool}:${JSON.stringify([values, activeButtons, transform])}`;
  }

  function getCachedImagePreview(key) {
    const cached = imagePreviewCache.get(key);
    if (!cached) return null;
    imagePreviewCache.delete(key);
    imagePreviewCache.set(key, cached);
    return cached;
  }

  function cacheImagePreview(key, result) {
    if (!result?.blob || result.blob.size > 8 * 1024 * 1024) return;
    imagePreviewCache.delete(key);
    imagePreviewCache.set(key, { blob: result.blob, details: result.details });
    while (imagePreviewCache.size > 6) imagePreviewCache.delete(imagePreviewCache.keys().next().value);
  }
  
  async function applyToolPreview(file) {
    const ws = workspace;
    if (!ws) return;
    previewSeq++;
    ws.setRenderer(null); ws.setDecorator(null); ws.setRotation(null); ws.setHighlight(null); ws.setOrderLabels(null); ws.setSizeOverride(null);
    ws.setModeLabel(''); ws.setNote('');
    if (ws.kind === 'image') {
      if (activeTool === 'ocr') { ws.clearImageProcessed(); ws.setNote('OCR will read the text from this image. The picture itself is unchanged.'); return; }
      if (imagePreviewTools.has(activeTool)) { await previewImageTool(file); return; }
      if (activeTool === 'images-pdf') {
        ws.setModeLabel(`${files.length} image${files.length === 1 ? '' : 's'}`);
        ws.setNote(`${files.length} image(s) will be combined into one PDF in the order shown.`);
        await previewImagesPdf(file);
