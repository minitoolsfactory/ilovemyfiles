  async function runTextTool() {
    setBusy(true); status.hidden = true; utilityResults.hidden = true;
    try {
      const result = (activeTool === 'data-hash' && files.length)
        ? await (async () => {
            const algorithm = $('#hash-algorithm').value;
            const output = await hashFiles(files, algorithm);
            return { output, filename: `${algorithm.toLowerCase()}-hashes.txt`, message: `${files.length} file${files.length === 1 ? '' : 's'} hashed with ${algorithm}.` };
          })()
        : await TEXT_HANDLERS[activeTool](utilityInput.value);
      if (utilityUrl) { URL.revokeObjectURL(utilityUrl); utilityUrl = null; }
