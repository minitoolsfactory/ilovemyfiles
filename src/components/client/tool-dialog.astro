  async function previewPdfCompress(file) {
    const ws = workspace;
    const level = compressLevel();
    const preset = COMPRESSION_LEVELS[level] || COMPRESSION_LEVELS.recommended;
    const { renderPageToBlob } = await Promise.resolve(window.iLoveMyFilesModules['pdf-render']);
    const seq = ++previewSeq;
    ws.setRenderer(async page => {
      const { blob } = await renderPageToBlob(page, preset.dpi / 72, 'image/jpeg', preset.quality);
      return { blob };
    });
    ws.setModeLabel(`Estimated preview · ${level}`);
    ws.setNote(`Pages are re-rendered at ${preset.dpi} DPI with ${Math.round(preset.quality * 100)}% JPEG quality. The final file size may differ.`);
    ws.refresh();
    clearTimeout(estimateTimer);
    estimateTimer = setTimeout(() => estimateCompressedSize(file, preset, seq), 320);
  }
  
  async function estimateCompressedSize(file, preset, seq) {
    const ws = workspace;
    if (!ws?.doc) return;
    try {
      const total = ws.pageCount;
      const page = await ws.doc.getPage(1);
      const { renderPageToBlob } = await Promise.resolve(window.iLoveMyFilesModules['pdf-render']);
      const { blob } = await renderPageToBlob(page, preset.dpi / 72, 'image/jpeg', preset.quality);
      if (seq !== previewSeq) return;
      const estimate = blob.size * total;
      const saved = file.size ? Math.round((1 - estimate / file.size) * 100) : 0;
      const savedText = saved > 0 ? ` · about ${saved}% smaller` : '';
      ws.setNote(`Estimated output ≈ ${formatBytes(estimate)} for ${total} page(s)${savedText}. Only pages you view are re-rendered, so the real file may differ.`);
    }
    catch { /* estimate is best-effort */ }
  }
  
  function previewPdfRotate() {
    const ws = workspace;
    const rotations = transformFor(files[0]).pageRotations || {};
    const changedPages = Object.keys(rotations).filter(page => normalizeAngle(rotations[page]) !== 0);
    ws.setRotation(pageNumber => normalizeAngle(rotations[pageNumber] || 0));
    ws.setModeLabel(changedPages.length ? `Rotating ${changedPages.length} page${changedPages.length === 1 ? '' : 's'}` : '');
    ws.setNote(changedPages.length
      ? `Preview shows individual rotations for ${changedPages.length} page${changedPages.length === 1 ? '' : 's'}. Select a page to view or change its rotation.`
      : 'Select a page in the preview, then choose a rotation. Each page is rotated independently.');
    ws.rerender();
  }
  
  function previewPdfResize() {
    const ws = workspace;
    const sizeKey = $('#resize-page-size').value;
    const dims = PDF_PAGE_SIZES[sizeKey];
    if (!dims) return;
    const orientation = $('#resize-orientation').value;
    const margin = Math.max(0, Math.min(200, Number($('#resize-margin').value) || 0));
    const input = $('#resize-pages').value.trim();
    let set = null;
    if (input) { try { set = new Set(parsePageSelection(input, ws.pageCount).map(index => index + 1)); } catch { set = null; } }
    ws.setSizeOverride((num, src) => {
      if (set && !set.has(num)) return null;
      let [width, height] = dims;
      const landscape = orientation === 'landscape' || (orientation === 'auto' && src.width > src.height);
      if (landscape) [width, height] = [height, width];
      return { width, height, inset: margin };
    });
    const label = sizeKey.toUpperCase();
    const scope = input || 'all pages';
    ws.setModeLabel(`${label} · ${orientation === 'auto' ? 'match' : orientation}`);
    ws.setNote(`Pages (${scope}) are scaled to fit ${label}${orientation === 'auto' ? ' matched to each page' : ` ${orientation}`}${margin > 0 ? ` with a ${margin}pt margin` : ''}.`);
    ws.reflow();
  }
  
  function previewPdfDelete() {
    const ws = workspace;
    const input = $('#delete-pages').value.trim();
    let set = new Set();
    if (input) { try { set = new Set(parsePageSelection(input, ws.pageCount).map(index => index + 1)); } catch { /* ignore */ } }
    ws.setHighlight(pageNumber => set.has(pageNumber));
    ws.setModeLabel(set.size ? `${set.size} page(s) to remove` : 'No pages selected');
    ws.setNote(set.size ? 'Highlighted pages will be removed. Click a page in the preview to toggle its selection, or edit the page numbers below.' : 'Click pages in the preview to select them for deletion, or enter page numbers below (for example 2, 5-7).');
    ws.decorate();
  }
  
  function previewPdfOrganize() {
    const ws = workspace;
    const input = $('#organize-order');
    let order = null;
    try { order = parsePageOrder(input.value.trim(), ws.pageCount); } catch { order = null; }
    const labels = new Map();
    if (order) order.forEach((index, position) => { const page = index + 1; if (!labels.has(page)) labels.set(page, `#${position + 1}`); });
    ws.setOrderLabels(pageNumber => labels.get(pageNumber) || null);
    ws.setModeLabel(order ? `${order.length} output page(s)` : 'Waiting for order');
    ws.setNote(order ? 'Badges show each page’s position in the output. Repeated pages are duplicated; omitted pages are dropped. Drag the thumbnails below to reorder.' : 'Enter a new page order, such as 3, 1, 2, or drag the thumbnails below.');
    ws.setPageDraggable(true, pages => {
      if (!pages?.length) return;
      input.value = pages.join(', ');
      schedulePreviewUpdate();
    });
    ws.setPageRemovable(true, page => {
      const max = ws.pageCount;
      let order;
      try { order = parsePageOrder(input.value.trim(), max).map(i => i + 1); }
      catch { order = Array.from({ length: max }, (_, i) => i + 1); }
      const next = order.filter(p => p !== page);
      if (!next.length) return;
      input.value = next.join(', ');
      schedulePreviewUpdate();
    });
    ws.decorate();
  }
  
  async function previewPdfWatermark() {
    const ws = workspace;
    const text = ($('#watermark-text')?.value || '').trim();
    const size = Number($('#watermark-size')?.value) || 48;
    const opacity = Number($('#watermark-opacity')?.value) || 0.18;
    const selectedFont = $('#watermark-font')?.value || 'helvetica';
    const bold = !!$('#watermark-bold')?.checked;
    const italic = !!$('#watermark-italic')?.checked;
    const fontKey = WM_FONTS[selectedFont]?.googleFamily
      ? selectedFont
      : wmFontKey(WM_FONTS[selectedFont]?.family || selectedFont, bold, italic);
    const face = WM_FONTS[fontKey] || WM_FONTS.helvetica;
    // Registry entries only carry weight/style when they are non-default, so fall back
    // explicitly. An "undefined" here would produce an invalid font shorthand that the
    // canvas silently rejects, leaving the previous font in place.
    const weight = Number(face.weight) || (bold ? 700 : 400);
    const style = face.style || (italic ? 'italic' : 'normal');
    // A web font that cannot be fetched must not break the preview: fall back to a
    // standard face so the watermark still renders and stays editable.
    let css = face.css;
    if (face.googleFamily) {
      try {
        await loadWatermarkFont(face.googleFamily, text, weight, size, style);
      } catch {
        const fallback = WM_FONTS[wmFontKey('helvetica', bold, italic)] || WM_FONTS.helvetica;
        css = fallback.css;
      }
    }
    const underline = !!$('#watermark-underline')?.checked;
    const rgb = wmHexToRgb($('#watermark-color')?.value);
    const angle = Number($('#watermark-angle')?.value) || 45;
    const rad = (angle * Math.PI) / 180;
    _wmReadPosInputs();
    _wmRenderDial(angle);
    ws.setDecorator((context, info) => {
      if (!text) return;
      const px = size * info.scale;
      context.save();
      context.translate(wmPosition.x * info.canvas.width, wmPosition.y * info.canvas.height);
      context.rotate(-rad);
      context.font = `${style} ${weight} ${px}px ${css}`;
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      context.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${Math.min(1, opacity)})`;
      context.fillText(text, 0, 0);
      if (underline) {
        const textWidth = context.measureText(text).width;
        context.strokeStyle = context.fillStyle;
        context.lineWidth = Math.max(1, px / 18);
        context.beginPath();
        context.moveTo(-textWidth / 2, px * 0.34);
        context.lineTo(textWidth / 2, px * 0.34);
        context.stroke();
      }
      context.restore();
    });
    ws.setModeLabel('Live watermark preview');
    ws.setNote(`Drag the watermark on the page to move it, or set X and Y here. Angle: ${angle}°. Position: ${Math.round(wmPosition.x * 100)}%, ${Math.round(wmPosition.y * 100)}%. Applies to every page.`);
    _wmAttachDrag(ws);
    _wmAttachDial();
    _wmAttachPosInputs();
    if (!(ws.rendered?.size && ws.repaintDecorations?.())) ws.refresh();
  }

  function _wmReadPosInputs() {
    if (wmSyncingPos) return;
    const xEl = $('#watermark-pos-x');
    const yEl = $('#watermark-pos-y');
    if (xEl && xEl.value !== '') wmPosition.x = Math.max(0, Math.min(1, Number(xEl.value) / 100));
    if (yEl && yEl.value !== '') wmPosition.y = Math.max(0, Math.min(1, Number(yEl.value) / 100));
    _wmSyncPosInputs();
  }

  function _wmSyncPosInputs() {
    const xEl = $('#watermark-pos-x');
    const yEl = $('#watermark-pos-y');
    wmSyncingPos = true;
    if (xEl) xEl.value = Math.round(wmPosition.x * 100);
    if (yEl) yEl.value = Math.round(wmPosition.y * 100);
    wmSyncingPos = false;
  }

  function _wmAttachPosInputs() {
    if (wmPosListeners) return;
    const posHandler = () => {
      if (wmSyncingPos) return;
      _wmReadPosInputs();
      const ws = workspace;
      if (ws) {
        ws.setNote(`Drag the watermark on the page to move it, or set X and Y here. Position: ${Math.round(wmPosition.x * 100)}%, ${Math.round(wmPosition.y * 100)}%. Applies to every page.`);
      }
      _wmScheduleRefresh();
    };
    const angleHandler = () => {
      const el = $('#watermark-angle');
      if (!el) return;
      let angle = Number(el.value);
      if (!Number.isFinite(angle)) angle = 0;
      angle = Math.max(0, Math.min(360, Math.round(angle)));
      wmAngleTouched = true;
      _wmRenderDial(angle);
      const ws = workspace;
      if (ws) {
        ws.setNote(`Drag around the dial or type an angle. Angle: ${angle}°. Position: ${Math.round(wmPosition.x * 100)}%, ${Math.round(wmPosition.y * 100)}%. Applies to every page.`);
      }
      _wmScheduleRefresh();
    };
    const bind = (id, fn) => { const el = $(id); if (el) el.addEventListener('input', fn); };
    bind('#watermark-pos-x', posHandler);
    bind('#watermark-pos-y', posHandler);
    bind('#watermark-angle', angleHandler);
    const stepWrap = $('.angle-stepper');
    let stepRepeat = null;
    const stepFromEvent = event => {
      const btn = event.target.closest('.angle-step-btn');
      if (!btn) return null;
      return Number(btn.dataset.dir) || 0;
    };
    const applyStep = step => {
      const el = $('#watermark-angle');
      if (!el) return;
      let angle = Number(el.value);
      if (!Number.isFinite(angle)) angle = 0;
      angle = Math.max(0, Math.min(360, Math.round(angle + step)));
      el.value = angle;
      angleHandler();
    };
    const stepDownHandler = event => {
      const step = stepFromEvent(event);
      if (step === null) return;
      event.preventDefault();
      applyStep(step);
      clearInterval(stepRepeat);
      stepRepeat = setInterval(() => applyStep(step), 90);
    };
    const stopStep = () => { clearInterval(stepRepeat); stepRepeat = null; };
    if (stepWrap) {
      stepWrap.addEventListener('pointerdown', stepDownHandler);
      stepWrap.addEventListener('pointerup', stopStep);
      stepWrap.addEventListener('pointerleave', stopStep);
      stepWrap.addEventListener('pointercancel', stopStep);
      stepWrap.addEventListener('contextmenu', e => e.preventDefault());
    }
    wmPosListeners = { posHandler, angleHandler, stepDownHandler, stopStep };
  }

  function _wmDetachPosInputs() {
    if (!wmPosListeners) return;
    const unbind = (id, fn) => { const el = $(id); if (el) el.removeEventListener('input', fn); };
    unbind('#watermark-pos-x', wmPosListeners.posHandler);
    unbind('#watermark-pos-y', wmPosListeners.posHandler);
    unbind('#watermark-angle', wmPosListeners.angleHandler);
    const stepWrap = $('.angle-stepper');
    if (stepWrap && wmPosListeners.stepDownHandler) {
      stepWrap.removeEventListener('pointerdown', wmPosListeners.stepDownHandler);
      stepWrap.removeEventListener('pointerup', wmPosListeners.stopStep);
      stepWrap.removeEventListener('pointerleave', wmPosListeners.stopStep);
      stepWrap.removeEventListener('pointercancel', wmPosListeners.stopStep);
    }
    wmPosListeners = null;
  }

  function _wmAttachDrag(ws) {
    if (wmListeners) return;
    const down = e => {
      const cv = document.elementFromPoint(e.clientX, e.clientY)?.closest('.pv-page-canvas');
      if (!cv) return;
      wmDragActive = true;
      e.preventDefault();
      _wmApplyDrag(e);
    };
    const move = e => {
      if (!wmDragActive) return;
      e.preventDefault();
      _wmApplyDrag(e);
    };
    const up = e => {
      if (!wmDragActive) return;
      wmDragActive = false;
      _wmScheduleRefresh();
    };
    document.addEventListener('pointerdown', down, { passive: false });
    document.addEventListener('pointermove', move, { passive: false });
    document.addEventListener('pointerup', up);
    document.addEventListener('pointercancel', up);
    wmListeners = { down, move, up };
  }

  function _wmDetachDrag() {
    if (!wmListeners) return;
    document.removeEventListener('pointerdown', wmListeners.down);
    document.removeEventListener('pointermove', wmListeners.move);
    document.removeEventListener('pointerup', wmListeners.up);
    document.removeEventListener('pointercancel', wmListeners.up);
    wmListeners = null;
    wmDragActive = false;
    if (wmRefreshFrame) { cancelAnimationFrame(wmRefreshFrame); wmRefreshFrame = null; }
  }

  function _wmScheduleRefresh() {
    if (wmRefreshFrame) return;
    wmRefreshFrame = requestAnimationFrame(() => {
      wmRefreshFrame = null;
      const ws = workspace;
      if (!ws) return;
      // Style-only change: repaint the decoration on the existing canvases so the
      // document does not visibly reload. Fall back to a full refresh when nothing
      // has been painted yet.
      if (ws.rendered?.size && ws.repaintDecorations?.()) return;
      ws.refresh();
    });
  }

  function _wmApplyDrag(e) {
    const cv = document.elementFromPoint(e.clientX, e.clientY)?.closest('.pv-page-canvas');
    if (!cv) return;
    const r = cv.getBoundingClientRect();
    if (r.width <= 0 || r.height <= 0) return;
    let fx = (e.clientX - r.left) / r.width;
    let fy = (e.clientY - r.top) / r.height;
    fx = Math.max(0, Math.min(1, fx));
    fy = Math.max(0, Math.min(1, fy));
    wmPosition.x = fx;
    wmPosition.y = fy;
    _wmSyncPosInputs();
    const ws = workspace;
    if (ws) {
      ws.setNote(`Drag the watermark on the page to move it, or set X and Y here. Position: ${Math.round(fx * 100)}%, ${Math.round(fy * 100)}%. Applies to every page.`);
    }
    _wmScheduleRefresh();
  }

  // Font metadata comes from the shared registry so every tool uses one source of truth.
  const WM_FONTS = Object.fromEntries(
    registry.ALL_FONTS.map(font => [font.id, font])
  );


  function wmHexToRgb(value) {
    const match = /^#?([0-9a-f]{6})$/i.exec(String(value || '').trim());
    if (!match) return { r: 89, g: 90, b: 115 };
    const n = parseInt(match[1], 16);
    return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
  }

  function wmFontKey(family, bold, italic) {
    if (family === 'times') return italic ? (bold ? 'times-bold-italic' : 'times-italic') : (bold ? 'times-bold' : 'times');
    if (family === 'courier') return italic ? (bold ? 'courier-bold-oblique' : 'courier-oblique') : (bold ? 'courier-bold' : 'courier');
    return italic ? (bold ? 'helvetica-bold-oblique' : 'helvetica-oblique') : (bold ? 'helvetica-bold' : 'helvetica');
  }

  function _wmArcPath(angle, cx = 50, cy = 50, r = 40) {
    const a = ((angle % 360) + 360) % 360;
    if (a <= 0) return '';
    const rad = (a * Math.PI) / 180;
    const endX = cx + r * Math.sin(rad);
    const endY = cy - r * Math.cos(rad);
    const large = a > 180 ? 1 : 0;
    return `M ${cx} ${cy - r} A ${r} ${r} 0 ${large} 1 ${endX.toFixed(1)} ${endY.toFixed(1)}`;
  }

  function _wmHandlePos(angle, cx = 50, cy = 50, r = 40) {
    const a = ((angle % 360) + 360) % 360;
    const rad = (a * Math.PI) / 180;
    return { x: cx + r * Math.sin(rad), y: cy - r * Math.cos(rad) };
  }

  function _wmRenderDial(angle) {
    const progress = $('#watermark-angle-progress');
    const handle = $('#watermark-angle-handle');
    const input = $('#watermark-angle');
    if (progress) progress.setAttribute('d', _wmArcPath(angle));
    const pos = _wmHandlePos(angle);
    if (handle) { handle.setAttribute('cx', pos.x.toFixed(1)); handle.setAttribute('cy', pos.y.toFixed(1)); }
    if (input && document.activeElement !== input) input.value = Math.round(angle);
  }

  function _wmAttachDial() {
    const dial = $('#watermark-angle-dial');
    if (!dial || wmDialListeners) return;
    const down = e => {
      wmDialDragging = true;
      e.preventDefault();
      _wmSetDialAngle(e.clientX, e.clientY);
    };
    const move = e => {
      if (!wmDialDragging) return;
      e.preventDefault();
      _wmSetDialAngle(e.clientX, e.clientY);
    };
    const up = () => { wmDialDragging = false; };
    dial.addEventListener('pointerdown', down, { passive: false });
    dial.addEventListener('pointermove', move, { passive: false });
    document.addEventListener('pointerup', up);
    document.addEventListener('pointercancel', up);
    wmDialListeners = { down, move, up };
  }

  function _wmDetachDial() {
    if (!wmDialListeners) return;
    const dial = $('#watermark-angle-dial');
    if (dial) { dial.removeEventListener('pointerdown', wmDialListeners.down); dial.removeEventListener('pointermove', wmDialListeners.move); }
    document.removeEventListener('pointerup', wmDialListeners.up);
    document.removeEventListener('pointercancel', wmDialListeners.up);
    wmDialListeners = null;
    wmDialDragging = false;
  }

  function _wmSetDialAngle(mx, my) {
    const svg = $('#watermark-angle-dial svg');
    if (!svg) return;
    const rct = svg.getBoundingClientRect();
    const cx = rct.left + rct.width / 2;
    const cy = rct.top + rct.height / 2;
    const dx = mx - cx;
    const dy = my - cy;
    const dist = Math.hypot(dx, dy);
    const outer = rct.width / 2 * 1.08;
    const inner = rct.width / 2 * 0.62;
    if (dist > outer) return;
    if (dist < inner) return;
    let angle = ((Math.atan2(dy, dx) + Math.PI / 2 + 2 * Math.PI) % (2 * Math.PI)) * 180 / Math.PI;
    angle = Math.round(angle);
    if (angle === 360) angle = 0;
    wmAngleTouched = true;
    const input = $('#watermark-angle');
    if (input) input.value = angle;
    _wmRenderDial(angle);
    const ws = workspace;
    if (ws) {
      ws.setNote(`Drag around the dial or type an angle. Angle: ${angle}°. Position: ${Math.round(wmPosition.x * 100)}%, ${Math.round(wmPosition.y * 100)}%. Applies to every page.`);
    }
    _wmScheduleRefresh();
  }

  async function previewPdfNumbers() {
