  const progressBar = $('#progress-bar');
  const progressPercent = $('#progress-percent');
  const progressLabel = $('#progress-label');
  const closeButton = $('#close-dialog');
  const previewDialog = $('#preview-dialog');
  const previewTitle = $('#preview-title');
  const previewStage = $('#preview-stage');
  const previewClose = $('#preview-close');
  const confirmDialog = $('#confirm-dialog');
  const confirmBody = $('#confirm-body');
  const confirmOk = $('#confirm-ok');
  const confirmCancel = $('#confirm-cancel');
  const confirmClose = $('#confirm-close');
  const textWorkspace = $('#text-workspace');
  const utilityInput = $('#utility-input');
  const utilityResults = $('#utility-results');
  const utilityOutput = $('#utility-output');
  const utilityImage = $('#utility-image');
  const utilityCopy = $('#utility-copy');
  const utilityDownload = $('#utility-download');
  let activeTool = null;
  let files = [];
  let imagePdfDefaultSettings = { pageSize: 'fit', orientation: 'portrait' };
  let imagePdfSettings = new Map();
  let busy = false;
  let dragIndex = null;
  let lastTrigger = null;
  let previewUrl = null;
  let selectedUrls = new Map();
  let cropEditor = null;
  let mergeBoard = null;
  let toolConfig = null;
  let utilityUrl = null;
  let utilityBlob = null;
  const previewHost = $('#preview-workspace');
  const cropWorkspace = $('#crop-workspace');
  const mergeHost = $('#merge-workspace');
  const stage = $('#tool-dialog .wb-stage');
  let workspace = null;
  let workspaceKey = null;
  let previewTimer = null;
  let previewSeq = 0;
  let wmPosition = { x: 0.5, y: 0.5 };
  let wmDragActive = false;
  let wmRefreshFrame = null;
  let wmListeners = null;
  let wmDialListeners = null;
  let wmDialDragging = false;
  let wmSyncingPos = false;
  let wmPosListeners = null;
  let wmAngleTouched = false;
  let estimateTimer = null;
  let previewIndex = 0;
  let rotateStore = new Map();
  const imagePreviewIds = new WeakMap();
  const imagePreviewCache = new Map();
  let nextImagePreviewId = 0;
  let metadataInspection = null;
  let metadataSeq = 0;
  let metadataTimer = null;
  
  function activateToolOptions(tool) {
    for (const panel of optionPanels) panel.hidden = panel.dataset.toolOptions !== tool;
    const panel = optionPanels.find(item => item.dataset.toolOptions === tool);
    const template = optionPanelTemplates.get(tool);
    if (panel && template) panel.replaceChildren(...template.cloneNode(true).childNodes);
    destroyFontPickers();
    if (tool === 'pdf-watermark') mountFontPicker(panel, 'watermark', 'Watermark font');
    if (tool === 'pdf-page-numbers') mountFontPicker(panel, 'numbers', 'Page-number font');
  }

  const fontPickers = new Map();

  // Pickers own a document-level listener and a rendered list; drop the ones that
  // belong to other tools so only the active panel is ever in the DOM.
  function destroyFontPickers() {
    for (const picker of fontPickers.values()) picker.destroy();
    fontPickers.clear();
  }

  // Shared by every tool that lets the user choose a typeface.
  function mountFontPicker(panel, prefix, label) {
    const host = panel?.querySelector('#' + prefix + '-font-picker');
    const target = panel?.querySelector('#' + prefix + '-font');
    if (!host || !target) return;
    const existing = fontPickers.get(prefix);
    if (existing) existing.destroy();
    fontPickers.set(prefix, createFontPicker(host, {
      value: target.value || 'helvetica',
      targetInput: '#' + prefix + '-font',
      label,
      onChange: () => schedulePreviewUpdate()
    }));
  }
  
  function activeOption(selector) {
    return optionPanels.find(panel => panel.dataset.toolOptions === activeTool)?.querySelector(selector) ?? null;
  }
  
  const previewTools = new Set([
    'pdf-compress', 'pdf-rotate-pages', 'pdf-delete-pages', 'pdf-organize', 'pdf-watermark', 'pdf-page-numbers',
    'pdf-to-images', 'pdf-remove-metadata', 'pdf-split', 'pdf-merge', 'pdf-ocr', 'pdf-flatten', 'ocr', 'pdf-resize-pages',
    'image-convert', 'image-resize', 'image-compress', 'image-rotate', 'image-watermark', 'images-pdf'
  ]);
  const selectableInputs = { 'pdf-delete-pages': 'delete-pages', 'pdf-to-images': 'pti-pages', 'pdf-resize-pages': 'resize-pages' };
  const imagePreviewTools = new Set(['image-convert', 'image-resize', 'image-compress', 'image-rotate', 'image-watermark']);
  
  const imageTools = new Set(['image-convert', 'image-compress', 'image-resize', 'image-rotate', 'image-watermark', 'images-pdf']);
  const rotateTools = new Set(['image-rotate', 'pdf-rotate-pages']);
  const singleFileTools = new Set(['image-crop', 'pdf-delete-pages', 'pdf-rotate-pages', 'pdf-page-numbers', 'pdf-watermark', 'pdf-remove-metadata', 'pdf-to-images', 'pdf-organize', 'pdf-compress', 'ocr', 'pdf-ocr', 'pdf-flatten', 'pdf-resize-pages']);
  const textTools = new Set(['data-json', 'data-base64', 'data-wordcount', 'data-json-csv', 'data-units', 'qr-code', 'barcode']);
  
  const TEXT_HANDLERS = {
    'data-json': async text => ({
      output: formatJson(text, { minify: $('#json-mode').value === 'minify', indent: $('#json-indent').value }),
      filename: 'formatted.json', message: 'Valid JSON. Copy or download the result.'
    }),
    'data-base64': async text => {
      const decode = $('#base64-mode').value === 'decode';
      return { output: base64Convert(text, { mode: decode ? 'decode' : 'encode' }), filename: decode ? 'decoded.txt' : 'encoded.txt' };
    },
    'data-hash': async text => {
      const algorithm = $('#hash-algorithm').value;
      return { output: await hashText(text, algorithm), filename: `${algorithm.toLowerCase()}.txt`, message: `${algorithm} hash generated.` };
    },
    'data-wordcount': async text => ({ output: countTextReport(text), filename: 'text-stats.txt' }),
    'data-json-csv': async text => {
      const toCsv = $('#jsoncsv-mode').value === 'json-to-csv';
      return { output: toCsv ? jsonToCsv(text) : csvToJson(text), filename: toCsv ? 'data.csv' : 'data.json' };
    },
    'data-units': async text => ({ output: convertUnits(text, $('#units-category').value), filename: 'conversion.txt' }),
    'qr-code': async text => ({ image: await generateQr(text, { level: $('#qr-level').value, size: $('#qr-size').value }), message: 'QR code generated - download the PNG below.' }),
    'barcode': async text => ({ image: await generateBarcode(text, { format: $('#barcode-format').value, width: $('#barcode-width').value, height: $('#barcode-height').value }), message: 'Barcode generated - download the PNG below.' })
  };
  
  const RECENT_TOOLS_KEY = 'ilovemyfiles-recent-tools';
  const RECENT_TOOLS_LIMIT = 6;

  // Per-browser/per-user history of the most recently opened tools, newest first.
  // openTool() is the single funnel for every entry point (home cards, ?open=1 deep
  // links, the ilovemyfiles:open-tool event), so recording here means recents work no
  // matter how a tool was launched.
  function rememberRecentTool(id) {
    if (!id) return;
    try {
      const raw = JSON.parse(localStorage.getItem(RECENT_TOOLS_KEY) ?? '[]');
      const list = Array.isArray(raw) ? raw.filter(entry => typeof entry === 'string') : [];
      const next = [id, ...list.filter(entry => entry !== id)].slice(0, RECENT_TOOLS_LIMIT);
      localStorage.setItem(RECENT_TOOLS_KEY, JSON.stringify(next));
    } catch {
      // Recent history is optional when browser storage is unavailable or blocked.
    }
  }

  function openToolById(id) {
    if (toolConfig) openTool(id, toolConfig);
  }
  
  function initToolDialog(config) {
    toolConfig = config;
    closeButton.addEventListener('click', () => { if (!busy) dialog.close(); });
    dialog.addEventListener('click', event => { if (event.target === dialog && !busy) dialog.close(); });
    document.addEventListener('click', event => {
      const button = event.target.closest('[data-tool-id]');
      const id = button?.dataset.toolId;
      if (!id || !toolConfig?.[id]) return;
      event.preventDefault();
      openTool(id, toolConfig);
    });
    document.addEventListener('ilovemyfiles:open-tool', event => {
      const id = event.detail?.id;
      if (id && toolConfig?.[id]) openTool(id, toolConfig);
    });
    dropZone.addEventListener('click', () => { input.value = ''; input.click(); });
    dropZone.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); input.value = ''; input.click(); } });
    input.addEventListener('change', () => addFiles([...input.files]));
    ['dragenter', 'dragover'].forEach(type => dropZone.addEventListener(type, event => { event.preventDefault(); dropZone.classList.add('dragging'); }));
    ['dragleave', 'drop'].forEach(type => dropZone.addEventListener(type, event => { event.preventDefault(); dropZone.classList.remove('dragging'); }));
    dropZone.addEventListener('drop', event => addFiles([...event.dataTransfer.files]));
    ['dragenter', 'dragover'].forEach(type => stage.addEventListener(type, event => { event.preventDefault(); stage.classList.add('dragging-over'); }));
    ['dragleave', 'drop'].forEach(type => stage.addEventListener(type, event => { event.preventDefault(); stage.classList.remove('dragging-over'); }));
    stage.addEventListener('drop', event => addFiles([...event.dataTransfer.files]));
    runButton.addEventListener('click', runTool);
    dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
    dialog.addEventListener('close', () => { clearPreview(); mergeBoard?.destroy(); mergeBoard = null; if (!busy) lastTrigger?.focus?.(); });
    document.addEventListener('paste', handlePaste);
    previewClose.addEventListener('click', () => previewDialog.close());
    previewDialog.addEventListener('click', event => { if (event.target === previewDialog) previewDialog.close(); });
    previewDialog.addEventListener('close', closePreview);
    utilityInput.addEventListener('input', () => { if (textTools.has(activeTool) || activeTool === 'data-hash') runButton.disabled = !canRun(); });
    utilityCopy.addEventListener('click', copyUtilityOutput);
    utilityDownload.addEventListener('click', () => {
      const blob = utilityBlob || new Blob([utilityOutput.value], { type: 'text/plain' });
      downloadBlob(blob, utilityDownload.dataset.filename || 'ilovemyfiles-output.txt');
    });
    optionsBox.addEventListener('change', event => {
      if (activeTool === 'pdf-merge' && mergeBoard && (event.target.id === 'merge-page-size' || event.target.id === 'merge-orientation' || event.target.id === 'merge-margin')) {
        const patch = { size: $('#merge-page-size')?.value || 'original', orientation: $('#merge-orientation')?.value || 'auto', margin: Number($('#merge-margin')?.value) || 0 };
        if (mergeBoard.getActiveKey()) mergeBoard.setActiveSettings(patch);
        else mergeBoard.setDefaultSettings(patch);
        mergeBoard.refreshActivePreview?.();
      }
      if (activeTool === 'images-pdf' && (event.target.id === 'pdf-page-size' || event.target.id === 'pdf-page-orientation')) {
        const patch = { pageSize: $('#pdf-page-size')?.value || 'fit', orientation: $('#pdf-page-orientation')?.value || 'portrait' };
        if (files.length) {
          const file = files[previewIndex];
          const key = `${file.name}:${file.size}:${file.lastModified}`;
          imagePdfSettings.set(key, { ...(imagePdfSettings.get(key) || imagePdfDefaultSettings), ...patch });
        } else {
          imagePdfDefaultSettings = { ...imagePdfDefaultSettings, ...patch };
        }
      }
      if (event.target.matches?.('[data-meta-id]')) { updateMetadataSelection(); return; }
      if (event.target.id === 'compress-mode') {
        $('#quality-option').hidden = event.target.value !== 'quality';
        $('#target-option').hidden = event.target.value !== 'target';
      }
      if (event.target.id === 'compress-format') {
        const mode = $('#compress-mode');
        const qualityMode = mode.querySelector('option[value="quality"]');
        qualityMode.disabled = !['image/webp', 'image/jpeg'].includes(event.target.value);
        if (qualityMode.disabled && mode.value === 'quality') {
          mode.value = 'target';
          $('#quality-option').hidden = true;
          $('#target-option').hidden = false;
        }
      }
      if (event.target.id === 'split-mode') $('#split-pages-wrap').hidden = event.target.value !== 'selected';
      if (event.target.id === 'numbers-format') $('#numbers-custom-wrap').hidden = event.target.value !== 'custom';
      if (event.target.id === 'resize-width' || event.target.id === 'resize-height') updateResizeDimension(event.target.id);
      schedulePreviewUpdate();
    });
    optionsBox.addEventListener('input', event => {
      if (event.target.id === 'quality') $('#quality-value').textContent = `${event.target.value}%`;
      if (event.target.id === 'wm-opacity') $('#wm-opacity-value').textContent = `${Math.round(event.target.value * 100)}%`;
      if (event.target.id?.includes('margin')) animateValue(event.target);
      if (event.target.id === 'resize-width' || event.target.id === 'resize-height') updateResizeDimension(event.target.id);
      if (activeTool === 'pdf-merge' && mergeBoard && (event.target.id === 'merge-page-size' || event.target.id === 'merge-orientation' || event.target.id === 'merge-margin')) {
        const patch = { size: $('#merge-page-size')?.value || 'original', orientation: $('#merge-orientation')?.value || 'auto', margin: Number($('#merge-margin')?.value) || 0 };
        if (mergeBoard.getActiveKey()) mergeBoard.setActiveSettings(patch);
        else mergeBoard.setDefaultSettings(patch);
        mergeBoard.refreshActivePreview?.();
      }
      syncMarginPresets(event.target);
      schedulePreviewUpdate();
    });
    optionsBox.addEventListener('click', event => {
      const chip = event.target.closest('.format-chip');
      if (chip) {
        const group = chip.closest('.format-grid') || chip.parentElement;
        group.querySelectorAll('.format-chip').forEach(node => node.classList.toggle('active', node === chip));
        const hidden = document.querySelector('#image-format');
        if (hidden) hidden.value = chip.dataset.format;
      }
      const rotateAct = event.target.closest('[data-op]');
      if (rotateAct) {
        applyRotateOp(rotateAct.dataset.op);
        return;
      }
      const stepBtn = event.target.closest('.stepper-btn');
      if (stepBtn) {
        const input = document.getElementById(stepBtn.dataset.target);
        if (input) {
          const step = Number(stepBtn.dataset.step) || 0;
          const min = input.min !== '' ? Number(input.min) : -Infinity;
          const max = input.max !== '' ? Number(input.max) : Infinity;
          const next = Math.min(max, Math.max(min, (Number(input.value) || 0) + step));
          input.value = String(next);
          syncMarginPresets(input);
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
      const preset = event.target.closest('.margin-preset');
      if (preset) {
        const input = document.getElementById(preset.dataset.target);
        if (input) { input.value = preset.dataset.value; input.dispatchEvent(new Event('input', { bubbles: true })); }
      }
      schedulePreviewUpdate(60);
    });
  }
  
  function isPdfFile(file) {
    return file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
  }
  
  function ensureWorkspace() {
    if (!workspace) workspace = new PreviewWorkspace(previewHost);
    return workspace;
  }
  
  function compressLevel() {
    return activeOption('input[name="compress-level"]:checked')?.value || 'recommended';
  }
  
  function currentSelectionSet(tool) {
    const set = new Set();
    const inputId = selectableInputs[tool];
    if (!inputId || !workspace) return set;
    const value = $(`#${inputId}`)?.value?.trim();
    if (value) {
      try { parsePageSelection(value, workspace.pageCount).forEach(index => set.add(index + 1)); } catch { /* ignore invalid */ }
    }
    return set;
  }
  
  function wireSelection(tool) {
    const inputId = selectableInputs[tool];
    if (!inputId || !workspace) return;
    workspace.selectable = { set: currentSelectionSet(tool) };
    workspace.setSelectListener(set => {
      const target = $(`#${inputId}`);
      if (target) target.value = [...set].sort((a, b) => a - b).join(', ');
      schedulePreviewUpdate();
    });
  }
  
  function clearPreview() {
    clearTimeout(previewTimer); clearTimeout(estimateTimer);
    previewSeq++;
    _wmDetachDrag();
    _wmDetachDial();
    _wmDetachPosInputs();
    if (activeTool === 'pdf-watermark') {
      wmAngleTouched = false;
      wmPosition = { x: 0.5, y: 0.5 };
      const angleInput = $('#watermark-angle');
      if (angleInput) angleInput.value = 45;
      _wmRenderDial(45);
      _wmSyncPosInputs();
    }
    if (workspace) { workspace.setPageDraggable(false, null); workspace.setPageRemovable(false, null); workspace.clear(); }
    if (previewHost) previewHost.hidden = true;
    if (mergeHost) mergeHost.hidden = true;
    stage?.classList.remove('previewing');
    workspaceKey = null;
  }
  
  function syncCropStage() {
    if (!cropWorkspace) return;
    const active = activeTool === 'image-crop' && files.length === 1;
    cropWorkspace.hidden = !active;
    if (active) {
      dropZone.hidden = true;
      if (previewHost) previewHost.hidden = true;
      stage?.classList.remove('previewing');
    } else if (!textTools.has(activeTool)) {
      dropZone.hidden = false;
    }
  }
  
  function syncMergeStage() {
    if (!mergeHost) return;
    const active = activeTool === 'pdf-merge' && files.length > 0;
    mergeHost.hidden = !active;
    if (active) {
      dropZone.hidden = true;
      if (previewHost) previewHost.hidden = true;
      stage?.classList.remove('previewing');
    }
  }
  
  function schedulePreviewUpdate(delay = 200) {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => { refreshPreview(); }, delay);
  }
  
  async function refreshPreview({ reload = false } = {}) {
    const enabled = previewTools.has(activeTool) && !textTools.has(activeTool) && files.length > 0;
    if (!enabled) { clearPreview(); return; }
    if (activeTool === 'pdf-merge') { await refreshMergePreview(); return; }
    if (previewIndex > files.length - 1) previewIndex = Math.max(0, files.length - 1);
    const file = files[previewIndex];
    const key = `${file.name}:${file.size}:${file.lastModified}:${activeTool}`;
    previewHost.hidden = false;
    stage?.classList.add('previewing');
      const ws = ensureWorkspace();
      ws.setPageClickSelect(activeTool === 'pdf-rotate-pages' || activeTool === 'pdf-delete-pages');
      try {
      const kindMismatch = (isPdfFile(file) && ws.kind !== 'pdf') || (!isPdfFile(file) && ws.kind !== 'image');
      if (reload || workspaceKey !== key || kindMismatch) {
        workspaceKey = key;
        if (isPdfFile(file)) {
          const loadPromise = ws.loadPdf(file, { thumbnails: false });
          await loadPromise;
          wireSelection(activeTool);
        }
        else await ws.loadImage(file, { name: file.name });
      }
      else if (isPdfFile(file)) wireSelection(activeTool);
      ws.setActivePageListener(pageNumber => {
        if (activeTool === 'pdf-rotate-pages') {
          const rotations = transformFor(file).pageRotations || {};
          const pageRotation = normalizeAngle(rotations[pageNumber] || 0);
          syncRotateControls();
          ws.setNote(`Page ${pageNumber} selected · rotation ${pageRotation}°. Choose a rotation to update this page only.`);
        } else syncRotateControls();
      });
      ws.setDocNav({
        index: previewIndex,
        total: files.length,
        imageNavigation: !isPdfFile(file),
        onPrev: () => setPreviewIndex(previewIndex - 1),
        onNext: () => setPreviewIndex(previewIndex + 1)
      });
      ws.setAddFilesHandler(() => { input.value = ''; input.click(); }, { replace: singleFileTools.has(activeTool) });
      if (activeTool === 'images-pdf') {
        ws.setClearFilesHandler(() => {
          files = [];
          previewIndex = 0;
          renderSelected();
          runButton.disabled = true;
          setRunButtonLabel('Choose files to start →');
          results.hidden = true;
          results.replaceChildren();
          input.value = '';
          input.click();
          schedulePreviewUpdate();
        });
      } else {
        ws.setClearFilesHandler(null);
      }
      ws.setFileStrip(files.length > 1 ? files : null, previewIndex, index => setPreviewIndex(index), (from, to) => {
        if (from === to) return;
        const [moved] = files.splice(from, 1);
        files.splice(to, 0, moved);
        if (previewIndex === from) previewIndex = to;
        else if (from < previewIndex && to >= previewIndex) previewIndex -= 1;
        else if (from > previewIndex && to <= previewIndex) previewIndex += 1;
        renderSelected();
        runButton.disabled = !canRun();
        showStatus(`Moved to position ${to + 1}.`, 'info');
      }, index => {
        if (index < 0 || index >= files.length) return;
        files.splice(index, 1);
        if (files.length === 0) previewIndex = 0;
        else if (previewIndex >= files.length) previewIndex = files.length - 1;
        else if (index < previewIndex) previewIndex -= 1;
        renderSelected();
        runButton.disabled = !canRun();
        schedulePreviewUpdate();
      }, () => {
        files = [];
        previewIndex = 0;
        renderSelected();
        runButton.disabled = true;
        setRunButtonLabel('Choose files to start →');
        results.hidden = true;
        results.replaceChildren();
        input.value = '';
        input.click();
        schedulePreviewUpdate();
      });
      await applyToolPreview(file);
    }
    catch (error) {
      const message = error?.message || 'Could not generate a preview for this file.';
      ws.setNote(message, 'error');
      showStatus(message, 'error');
    }
  }
  
  async function refreshMergePreview() {
    if (previewHost) previewHost.hidden = true;
    if (mergeHost) mergeHost.hidden = false;
    dropZone.hidden = true;
    stage?.classList.add('previewing');
    if (!mergeBoard) return;
    try { await mergeBoard.load(files); }
    catch (error) { showStatus(error?.message || 'Could not read the PDF pages.', 'error'); }
  }
  
  function syncImagePdfControls() {
    if (activeTool !== 'images-pdf' || !files.length) return;
    const file = files[previewIndex];
    const key = `${file.name}:${file.size}:${file.lastModified}`;
    const settings = imagePdfSettings.get(key) || imagePdfDefaultSettings;
    const sizeEl = $('#pdf-page-size');
    const orientEl = $('#pdf-page-orientation');
    if (sizeEl) sizeEl.value = settings.pageSize || 'fit';
    if (orientEl) orientEl.value = settings.orientation || 'portrait';
  }
  
  function setPreviewIndex(index) {
    const next = Math.max(0, Math.min(index, files.length - 1));
    if (next === previewIndex) return;
    workspace?.setImageTransition(next > previewIndex ? 'next' : 'previous');
    previewIndex = next;
    for (const row of selected.querySelectorAll('.selected-file[data-file-index]')) {
      row.classList.toggle('preview-active', Number(row.dataset.fileIndex) === previewIndex);
    }
    syncRotateControls();
    syncImagePdfControls();
    schedulePreviewUpdate();
