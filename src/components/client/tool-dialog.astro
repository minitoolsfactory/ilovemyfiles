  async function previewPdfTool(file) {
    const ws = workspace;
    switch (activeTool) {
      case 'pdf-compress': return previewPdfCompress(file);
      case 'pdf-rotate-pages': return previewPdfRotate();
      case 'pdf-resize-pages': return previewPdfResize();
      case 'pdf-delete-pages': return previewPdfDelete();
      case 'pdf-organize': return previewPdfOrganize();
      case 'pdf-watermark': return previewPdfWatermark();
      case 'pdf-page-numbers': return previewPdfNumbers();
      case 'pdf-to-images': {
        const format = $('#pti-format').value === 'image/jpeg' ? 'JPG' : 'PNG';
        ws.setModeLabel(`${ws.pageCount} page(s) → ${format}`);
