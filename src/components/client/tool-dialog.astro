  async function runTool() {
    if (!canRun() || busy) return;
    if (activeTool === 'data-hash' || textTools.has(activeTool)) return runTextTool();
    if (activeTool === 'pdf-remove-metadata') return runMetadataTool();
    setBusy(true); status.hidden = true; results.hidden = true; results.replaceChildren();
    progressWrap.hidden = false; setProgress({ percent: 0, label: 'Preparing…' });
    try {
      let outputs = [];
      if (activeTool === 'image-convert') {
        const type = $('#image-format').value;
        const margin = Number($('#convert-margin')?.value) || 0;
        const ext = activeOption('.format-chip.active')?.dataset.ext || null;
        outputs = await processMany(file => convertImage(file, type, margin, ext));
      } else if (activeTool === 'image-compress') {
        const type = $('#compress-format').value;
        const mode = $('#compress-mode').value;
        outputs = await processMany(file => compressImage(file, { type, mode, quality: $('#quality')?.value, targetKb: $('#target-kb')?.value, ext: selectExt('compress-format') }));
      } else if (activeTool === 'image-resize') {
        const width = Number($('#resize-width').value), height = Number($('#resize-height').value);
        if (!Number.isInteger(width) || !Number.isInteger(height) || width < 1 || height < 1 || width > 20000 || height > 20000) throw new Error('Enter width and height between 1 and 20,000 pixels.');
        const keep = $('#keep-ratio').checked, type = $('#resize-format').value, margin = Number($('#image-resize-margin')?.value) || 0;
        outputs = await processMany(file => resizeImage(file, width, height, keep, type, margin, selectExt('resize-format')));
      } else if (activeTool === 'image-rotate') {
        const type = $('#rotate-format').value;
        const margin = Number($('#rotate-image-margin')?.value) || 0;
        if (!margin && !files.some(activeTransformApplied)) throw new Error('Rotate or flip at least one image, or add a margin.');
        outputs = await processMany(file => {
          const entry = transformFor(file);
          return rotateImage(file, { rotation: entry.rotation, flipH: entry.flipH, flipV: entry.flipV, type, margin, ext: selectExt('rotate-format') });
        });
      } else if (activeTool === 'image-crop') {
        const area = cropEditor?.getCropRect();
        if (!area || area.width < 1 || area.height < 1) throw new Error('Select a crop area first.');
        const type = $('#crop-format').value;
        const margin = Number($('#crop-margin')?.value) || 0;
        outputs = await processMany(file => cropImage(file, area, type, margin, selectExt('crop-format')));
      } else if (activeTool === 'image-watermark') {
        const options = {
          text: $('#wm-text').value, position: $('#wm-position').value, color: $('#wm-color').value,
          opacity: $('#wm-opacity').value, scale: $('#wm-size').value, type: $('#wm-format').value, ext: selectExt('wm-format')
        };
        if (!options.text.trim()) throw new Error('Enter watermark text first.');
        outputs = await processMany(file => watermarkImage(file, options));
      } else if (activeTool === 'images-pdf') {
        const fileSettings = files.map(file => {
          const key = `${file.name}:${file.size}:${file.lastModified}`;
          const s = imagePdfSettings.get(key) || imagePdfDefaultSettings;
          return { pageSize: s.pageSize, orientation: s.orientation };
        });
        outputs = [await imagesToPdf(files, { pageSize: $('#pdf-page-size').value, orientation: $('#pdf-page-orientation').value, margin: $('#pdf-margin').value, fileSettings }, setProgress)];
      } else if (activeTool === 'pdf-merge') {
        const order = mergeBoard?.getOrder?.() || [];
        const mergeMargin = Number($('#merge-margin')?.value) || 0;
        const mergeSize = $('#merge-page-size')?.value || 'original';
        const mergeOrientation = $('#merge-orientation')?.value || 'auto';
        const mergeOptions = { margin: mergeMargin, size: mergeSize, orientation: mergeOrientation };
        const mergeQuality = $('#merge-quality')?.value || 'original';
        let mergeResult = order.length ? await mergePdfPages(files, order, setProgress, mergeOptions) : await mergePdfs(files, setProgress, mergeOptions);
        if (mergeQuality && mergeQuality !== 'original') {
          const mergedFile = new File([mergeResult.blob], 'ilovemyfiles-merged.pdf', { type: 'application/pdf' });
          mergeResult = await compressPdf(mergedFile, { level: mergeQuality }, setProgress);
        }
        outputs = [mergeResult];
      } else if (activeTool === 'pdf-split') {
        const mode = $('#split-mode').value;
        const selection = $('#split-pages')?.value || '';
        outputs = [];
        for (let index = 0; index < files.length; index++) {
          const file = files[index];
          const parts = await splitPdf(file, mode, selection, step => setProgress({
            percent: Math.round((index + (step?.percent || 0) / 100) / files.length * 100),
            label: files.length > 1 ? `${file.name}: ${step?.label || ''}` : step?.label
          }));
          outputs.push(...parts);
        }
      } else if (activeTool === 'pdf-delete-pages') {
        outputs = [await deletePdfPages(files[0], $('#delete-pages').value, setProgress)];
      } else if (activeTool === 'pdf-rotate-pages') {
        const rotations = transformFor(files[0]).pageRotations || {};
        const changedPages = Object.entries(rotations).filter(([, rotation]) => normalizeAngle(rotation) !== 0);
        if (!changedPages.length) throw new Error('Select a page and choose a rotation before processing.');
        outputs = [await rotatePdfPages(files[0], rotations, '', setProgress)];
      } else if (activeTool === 'pdf-resize-pages') {
        outputs = [await resizePdfPages(files[0], { size: $('#resize-page-size').value, orientation: $('#resize-orientation').value, margin: $('#resize-margin').value, pages: $('#resize-pages').value }, setProgress)];
      } else if (activeTool === 'pdf-page-numbers') {
        const selectedFont = $('#numbers-font')?.value || 'helvetica';
        const bold = !!$('#numbers-bold')?.checked;
        const italic = !!$('#numbers-italic')?.checked;
        const fontKey = WM_FONTS[selectedFont]?.googleFamily
          ? selectedFont
          : wmFontKey(WM_FONTS[selectedFont]?.family || selectedFont, bold, italic);
        outputs = [await addPageNumbers(files[0], { position: $('#numbers-position').value, start: $('#numbers-start').value, format: $('#numbers-format').value, custom: $('#numbers-custom').value, font: fontKey, fontFamily: WM_FONTS[fontKey]?.googleFamily || null, fontWeight: Number(WM_FONTS[fontKey]?.weight) || (bold ? 700 : 400), fontStyle: WM_FONTS[fontKey]?.style || (italic ? 'italic' : 'normal'), underline: !!$('#numbers-underline')?.checked, size: $('#numbers-size').value, color: $('#numbers-color').value }, setProgress)];
      } else if (activeTool === 'pdf-watermark') {
        const selectedFont = $('#watermark-font')?.value || 'helvetica';
        const bold = !!$('#watermark-bold')?.checked;
        const italic = !!$('#watermark-italic')?.checked;
const fontKey = WM_FONTS[selectedFont]?.googleFamily
      ? selectedFont
      : wmFontKey(WM_FONTS[selectedFont]?.family || selectedFont, bold, italic);
        const face = WM_FONTS[fontKey] || WM_FONTS.helvetica;
        outputs = [await addPdfWatermark(files[0], { text: $('#watermark-text').value, size: $('#watermark-size').value, opacity: $('#watermark-opacity').value, font: fontKey, fontFamily: face.googleFamily, fontWeight: Number(face.weight) || (bold ? 700 : 400), fontStyle: face.style || (italic ? 'italic' : 'normal'), underline: $('#watermark-underline')?.checked, color: $('#watermark-color')?.value, angle: $('#watermark-angle').value, x: wmPosition.x, y: wmPosition.y }, setProgress)];
      } else if (activeTool === 'pdf-to-images') {
        outputs = await pdfToImages(files[0], { type: $('#pti-format').value, dpi: $('#pti-dpi').value, pages: $('#pti-pages').value }, setProgress);
      } else if (activeTool === 'pdf-organize') {
        outputs = [await organizePdfPages(files[0], $('#organize-order').value, setProgress)];
      } else if (activeTool === 'pdf-compress') {
        const level = activeOption('input[name="compress-level"]:checked')?.value || 'recommended';
        outputs = [await compressPdf(files[0], { level }, setProgress)];
      } else if (activeTool === 'ocr') {
        outputs = [await ocrFile(files[0], { lang: $('#ocr-lang').value }, setProgress)];
      } else if (activeTool === 'pdf-ocr') {
        outputs = [await makeSearchablePdf(files[0], { lang: $('#pdf-ocr-lang').value, dpi: $('#pdf-ocr-dpi').value, quality: $('#pdf-ocr-quality').value }, setProgress)];
      } else if (activeTool === 'pdf-flatten') {
        outputs = [await flattenPdf(files[0], { dpi: $('#flatten-dpi').value, quality: $('#flatten-quality').value }, setProgress)];
      }
      setProgress({ percent: 100, label: 'Done' });
      renderResults(outputs);
      showStatus('Finished. Your files are ready to download.', 'success');
      revealResults();
    } catch (error) {
      showStatus(error?.message || 'Something went wrong while processing the files.', 'error');
    } finally { setBusy(false); }
  }
  
  async function processMany(callback) {
    const outputs = [];
    for (let index = 0; index < files.length; index++) {
      setProgress({ percent: Math.round(index / files.length * 90), label: `Processing ${files[index].name}…` });
      outputs.push(await callback(files[index]));
    }
    return outputs;
  }
  
  function renderResults(outputs) {
    results.replaceChildren(); results.hidden = false;
    outputs.forEach(output => {
      const row = document.createElement('div'); row.className = 'result-row';
      const icon = document.createElement('span'); icon.className = 'result-check'; icon.textContent = '✓';
      const info = document.createElement('span'); info.className = 'result-info';
      const name = document.createElement('b'); name.textContent = output.name;
      const meta = document.createElement('small'); meta.textContent = output.details || formatBytes(output.blob.size);
      info.append(name, meta);
      const previewable = output.blob.type.startsWith('image/') || output.blob.type === 'application/pdf';
      const download = document.createElement('button'); download.className = 'button button-small'; download.type = 'button'; download.textContent = 'Download';
      download.addEventListener('click', () => downloadBlob(output.blob, output.name));
      const actions = document.createElement('span'); actions.className = 'result-actions';
      if (previewable) {
        const preview = document.createElement('button'); preview.className = 'button button-small preview-button'; preview.type = 'button'; preview.textContent = 'Preview';
        preview.addEventListener('click', () => openPreview({ name: output.name, blob: output.blob }));
        actions.append(preview);
      }
      actions.append(download);
      row.append(icon, info, actions); results.append(row);
      if (output.text) {
        const details = document.createElement('details'); details.className = 'result-text';
        const summary = document.createElement('summary'); summary.textContent = 'Recognized text';
        const pre = document.createElement('pre'); pre.textContent = output.text || '(no text found)';
        const copy = document.createElement('button'); copy.type = 'button'; copy.className = 'button button-small'; copy.textContent = 'Copy text';
        copy.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(output.text); } catch { /* clipboard unavailable */ }
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy text'; }, 1500);
        });
        details.append(summary, pre, copy);
        results.append(details);
      }
    });
    if (outputs.length > 1) {
      const downloadAll = document.createElement('button'); downloadAll.type = 'button'; downloadAll.className = 'button button-primary button-full'; downloadAll.textContent = 'Download all as ZIP';
      downloadAll.addEventListener('click', async () => {
        try {
          downloadAll.disabled = true; downloadAll.textContent = 'Preparing ZIP…';
          const JSZip = (await import('jszip')).default; const zip = new JSZip();
          outputs.forEach(output => zip.file(output.name, output.blob));
          const blob = await zip.generateAsync({ type: 'blob' });
          downloadBlob(blob, 'ilovemyfiles-results.zip');
        } catch (error) { showStatus(error.message || 'Could not create ZIP.', 'error'); }
        finally { downloadAll.disabled = false; downloadAll.textContent = 'Download all as ZIP'; }
      });
      results.append(downloadAll);
    }
  }
      window.iLoveMyFilesModules['tool-dialog'] = { openToolById, initToolDialog };
  });
</script>
