      const { convertImage, compressImage, resizeImage, rotateImage, cropImage, watermarkImage, readImageDimensions } = window.iLoveMyFilesModules['image-tools'];
      const { imagesToPdf, mergePdfs, mergePdfPages, splitPdf, deletePdfPages, rotatePdfPages, addPageNumbers, addPdfWatermark, loadWatermarkFont, organizePdfPages, pdfToImages, compressPdf, resizePdfPages, normalizeAngle, COMPRESSION_LEVELS, PDF_PAGE_SIZES } = window.iLoveMyFilesModules['pdf-tools'];
      const { inspectPdfMetadata, removePdfMetadata } = window.iLoveMyFilesModules['metadata-tools'];
      const { formatJson, base64Convert, hashText, hashFiles, countTextReport, jsonToCsv, csvToJson, convertUnits } = window.iLoveMyFilesModules['data-tools'];
