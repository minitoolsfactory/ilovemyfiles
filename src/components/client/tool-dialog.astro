    valueAnimationTimers.set(element, setTimeout(() => element.classList.remove('control-value-updated'), 480));
  }

  function setAnimatedText(element, value) {
    if (!element || element.textContent === value) return;
    element.textContent = value;
    animateValue(element);
  }
  
  function syncMarginPresets(input) {
    if (!input || !input.id) return;
    const control = input.closest?.('.margin-control');
    if (!control) return;
    const value = Number(input.value) || 0;
    control.querySelectorAll('.margin-preset').forEach(btn => btn.classList.toggle('active', Number(btn.dataset.value) === value));
  }

  function imageFormatForFile(file) {
    const name = file.name.toLowerCase();
    const dot = name.lastIndexOf('.');
    const ext = dot >= 0 ? name.slice(dot) : '';
    const type = (file.type || '').toLowerCase();
    if (type === 'image/jpeg' || ext === '.jpg' || ext === '.jpeg') {
      return ext === '.jpeg'
        ? '[data-format="image/jpeg"][data-ext="jpeg"]'
        : '[data-format="image/jpeg"]:not([data-ext])';
    }
    const map = {
      'image/png': '[data-format="image/png"]', '.png': '[data-format="image/png"]',
      'image/webp': '[data-format="image/webp"]', '.webp': '[data-format="image/webp"]',
      'image/bmp': '[data-format="image/bmp"]', '.bmp': '[data-format="image/bmp"]',
      'image/gif': '[data-format="image/gif"]', '.gif': '[data-format="image/gif"]',
      'image/x-icon': '[data-format="image/x-icon"]', '.ico': '[data-format="image/x-icon"]',
      'image/svg+xml': '[data-format="image/svg+xml"]', '.svg': '[data-format="image/svg+xml"]',
      'image/tiff': '[data-format="image/tiff"]', '.tiff': '[data-format="image/tiff"]', '.tif': '[data-format="image/tiff"]'
    };
    return map[type] || map[ext] || null;
  }

  function syncConvertFormat(file) {
    if (activeTool !== 'image-convert' || !file) return;
    const panel = optionPanels.find(p => p.dataset.toolOptions === 'image-convert');
    if (!panel) return;
    const grid = panel.querySelector('.format-grid');
    if (!grid) return;
    const selector = imageFormatForFile(file);
    if (!selector) return;
    const chip = grid.querySelector(selector);
    if (!chip) return;
    grid.querySelectorAll('.format-chip').forEach(node => node.classList.toggle('active', node === chip));
    const hidden = panel.querySelector('#image-format');
    if (hidden) hidden.value = chip.dataset.format;
    schedulePreviewUpdate();
  }

  function syncSelectFormat(selectId, file) {
    const select = $(`#${selectId}`);
    if (!select || !file) return;
    const type = (file.type || '').toLowerCase();
    const name = file.name.toLowerCase();
    const dot = name.lastIndexOf('.');
    const ext = dot >= 0 ? name.slice(dot + 1) : '';
    let targetType = null, targetExt = null;
    if (type === 'image/jpeg' || ext === 'jpg' || ext === 'jpeg') {
      targetType = 'image/jpeg';
      targetExt = ext === 'jpeg' ? 'jpeg' : 'jpg';
    } else {
      const map = {
        'image/png': 'png', '.png': 'png',
        'image/webp': 'webp', '.webp': 'webp',
        'image/bmp': 'bmp', '.bmp': 'bmp',
        'image/gif': 'gif', '.gif': 'gif',
        'image/x-icon': 'ico', '.ico': 'ico',
        'image/svg+xml': 'svg', '.svg': 'svg',
        'image/tiff': 'tiff', '.tiff': 'tiff', '.tif': 'tiff'
      };
      const key = map[type] || map['.' + ext];
      if (!key) return;
      targetType = 'image/' + key;
      targetExt = key;
    }
    for (const option of select.options) {
      const matchType = option.value === targetType;
      const matchExt = targetExt ? (option.dataset.ext || '') === targetExt : true;
      option.selected = matchType && matchExt;
    }
  }

  function selectExt(selectId) {
    const select = $(`#${selectId}`);
    if (!select) return null;
    const option = select.options[select.selectedIndex];
    return option ? (option.dataset.ext || null) : null;
  }
  
  function updateResizeDimension(changed) {
    if (!$('#keep-ratio')?.checked || files.length !== 1) return;
    readImageDimensions(files[0]).then(({ width, height }) => {
      const w = Number($('#resize-width').value), h = Number($('#resize-height').value);
      if (changed === 'resize-width' && w > 0) $('#resize-height').value = Math.max(1, Math.round(w * height / width));
      if (changed === 'resize-height' && h > 0) $('#resize-width').value = Math.max(1, Math.round(h * width / height));
    }).catch(() => {});
  }
  
  function showStatus(message, type = 'info') {
    status.textContent = message; status.className = `status-message status-${type}`; status.hidden = false;
  }
  
  function revealResults() {
