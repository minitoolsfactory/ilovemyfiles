        const scope = files.length > 1 ? ` ${files.length} files will each be split.` : '';
        ws.setModeLabel(files.length > 1 ? `${files.length} files` : (mode === 'selected' ? 'Selected pages' : 'One PDF per page'));
        ws.setNote(mode === 'selected' ? `Only the selected pages will be saved to a new PDF.${scope}` : `Each page will be saved as a separate PDF in a ZIP.${scope}`);
        ws.refresh();
