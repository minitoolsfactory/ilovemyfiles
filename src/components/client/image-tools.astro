    const blob = await canvasToBlob(padded, type, 0.92);
    const m = Math.max(0, Math.round(Number(margin) || 0));
    if (padded !== canvas) { padded.width = 1; padded.height = 1; }
    canvas.width = 1; canvas.height = 1;
    return { blob, name: `${safeBaseName(file.name)}-cropped.${ext || extensionFor(type)}`, details: `${width + m * 2} × ${height + m * 2} · ${formatBytes(blob.size)}`, width: width + m * 2, height: height + m * 2, sizeBytes: blob.size, mimeType: blob.type || type };
  }
  
  async function compressImage(file, options) {
    const image = await loadImage(file);
    let width = image.naturalWidth, height = image.naturalHeight;
    const { type, mode, ext } = options;
    if (mode === 'quality') {
      const blob = await encodeImage(image, width, height, type, Number(options.quality) / 100);
