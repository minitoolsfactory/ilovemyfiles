  }
  
  async function watermarkImage(file, options = {}) {
    const image = await loadImage(file);
    const type = options.type || 'image/png';
    const outWidth = image.naturalWidth, outHeight = image.naturalHeight;
    const canvas = makeCanvas(outWidth, outHeight);
    const opaque = OPAQUE_FORMATS.has(type);
    const context = canvas.getContext('2d', { alpha: !opaque });
    if (opaque) { context.fillStyle = '#fff'; context.fillRect(0, 0, canvas.width, canvas.height); }
    context.drawImage(image, 0, 0);
    const text = String(options.text || '© iLoveMyFiles').slice(0, 80);
    const size = Math.max(8, Math.round(Math.min(canvas.width, canvas.height) * (Number(options.scale) || 6) / 100));
    const margin = Math.round(size * 0.9);
    context.font = `700 ${size}px ui-sans-serif, system-ui, sans-serif`;
    context.globalAlpha = Math.max(0.05, Math.min(1, Number(options.opacity) || 0.6));
    context.textBaseline = 'alphabetic';
    const width = context.measureText(text).width;
