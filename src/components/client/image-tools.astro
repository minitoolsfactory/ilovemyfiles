  function readImageDimensions(file) {
    return loadImage(file).then(image => ({ width: image.naturalWidth, height: image.naturalHeight }));
  }

  // Detect the actual container from magic bytes instead of trusting the filename.
  // This lets the UI warn when a .jpg is really a HEIC/AVIF or similar.
  async function detectImageType(file) {
    if (!file) return { mimeType: file?.type || '', format: 'unknown', supported: false };
    try {
      const head = new Uint8Array(await file.slice(0, 64).arrayBuffer());
      const ascii = (start, end) => String.fromCharCode(...head.slice(start, end));
      const text = ascii(0, Math.min(head.length, 64)).trim().toLowerCase();
      let format = '', mimeType = '';
      if (head[0] === 0xFF && head[1] === 0xD8 && head[2] === 0xFF) { format = 'JPG'; mimeType = 'image/jpeg'; }
