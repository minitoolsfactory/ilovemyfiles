  function canvasToIco(canvas) {
    return canvasToBlob(canvas, 'image/png').then(png =>
      png.arrayBuffer().then(buffer => {
        const pngBytes = new Uint8Array(buffer);
        const { width, height } = canvas;
        const out = new ArrayBuffer(22 + pngBytes.length);
        const view = new DataView(out);
        const bytes = new Uint8Array(out);
        view.setUint16(0, 0, true);
        view.setUint16(2, 1, true);
        view.setUint16(4, 1, true);
        view.setUint8(6, width >= 256 ? 0 : width);
        view.setUint8(7, height >= 256 ? 0 : height);
        view.setUint8(8, 0);
        view.setUint8(9, 0);
        view.setUint16(10, 1, true);
        view.setUint16(12, 32, true);
        view.setUint32(14, pngBytes.length, true);
        view.setUint32(18, 22, true);
        bytes.set(pngBytes, 22);
        return new Blob([out], { type: 'image/x-icon' });
      }));
