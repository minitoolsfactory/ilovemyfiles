  const ENCODERS = {
    'image/bmp': canvasToBmp,
    'image/gif': canvasToGif,
    'image/x-icon': canvasToIco,
    'image/svg+xml': canvasToSvg,
    'image/tiff': canvasToTiff
  };
  
  function drawImage(image, width, height, type) {
    const canvas = makeCanvas(width, height);
    const opaque = OPAQUE_FORMATS.has(type);
    const context = canvas.getContext('2d', { alpha: !opaque });
    if (opaque) { context.fillStyle = '#fff'; context.fillRect(0, 0, canvas.width, canvas.height); }
    context.drawImage(image, 0, 0, canvas.width, canvas.height);
    return canvas;
  }
  function padCanvas(source, margin, type) {
    const m = Math.max(0, Math.round(Number(margin) || 0));
    if (!m) return source;
    const canvas = makeCanvas(source.width + m * 2, source.height + m * 2);
    const opaque = OPAQUE_FORMATS.has(type);
    const context = canvas.getContext('2d', { alpha: !opaque });
    if (opaque) { context.fillStyle = '#fff'; context.fillRect(0, 0, canvas.width, canvas.height); }
    context.drawImage(source, m, m);
    return canvas;
  }
  async function encodeImage(image, width, height, type, quality, margin) {
    const base = drawImage(image, width, height, type);
    const canvas = padCanvas(base, margin, type);
    const encoder = ENCODERS[type];
    const blob = encoder ? await encoder(canvas) : await canvasToBlob(canvas, type, quality);
    if (canvas !== base) { canvas.width = 1; canvas.height = 1; }
    base.width = 1; base.height = 1;
    return blob;
  }
  
  async function convertImage(file, type, margin = 0, ext = null) {
    const image = await loadImage(file);
    const blob = await encodeImage(image, image.naturalWidth, image.naturalHeight, type, 0.9, margin);
    const m = Math.max(0, Math.round(Number(margin) || 0));
    const width = image.naturalWidth + m * 2, height = image.naturalHeight + m * 2;
    return { blob, name: `${safeBaseName(file.name)}.${ext || extensionFor(type)}`, details: `${width} × ${height} · ${formatBytes(blob.size)}`, width, height, sizeBytes: blob.size, mimeType: blob.type || type };
  }
  
  async function resizeImage(file, width, height, keepRatio, type, margin = 0, ext = null) {
    const image = await loadImage(file);
    if (keepRatio) {
      const ratio = Math.min(width / image.naturalWidth, height / image.naturalHeight);
      width = Math.max(1, Math.round(image.naturalWidth * ratio));
      height = Math.max(1, Math.round(image.naturalHeight * ratio));
    }
    const blob = await encodeImage(image, width, height, type, 0.9, margin);
    const m = Math.max(0, Math.round(Number(margin) || 0));
    return { blob, name: `${safeBaseName(file.name)}-${width + m * 2}x${height + m * 2}.${ext || extensionFor(type)}`, details: `${width + m * 2} × ${height + m * 2} · ${formatBytes(blob.size)}`, width: width + m * 2, height: height + m * 2, sizeBytes: blob.size, mimeType: blob.type || type };
  }
  
  async function cropImage(file, area, type, margin = 0, ext = null) {
    const image = await loadImage(file);
    const width = Math.max(1, Math.min(image.naturalWidth, Math.round(area.width)));
    const height = Math.max(1, Math.min(image.naturalHeight, Math.round(area.height)));
    const x = Math.max(0, Math.min(image.naturalWidth - width, Math.round(area.x)));
    const y = Math.max(0, Math.min(image.naturalHeight - height, Math.round(area.y)));
    const canvas = makeCanvas(width, height);
    const opaque = OPAQUE_FORMATS.has(type);
    const context = canvas.getContext('2d', { alpha: !opaque });
    if (opaque) { context.fillStyle = '#fff'; context.fillRect(0, 0, width, height); }
