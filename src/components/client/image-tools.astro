  function canvasToBmp(canvas) {
    const { width, height } = canvas;
    const data = canvas.getContext('2d').getImageData(0, 0, width, height).data;
    const rowSize = Math.floor((24 * width + 31) / 32) * 4;
    const pixelArraySize = rowSize * height;
    const buffer = new ArrayBuffer(54 + pixelArraySize);
    const view = new DataView(buffer);
    view.setUint16(0, 0x424D, false);
    view.setUint32(2, 54 + pixelArraySize, true);
    view.setUint32(10, 54, true);
    view.setUint32(14, 40, true);
    view.setInt32(18, width, true);
    view.setInt32(22, height, true);
    view.setUint16(26, 1, true);
    view.setUint16(28, 24, true);
    view.setUint32(34, pixelArraySize, true);
    const bytes = new Uint8Array(buffer);
    for (let y = 0; y < height; y++) {
      const sourceY = height - 1 - y;
      for (let x = 0; x < width; x++) {
        const source = (sourceY * width + x) * 4;
        const target = 54 + y * rowSize + x * 3;
        bytes[target] = data[source + 2];
        bytes[target + 1] = data[source + 1];
        bytes[target + 2] = data[source];
      }
