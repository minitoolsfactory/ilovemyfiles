  async function rotateImage(file, options = {}) {
    const image = await loadImage(file);
    const type = options.type || 'image/png';
    const rotation = ((Number(options.rotation) || 0) % 360 + 360) % 360;
    const radians = rotation * Math.PI / 180;
    const swap = rotation === 90 || rotation === 270;
    const sourceWidth = image.naturalWidth, sourceHeight = image.naturalHeight;
    const width = swap ? sourceHeight : sourceWidth;
    const height = swap ? sourceWidth : sourceHeight;
    const canvas = makeCanvas(width, height);
    const opaque = OPAQUE_FORMATS.has(type);
    const context = canvas.getContext('2d', { alpha: !opaque });
    if (opaque) { context.fillStyle = '#fff'; context.fillRect(0, 0, canvas.width, canvas.height); }
