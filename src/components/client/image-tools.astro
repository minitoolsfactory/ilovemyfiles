    const view = new DataView(buffer);
    const bytes = new Uint8Array(buffer);
    view.setUint16(0, 0x4949, true);
    view.setUint16(2, 42, true);
    view.setUint32(4, ifdOffset, true);
    let p = ifdOffset;
    view.setUint16(p, entries, true); p += 2;
