    context.rotate(radians);
    context.scale(options.flipH ? -1 : 1, options.flipV ? -1 : 1);
    context.drawImage(image, -sourceWidth / 2, -sourceHeight / 2);
    const padded = padCanvas(canvas, options.margin, type);
    const blob = await canvasToBlob(padded, type, 0.92);
    const m = Math.max(0, Math.round(Number(options.margin) || 0));
    if (padded !== canvas) { padded.width = 1; padded.height = 1; }
    canvas.width = 1; canvas.height = 1;
