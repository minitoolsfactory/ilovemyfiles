<script>
  window.iLoveMyFilesModulesReady = (window.iLoveMyFilesModulesReady ?? Promise.resolve()).then(() => {
    window.iLoveMyFilesModules ??= {};
      const { canvasToBlob, loadImage, makeCanvas, safeBaseName, formatBytes } = window.iLoveMyFilesModules['file-utils'];
  const FORMATS = {
    'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/bmp': 'bmp',
    'image/gif': 'gif', 'image/x-icon': 'ico', 'image/svg+xml': 'svg', 'image/tiff': 'tiff'
  };
