      const blob = await encodeImage(image, width, height, type, quality);
      if (!best || Math.abs(blob.size - target) < Math.abs(best.size - target)) {
        best = blob;
        bestWidth = width;
        bestHeight = height;
      }
      if (blob.size > target) high = quality; else low = quality;
    }
