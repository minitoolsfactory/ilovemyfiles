      else if (ascii(0, 4) === 'RIFF' && ascii(8, 12) === 'WEBP') { format = 'WebP'; mimeType = 'image/webp'; }
      else if (ascii(0, 2) === 'BM') { format = 'BMP'; mimeType = 'image/bmp'; }
      else if ((ascii(0, 4) === 'II*\0' || ascii(0, 4) === 'MM\0*')) { format = 'TIFF'; mimeType = 'image/tiff'; }
