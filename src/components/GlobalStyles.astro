---
<style is:global>
/* Shared shell, tokens, header/footer, controls, and accessibility overrides. */
:root {font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#20243b;background:#fff;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;--ink:#20243b;--muted:#6a7185;--line:#e9ebf3;--purple:#5d5cf6;--purple-dark:#4b49e8;--soft:#f7f8fc;--green:#20a875
}
* {box-sizing:border-box
}
html {scroll-behavior:smooth;scroll-padding-top:84px
}
body {margin:0;min-width:320px;overflow-x:hidden;-webkit-text-size-adjust:100%
}
a {color:inherit;text-decoration:none
}
button, input, select {font:inherit
}
button {cursor:pointer
}
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible {outline:3px solid #aaa9ff;outline-offset:3px
}
.skip-link {position:absolute;top:-50px;left:16px;background:#fff;padding:12px;z-index:100
}
.skip-link:focus {top:10px
}
.topbar {height:78px;max-width:1200px;margin:auto;padding:0 28px;display:flex;align-items:center;gap:36px;border-bottom:1px solid #f1f1f7
}
.brand {display:inline-flex;align-items:center;gap:9px;font-size:22px;font-weight:800;letter-spacing:-.9px;white-space:nowrap
}
.brand-mark {width:33px;height:33px;display:grid;place-items:center;background:#eeedff;color:var(--purple);border-radius:10px
}
.brand-mark svg {width:25px;height:25px
}
.brand-dot {color:var(--purple)
}
.brand-heart {color:#e53935;display:inline-block;transform:translateY(-1px)
}
.topnav {display:flex;gap:30px;margin-left:26px
}
.topnav a {font-size:13px;color:#626a80;font-weight:600;transition:color .2s
}
.topnav a:hover {color:var(--purple)
}
.privacy-pill {margin-left:auto;display:flex;align-items:center;gap:8px;padding:10px 13px;background:#f5fbf8;border:1px solid #e4f5ed;color:#39785e;border-radius:999px;font-size:11px;font-weight:700
}
.status-dot {display:inline-block;width:7px;height:7px;background:#25b77b;border-radius:50%;box-shadow:0 0 0 3px #dff7eb
}
.button {border:0;display:inline-flex;align-items:center;justify-content:center;gap:16px;border-radius:10px;padding:14px 18px;font-weight:700;font-size:12px;transition:transform .15s,background .15s;white-space:nowrap
}
.button:hover {transform:translateY(-1px)
}
.button-primary {background:var(--purple);color:#fff;box-shadow:0 8px 18px #5d5cf626
}
.button-primary:hover {background:var(--purple-dark)
}
.button-primary:disabled {opacity:.5;cursor:not-allowed;transform:none
}
.tool-icon {flex:0 0 42px;width:42px;height:42px;border-radius:12px;display:grid;place-items:center
}
.tool-icon svg {width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round
}
.footer {max-width:1100px;margin:auto;border-top:1px solid #eff0f6;padding:23px 0 28px;display:flex;align-items:center;gap:20px;color:#989daf;font-size:10px
}
.footer-brand {font-size:16px;color:var(--ink)
}
.footer-brand .brand-mark {width:26px;height:26px;border-radius:8px
}
.footer-brand .brand-mark svg {width:20px
}
.footer p {margin:0
}
.footer>span {margin-left:auto
}
@media (max-width:900px) {
.topbar {gap:20px;padding:0 22px
}
.topnav {margin-left:5px;gap:18px
}
.footer {margin:0 28px
}
}
@media (max-width:640px) {
.topbar {height:65px;padding:0 17px
}
.brand {font-size:20px
}
.topnav {display:none
}
.privacy-pill {font-size:9px;padding:8px 10px
}
.footer {margin:0 18px;flex-wrap:wrap;gap:12px
}
.footer p {order:3;flex-basis:100%
}
.footer>span {margin-left:auto
}
}
@media (prefers-reduced-motion:reduce) {
*, *::before, *::after {scroll-behavior:auto!important;transition:none!important;animation:none!important
}
}
.theme-toggle {margin-left:-16px;border:1px solid #e8eaf2;background:#fff;color:#626a80;width:36px;height:36px;border-radius:50%;font-size:14px;display:grid;place-items:center;flex:0 0 auto;transition:color .2s,border-color .2s
}
.theme-toggle:hover {color:var(--purple);border-color:#c7c6ff
}
:root[data-theme="dark"] {--ink:#e6e8f5;--muted:#98a0bd;--line:#2a2e47;--purple:#8f8dff;--purple-dark:#7c7aff;--soft:#16182a;--green:#3ec78f;color:#e6e8f5;background:#0e1020
}
[data-theme="dark"] body {background:#0e1020;color:var(--ink)
}
[data-theme="dark"] .topbar {border-color:#22263d
}
[data-theme="dark"] .topnav a {color:#a0a7c2
}
[data-theme="dark"] .brand-mark {background:#232750;color:#a9a8ff
}
[data-theme="dark"] .privacy-pill {background:#122a20;border-color:#1d3f2f;color:#7fd6ab
}
[data-theme="dark"] .theme-toggle {background:#181b2e;border-color:#2a2f4a;color:#a8aec7
}
[data-theme="dark"] .footer {border-color:#22263d;color:#7f86a3
}
[data-theme="dark"] .footer-brand {color:#dfe2f0
}
.tool-icon-lg {width:58px;height:58px;flex:0 0 58px;border-radius:16px
}
.tool-icon-lg svg {width:31px;height:31px
}
.button {border-radius:12px
}
.button-primary {background:linear-gradient(115deg,#5b59f2,#7c7aff);box-shadow:0 12px 26px #5d5cf633
}
.button-primary:hover {background:linear-gradient(115deg,#4b49e8,#6f6dff)
}
.tool-icon {border-radius:13px
}
.theme-toggle {border-radius:12px;width:38px;height:38px
}
[hidden] {display:none!important
}
@media (max-width:480px) {
html {font-size:16px
}
body {font-size:15px
}
.button {font-size:12px
}
}
::view-transition-old(root) {animation:fadeOut .2s ease
}
::view-transition-new(root) {animation:fadeIn .25s ease
}
:root {
  --color-text-primary:#20243b;
  --color-text-secondary:#4b5268;
  --color-text-muted:#5c6377;
  --color-text-subtle:#616881;
  --color-background:#ffffff;
  --color-surface:#ffffff;
  --color-surface-soft:#f7f8fc;
  --color-surface-tint:#f0efff;
  --color-border:#e9ebf3;
  --color-border-control:#7d8497;
  --color-divider:#e2e5ef;
  --color-accent:#4b49e8;
  --color-accent-strong:#4338ca;
  --color-accent-brand:#5d5cf6;
  --color-action:#5d5cf6;
  --color-action-hover:#4b49e8;
  --color-on-accent:#ffffff;
  --color-focus:#4338ca;
  --color-success:#1a7f57;
  --color-success-bg:#eaf9f1;
  --color-warning:#8a5a00;
  --color-warning-bg:#fff7db;
  --color-error:#b3261e;
  --color-error-bg:#fdecec;
  --radius-sm:8px;
  --radius-md:13px;
  --radius-lg:17px;
  --space-1:4px;
  --space-2:8px;
  --space-3:13px;
  --space-4:20px;
  --space-5:28px;
  --space-6:40px;
  --font-xs:10px;
  --font-sm:11px;
  --font-md:13px;
  /* Remap legacy palette names onto validated tokens. */
  --ink:var(--color-text-primary);
  --muted:var(--color-text-muted);
  --line:var(--color-border)
}
:root[data-theme="dark"] {
  --color-text-primary:#e6e8f5;
  --color-text-secondary:#c3c8dc;
  --color-text-muted:#9aa1bd;
  --color-text-subtle:#8b93b0;
  --color-background:#0e1020;
  --color-surface:#171a2c;
  --color-surface-soft:#12142a;
  --color-surface-tint:#24264a;
  --color-border:#2a2e47;
  --color-border-control:#626784;
  --color-divider:#2a2e47;
  --color-accent:#b3b0ff;
  --color-accent-strong:#dcdbff;
  --color-accent-brand:#8f8dff;
  --color-action:#5d5cf6;
  --color-action-hover:#4b49e8;
  --color-on-accent:#ffffff;
  --color-focus:#dcdbff;
  --color-success:#7fd6ab;
  --color-success-bg:#122a20;
  --color-warning:#f3c46b;
  --color-warning-bg:#2a2413;
  --color-error:#f4a7a7;
  --color-error-bg:#2a1517;
  --ink:var(--color-text-primary);
  --muted:var(--color-text-muted);
  --line:var(--color-border)
}
.sr-only {position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0
}
a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible, [tabindex]:focus-visible, .skip-link:focus-visible {
  outline:3px solid var(--color-focus);
  outline-offset:2px
}
.footer, .footer p, .footer>span {color:var(--color-text-muted)
}
.button-primary {background:var(--color-action);color:var(--color-on-accent)
}
.button-primary:hover {background:var(--color-action-hover)
}
</style>
