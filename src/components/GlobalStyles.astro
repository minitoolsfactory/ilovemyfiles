.tool-hero-copy .micro-trust{display:inline-flex;vertical-align:middle}
.tool-content{display:grid;grid-template-columns:1.6fr .9fr;gap:40px;padding-top:30px}
.tool-main h2{font-size:18px;letter-spacing:-.5px;margin:30px 0 14px}
.tool-main h2:first-child{margin-top:0}
.steps{margin:0;padding-left:20px;display:grid;gap:9px;font-size:13px;line-height:1.7;color:#5d647a}
.faq-list{display:grid;gap:8px}
.faq{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:#fff}
.faq summary{cursor:pointer;font-weight:700;font-size:12px;list-style:none}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';float:right;color:var(--purple)}
.faq[open] summary::after{content:'–'}
.faq p{margin:10px 0 0;font-size:12px;line-height:1.7;color:#747b91}
.related-box h3{font-size:13px;margin:0 0 12px}
.related-list{display:grid;gap:8px}
.related-link{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-size:12px;transition:border .18s}
.related-link:hover{border-color:#c7c6ff}
.related-link .tool-icon{width:32px;height:32px;flex:0 0 32px;border-radius:9px}
.related-link .tool-icon svg{width:18px;height:18px}
[data-theme="dark"] .quick-card{background:#171a2c;border-color:#272b45;color:var(--ink)}[data-theme="dark"] .recent-clear{background:#171a2c;border-color:#2c3150;color:#a8aec7}[data-theme="dark"] .recent-clear:hover{border-color:#3b3f63;color:#c7c6ff;background:#1e2138}
[data-theme="dark"] .quick-head h2{color:#8b93b0}
[data-theme="dark"] .tool-hero{border-color:var(--line)}
[data-theme="dark"] .tool-hero-copy p{color:#9aa1bd}
[data-theme="dark"] .steps{color:#b6bcd2}
[data-theme="dark"] .faq{background:#171a2c;border-color:#272b45}
[data-theme="dark"] .faq p{color:#9aa1bd}
[data-theme="dark"] .related-link{border-color:#272b45}
@media(max-width:900px){.tool-content{grid-template-columns:1fr;gap:24px}.tool-hero{flex-direction:column}.quick-section{padding:20px 22px 0}.tool-view{padding:24px 20px 70px}}
.text-workspace{margin-top:4px}
.utility-textarea{width:100%;min-height:170px;resize:vertical;border:1px solid var(--line);border-radius:12px;padding:12px 14px;font:12px/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:#fff;color:inherit}
.utility-results{margin-top:14px;display:grid;gap:10px}
.utility-actions{display:flex;gap:8px;justify-content:flex-end}
[data-theme="dark"] .utility-textarea{background:#12142a;border-color:#272b45}

/* ===== Modern visual refresh ===== */
.button{border-radius:12px}
.button-primary{background:linear-gradient(115deg,#5b59f2,#7c7aff);box-shadow:0 12px 26px #5d5cf633}
.button-primary:hover{background:linear-gradient(115deg,#4b49e8,#6f6dff)}
.button-small{border-radius:10px}
.tool-card{border-radius:16px;box-shadow:0 1px 2px #20243b08}
.tool-card:hover{box-shadow:0 18px 42px #5d5cf61f}
.tool-icon{border-radius:13px}
.search-wrap{border-radius:12px}
.category-tab{border-radius:999px;padding:9px 15px}
.theme-toggle{border-radius:12px;width:38px;height:38px}

/* ===== Tool workbench ===== */
.tool-dialog{width:min(1180px,96vw);height:min(780px,92vh);max-height:92vh;border-radius:22px}
.wb{display:flex;flex-direction:column;height:100%;min-height:0}
.wb-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:20px 26px;border-bottom:1px solid var(--line);background:#fff}
.wb-badge{display:inline-block;font-size:9px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--purple);background:#f0efff;border-radius:999px;padding:4px 11px}
.wb-head h2{font-size:21px;letter-spacing:-.6px;margin:10px 0 4px}
.wb-head p{font-size:11px;color:var(--muted);margin:0}
.wb-body{flex:1;display:grid;grid-template-columns:minmax(0,1fr) 372px;min-height:0}
.wb-stage{position:relative;min-height:0;overflow:auto;background:var(--soft);padding:26px;display:flex}
.wb-stage-inner{flex:1;display:flex;flex-direction:column;gap:14px;min-width:0}
.wb-stage .drop-zone{flex:1;min-height:300px;border-radius:18px}
.wb-stage .selected-files{margin-top:0}
.wb-stage .utility-textarea{min-height:320px}
.wb-stage .utility-results{flex:1;display:flex;flex-direction:column;gap:10px}
.wb-stage .utility-results .utility-textarea{flex:1;min-height:220px}
.wb-side{display:flex;flex-direction:column;min-height:0;border-left:1px solid var(--line);background:#fff}
.wb-side-scroll{flex:1;overflow:auto;padding:22px 24px;min-height:0}
.wb-side .tool-options{padding-top:0}
.wb-side-foot{display:flex;flex-direction:column;gap:12px;padding:16px 24px 20px;border-top:1px solid var(--line);background:#fff}
.wb-side-foot .button{width:100%;padding:15px 18px;font-size:13px}
.wb-side-foot .local-note{justify-content:center}
.wb-side .result-row{flex-wrap:wrap}

/* format picker grid */
.format-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.format-chip{border:1.5px solid var(--line);background:#fff;border-radius:12px;padding:13px 6px;font-size:11px;font-weight:800;color:#5d647a;transition:border-color .15s,background .15s,color .15s,box-shadow .15s}
.format-chip:hover{border-color:#c7c6ff}
.format-chip.active{background:linear-gradient(135deg,#5b59f2,#7c7aff);border-color:transparent;color:#fff;box-shadow:0 12px 22px #5d5cf62e}

/* stepper control */
.margin-control{display:grid;gap:8px}
.margin-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
.margin-head .field-label{margin:0}
.margin-unit{font-size:9px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
.margin-presets{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.margin-preset{border:1.5px solid var(--line);background:#fff;border-radius:9px;padding:8px 4px;font-size:10px;font-weight:800;color:#5d647a;transition:border-color .15s,background .15s,color .15s}
.margin-preset:hover{border-color:#c7c6ff}
.margin-preset.active{border-color:var(--purple);background:#f3f2ff;color:var(--purple)}
[data-theme="dark"] .margin-preset{background:#181b2e;border-color:#2c3150;color:#a8aec7}
[data-theme="dark"] .margin-preset.active{background:#232752;border-color:var(--purple);color:#bbbbff}
.stepper{display:flex;align-items:stretch;gap:8px}
.stepper .field-control{width:100%;text-align:center;-moz-appearance:textfield}
.stepper .field-control::-webkit-outer-spin-button,.stepper .field-control::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.stepper-btn{flex:0 0 40px;border:1px solid #e2e5ef;background:#fff;color:var(--purple);border-radius:8px;font-size:17px;font-weight:800;line-height:1;transition:border-color .15s,background .15s}
.stepper-btn:hover{border-color:var(--purple);background:#f3f2ff}
[data-theme="dark"] .stepper-btn{background:#181b2e;border-color:#2c3150;color:#bbbbff}
[data-theme="dark"] .stepper-btn:hover{background:#232752}

/* rotate / flip actions */
.rotate-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.rotate-act,.flip-act{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;border:1.5px solid var(--line);background:#fff;border-radius:10px;padding:11px 6px;font-size:10px;font-weight:800;color:#5d647a;transition:border-color .15s,background .15s,color .15s}
.rotate-act svg,.flip-act svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.rotate-act:hover,.flip-act:hover{border-color:#c7c6ff;color:var(--purple)}
.rotate-act:active{transform:translateY(1px)}
.flip-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.flip-act{flex-direction:row;gap:8px;padding:11px 10px}
.flip-act.active{border-color:var(--purple);background:#f3f2ff;color:var(--purple)}
.rotate-readout{display:flex;align-items:center;justify-content:space-between;background:#f6f6fc;border:1px solid #ececf6;border-radius:9px;padding:8px 11px;font-size:10px;font-weight:700;color:#7a8095}
.rotate-readout b{color:var(--purple);font-size:11px}
.rotate-reset{border:1px solid var(--line);background:#fff;border-radius:9px;padding:9px;font-size:10px;font-weight:700;color:#73798d;transition:border-color .15s,color .15s}
.rotate-reset:hover{border-color:#c7c6ff;color:var(--purple)}
.pv-page{position:relative;transition:box-shadow .22s ease,outline-color .22s ease,transform .22s ease}
.pv-page-current{outline:2px solid color-mix(in srgb,var(--purple) 62%,#fff);box-shadow:0 10px 30px color-mix(in srgb,var(--purple) 16%,transparent)}
.pv-page-enter{animation:pv-page-enter .38s ease-out}
.pv-thumb{transition:border-color .18s ease,background .18s ease,transform .18s ease}
.pv-thumb-enter{animation:pv-thumb-enter .38s ease-out}
.control-value-updated{animation:control-value-update .42s ease-out}
.pv-page-pressed{animation:pv-page-press .18s ease-out}
.pv-page-clicked{outline:2px solid var(--purple);outline-offset:3px;border-radius:4px;box-shadow:0 0 0 4px color-mix(in srgb,var(--purple) 13%,transparent);animation:pv-page-click-ring .42s ease-out}
@keyframes pv-page-press{0%{transform:scale(1)}45%{transform:scale(.985)}100%{transform:scale(1)}}
@keyframes pv-page-enter{0%{transform:scale(.992);box-shadow:0 8px 26px #20243b22}55%{transform:scale(1.006)}100%{transform:scale(1)}}
@keyframes pv-thumb-enter{0%{transform:scale(.94)}55%{transform:scale(1.08)}100%{transform:scale(1)}}
@keyframes control-value-update{0%{background-color:color-mix(in srgb,var(--purple) 18%,transparent)}100%{background-color:transparent}}
@keyframes pv-page-click-ring{0%{outline-color:transparent;outline-offset:0;box-shadow:0 0 0 0 color-mix(in srgb,var(--purple) 24%,transparent)}35%{outline-color:var(--purple);outline-offset:3px;box-shadow:0 0 0 6px color-mix(in srgb,var(--purple) 18%,transparent)}100%{outline-color:var(--purple);outline-offset:3px;box-shadow:0 0 0 4px color-mix(in srgb,var(--purple) 13%,transparent)}}
@media(prefers-reduced-motion:reduce){.pv-page,.pv-page-pressed,.pv-page-clicked,.pv-page-enter,.pv-thumb,.pv-thumb-enter,.control-value-updated{animation:none;transition:none}}
[data-theme="dark"] .rotate-act,[data-theme="dark"] .flip-act,[data-theme="dark"] .rotate-reset{background:#181b2e;border-color:#2c3150;color:#a8aec7}
[data-theme="dark"] .flip-act.active{background:#232752;border-color:var(--purple);color:#bbbbff}
[data-theme="dark"] .rotate-readout{background:#181b2e;border-color:#2c3150;color:#a8aec7}

/* compression level picker */
.level-picker{display:grid;gap:9px}
.level-option{display:flex;align-items:center;gap:12px;border:1.5px solid var(--line);border-radius:15px;padding:14px 15px;cursor:pointer;position:relative;transition:border-color .15s,background .15s,box-shadow .15s}
.level-option input{position:absolute;opacity:0;pointer-events:none}
.level-option:before{content:"";width:18px;height:18px;border-radius:50%;border:2px solid #cfd2e2;flex:0 0 18px;transition:border-color .15s}
.level-option .level-text b{display:block;font-size:12px}
.level-option .level-text small{display:block;font-size:10px;color:#8b91a3;margin-top:3px}
.level-option:hover{border-color:#c7c6ff}
.level-option:has(input:checked){border-color:var(--purple);background:#f7f6ff;box-shadow:0 12px 26px #5d5cf61a}
.level-option:has(input:checked):before{border-color:var(--purple);background:radial-gradient(circle,#fff 0 3px,var(--purple) 4px)}
.level-option:has(input:checked):after{content:"✓";position:absolute;right:15px;color:#fff;background:#25b77b;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:11px}

[data-theme="dark"] .wb-head,[data-theme="dark"] .wb-side,[data-theme="dark"] .wb-side-foot{background:#12142a;border-color:var(--line)}
[data-theme="dark"] .wb-stage{background:#0e1020}
[data-theme="dark"] .wb-badge{background:#1c1f3a}
[data-theme="dark"] .format-chip{background:#171a2c;border-color:#272b45;color:#b6bcd2}
[data-theme="dark"] .level-option{border-color:#272b45}
[data-theme="dark"] .level-option:has(input:checked){background:#1c1f3a}
[data-theme="dark"] .level-option .level-text small{color:#8b93b0}

@container (max-width: 760px){
  .pv-fit-btn span{display:none}
  .pv-fit-btn{padding:0 8px}
  .pv-mode-label{display:none}
  .pv-toolbar{gap:6px;padding:7px 8px}
}
@container (max-width: 520px){
  .pv-text-btn{padding:0 8px;font-size:10px}
  .pv-pageno{min-width:44px}
  .pv-icon-btn{width:28px;height:28px}
  .pv-text-btn{height:28px}
}

@media(max-width:860px){
  .tool-dialog{width:96vw;height:94vh;max-height:94vh}
  .wb-body{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}
  .wb-stage{display:block;padding:18px}
  .wb-stage .drop-zone{min-height:170px}
  .wb-stage .utility-textarea{min-height:150px}
  .wb-side{border-left:0;border-top:1px solid var(--line)}
  .format-grid{grid-template-columns:repeat(2,1fr)}
}
[hidden]{display:none!important}
.wb-stage .drop-zone.compact{flex:none;min-height:110px;padding:16px}
.wb-stage .drop-zone.compact .upload-icon{width:30px;height:30px;font-size:18px;margin-bottom:7px}
.wb-stage .drop-zone.compact b{font-size:11px}
.wb-stage .drop-zone.compact p{margin-top:6px}
.utility-output-image{max-width:100%;max-height:360px;border:1px solid var(--line);border-radius:14px;background:#fff;padding:14px;align-self:center}
.result-text{margin-top:2px;border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:#fbfbff}
.result-text summary{cursor:pointer;font-size:11px;font-weight:700}
.result-text pre{white-space:pre-wrap;word-break:break-word;max-height:220px;overflow:auto;font:11px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;margin:10px 0;color:var(--ink)}
.result-text .button{margin-top:2px}
[data-theme="dark"] .utility-output-image{background:#fff}
[data-theme="dark"] .result-text{background:#171a2c;border-color:#272b45}

.wb-stage.previewing{overflow:hidden}
.wb-stage.previewing .drop-zone{display:none}
.wb-stage.dragging-over .preview-workspace{outline:2px dashed var(--purple);outline-offset:-6px}
.wb-side .selected-files{margin-top:4px;gap:6px}
.wb-side .selected-files:not(:empty){margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}
.wb-side .selected-file{padding:8px;gap:8px}
.wb-side .selected-file-info b{font-size:10px}
.wb-side .file-controls{gap:4px}
.preview-workspace{flex:1;min-height:0;display:flex;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#fff;container-type:inline-size}
.preview-workspace:fullscreen{width:100%;height:100%;border-radius:0;border:0}
.pv{flex:1;min-width:0;display:flex;flex-direction:column;background:#eef0f8}
.pv-toolbar{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#fff;border-bottom:1px solid var(--line);flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none}
.pv-toolbar::-webkit-scrollbar{display:none}
.pv-toolbar>*{flex:none}
.pv-text-btn{white-space:nowrap}
.pv-nav,.pv-zoom{display:flex;align-items:center;gap:4px}
.pv-fit{display:flex;align-items:center;gap:4px;margin-left:4px;padding-left:8px;border-left:1px solid var(--line)}
.pv-fit-btn{display:inline-flex;align-items:center;gap:6px;padding:0 11px;transition:border-color .15s,background .15s,color .15s}
.pv-fit-btn svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.pv-extra{margin-left:auto;display:flex;align-items:center;gap:8px;flex:none}
.pv-icon-btn{width:30px;height:30px;border:1px solid var(--line);background:#fff;border-radius:8px;font-size:15px;line-height:1;display:grid;place-items:center;color:var(--ink);padding:0}
.pv-icon-btn:hover,.pv-text-btn:hover{border-color:var(--purple);color:var(--purple)}
.pv-text-btn{height:30px;padding:0 10px;border:1px solid var(--line);background:#fff;border-radius:8px;font-size:11px;font-weight:700;color:var(--ink)}
.pv-pageno{min-width:54px;text-align:center;font-size:11px;font-weight:700}
.pv-mode-label{font-size:10px;font-weight:700;color:var(--muted);background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:5px 10px}
.pv-mode-label:empty{display:none}
.pv-full-btn{background:var(--soft)}
.pv-note{padding:7px 12px;font-size:11px;line-height:1.5;background:#eef4ff;color:#3b4a72;border-bottom:1px solid var(--line)}
.pv-note b{font-weight:800}
.pv-note-error{background:#fdecec;color:#a3384a}
.pv-viewport{position:relative;flex:1;min-height:0;overflow:auto;padding:22px;display:flex;flex-direction:column;align-items:center}
.pv-pages{display:flex;flex-direction:column;align-items:center;gap:20px;width:max-content;min-width:100%}
.pv-page{position:relative;flex:none;background:#fff;box-shadow:0 8px 26px #20243b22;outline:1px solid #e2e5ef;border-radius:4px}
.pv-pages-clickable .pv-page{cursor:pointer}
.pv-page-content{width:100%;height:100%;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fff}
.pv-page-canvas,.pv-page-img{display:block}
.pv-page-badge{position:absolute;top:8px;left:8px;z-index:2;background:#20243be6;color:#fff;font-size:10px;font-weight:700;padding:3px 7px;border-radius:6px;pointer-events:none}
.pv-order-tag{position:absolute;top:8px;right:8px;z-index:2;background:var(--purple);color:#fff;font-size:10px;font-weight:800;padding:3px 7px;border-radius:6px;pointer-events:none}
.pv-page-flagged{outline:2px solid #e0526b;box-shadow:0 8px 26px #e0526b33}
.pv-page-flagged .pv-page-badge{background:#e0526b}
.pv-page-flagged:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(45deg,#e0526b22 0 10px,#e0526b11 10px 20px);z-index:1;pointer-events:none}
.pv-page-msg{margin:auto;font-size:11px;color:var(--muted);padding:20px;text-align:center}
.pv-status{position:absolute;top:14px;left:50%;transform:translateX(-50%);background:#20243be6;color:#fff;font-size:11px;font-weight:600;padding:7px 12px;border-radius:999px;z-index:5}
.pv-status-error{background:#a3384ae6}
.pv-filestrip{flex:none;display:flex;align-items:center;gap:7px;padding:8px 10px;background:#fbfbff;border-top:1px solid var(--line);overflow-x:auto}
.pv-filestrip:before{content:"Files";flex:none;font-size:9px;font-weight:800;letter-spacing:.6px;color:var(--muted);padding-right:2px;text-transform:uppercase}
.pv-file-thumb{width:116px;aspect-ratio:3/4;padding:4px;cursor:grab;touch-action:pan-y;transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease}
.pv-file-thumb:active{cursor:grabbing}
.pv-file-thumb.dragging{opacity:.5;transform:scale(.97)}
.pv-file-thumb.active{border-color:var(--purple);box-shadow:0 0 0 2px rgba(109,93,246,.2)}
.pv-file-select{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:inherit;padding:0;background:transparent;cursor:grab}
.pv-file-select:active{cursor:grabbing}
.pv-file-select .pv-thumb-img{position:absolute;inset:5px 5px 24px;width:auto;height:auto;aspect-ratio:3/4}
.pv-file-select .pv-thumb-canvas{width:100%;height:100%;object-fit:contain}
.pv-file-page{position:absolute;right:7px;bottom:6px;font-size:10px;font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums}
.pv-file-move,.pv-file-remove{position:absolute;top:7px;z-index:2;width:18px;height:18px;border:1px solid #d7dbe8;border-radius:5px;padding:0;background:rgba(255,255,255,.96);color:#414861;box-shadow:0 1px 4px #20243b25;font-size:12px;line-height:1;font-weight:800;display:flex;align-items:center;justify-content:center;cursor:pointer}
.pv-file-move:hover{border-color:var(--purple);color:var(--purple)}
.pv-file-move-left{left:7px}
.pv-file-move-right{left:29px}
.pv-file-remove{right:7px;width:20px;height:20px;border:0;border-radius:50%;background:rgba(32,36,59,.68);color:#fff;font-size:14px}
.pv-file-remove:hover{background:#e04}
.pv-thumb-pdf{font-size:9px;font-weight:800;color:#d9567f}
[data-theme="dark"] .pv-filestrip{background:#12142a;border-color:#272b45}
.pv-thumbs{flex:none;display:flex;gap:7px;padding:8px;background:#fff;border-top:1px solid var(--line);overflow-x:auto}
.pv-thumb.pv-thumb-draggable{cursor:grab}
.pv-thumb.dragging{opacity:.5}
.pv-thumb{flex:none;width:54px;border:2px solid transparent;background:none;border-radius:7px;padding:2px;display:flex;flex-direction:column;align-items:center;gap:2px;position:relative;cursor:pointer}
