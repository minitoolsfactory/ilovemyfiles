<script>
  const grid = document.querySelector('#tool-grid');
  const tabs = document.querySelector('#category-tabs');
  const search = document.querySelector('#tool-search');
  const noResults = document.querySelector('#no-results');
  const filterStatus = document.querySelector('#filter-status');
  const clearSearchButton = document.querySelector('#clear-tool-search');

  let activeCategory = 'all';
  let term = '';
  let gateAllowed = document.documentElement.dataset.countryGate === 'india';
  const allCountNode = tabs?.querySelector('[data-filter="all"] .category-count');
  const baseCount = Number.parseInt(allCountNode?.textContent ?? '', 10) || 0;

  if (grid && tabs && !tabs.dataset.initialized) {
  tabs.dataset.initialized = 'true';

  function filterTools(announce = false) {
    let visible = 0;
    const counts = new Map();
    for (const card of grid?.querySelectorAll('.tool-card') ?? []) {
      if (card.dataset.countryGated) {
        // It is listed under All tools only, but its count remains category-agnostic.
        const matches = gateAllowed && activeCategory === 'all'
          && (card.dataset.search ?? '').includes(term);
        card.hidden = !(gateAllowed && activeCategory === 'all');
        if (matches) {
          visible++;
          const category = card.dataset.category ?? '';
          counts.set(category, (counts.get(category) ?? 0) + 1);
        }
        continue;
      }
      const category = card.dataset.category ?? '';
      const matchesCategory = activeCategory === 'all'
        || (activeCategory === 'pdf-tools' && (category === 'to-pdf' || category.endsWith('-pdf')))
        || (activeCategory === 'other-work' && category !== 'to-pdf' && !category.endsWith('-pdf'))
        || category === activeCategory;
      const matchesSearch = (card.dataset.search ?? '').includes(term);
      card.hidden = !(matchesCategory && matchesSearch);
      // Counts describe matches in the search, independent of selected tab.
      // Otherwise selecting one category incorrectly zeros every other tab.
      if (matchesSearch) counts.set(category, (counts.get(category) ?? 0) + 1);
    }
    const pdfCount = [...counts].reduce((sum, [category, amount]) =>
      category === 'to-pdf' || category.endsWith('-pdf') ? sum + amount : sum, 0);
    const otherCount = [...counts].reduce((sum, [category, amount]) =>
      category !== 'to-pdf' && !category.endsWith('-pdf') ? sum + amount : sum, 0);
    for (const tab of tabs?.querySelectorAll('button[data-filter]') ?? []) {
      const filter = tab.dataset.filter;
      const count = filter === 'all' ? visible
        : filter === 'pdf-tools' ? pdfCount
        : filter === 'other-work' ? otherCount
        : counts.get(filter) ?? 0;
      const countNode = tab.querySelector('.category-count');
      if (countNode) countNode.textContent = String(count);
    }
    const activeVisible = [...(grid?.querySelectorAll('.tool-card') ?? [])]
      .filter(card => !card.hidden).length;
    if (noResults) noResults.hidden = activeVisible > 0;
    if (announce && filterStatus) {
      filterStatus.textContent = activeVisible === 1 ? '1 tool shown' : `${activeVisible} tools shown`;
    }
  }

  document.addEventListener('cbse:gate', () => {
    gateAllowed = document.documentElement.dataset.countryGate === 'india';
    filterTools(false);
  });

  tabs?.addEventListener('keydown', event => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    const buttons = [...tabs.querySelectorAll('button[data-filter]')];
    if (!buttons.length) return;
    const index = buttons.indexOf(document.activeElement);
    if (index < 0) return;
    event.preventDefault();
    let next = index;
    if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
    if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
    if (event.key === 'Home') next = 0;
    if (event.key === 'End') next = buttons.length - 1;
    buttons[next].focus();
    buttons[next].click();
  });

  tabs?.addEventListener('click', event => {
    const button = event.target.closest('button[data-filter]');
    if (!button) return;
    activeCategory = button.dataset.filter ?? 'all';
    tabs.querySelectorAll('button[data-filter]').forEach(tab => {
      const active = tab === button;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-pressed', String(active));
    });
    filterTools(true);
  });

  search?.addEventListener('input', () => {
    term = search.value.trim().toLowerCase();
    filterTools(true);
  });
  clearSearchButton?.addEventListener('click', () => {
    if (search) search.value = '';
    term = '';
    activeCategory = 'all';
    tabs?.querySelectorAll('button[data-filter]').forEach(tab => {
      const active = tab.dataset.filter === 'all';
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-pressed', String(active));
    });
    filterTools(true);
    search?.focus();
  });

  // A single-key shortcut gets keyboard users to catalogue search without
  // stealing input from editable controls or browser/app shortcuts.
  document.addEventListener('keydown', event => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
    event.preventDefault();
    search?.focus();
    document.querySelector('#tools')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
  });
  filterTools();
  }

  // ---- Recently used -------------------------------------------------
  // Recorded centrally in openTool() (every entry point funnels through it) and
  // stored per browser profile, so the list is specific to this user only.
  const RECENT_KEY = 'ilovemyfiles-recent-tools';
  const RECENT_LIMIT = 6;
  const recentSection = document.querySelector('#recent-section');
  const recentGrid = document.querySelector('#recent-grid');
  const recentCount = document.querySelector('#recent-count');
  const recentClear = document.querySelector('[data-clear-recent]');

  function readRecentIds() {
    try {
      const raw = JSON.parse(localStorage.getItem(RECENT_KEY) ?? '[]');
      if (!Array.isArray(raw)) return [];
      return [...new Set(raw.filter(id => typeof id === 'string'))].slice(0, RECENT_LIMIT);
    } catch {
      return [];
    }
  }

  function renderRecent() {
    if (!recentGrid) return 0;
    recentGrid.textContent = '';
    let shown = 0;
    for (const id of readRecentIds()) {
      // Always read from the canonical tool grid: popular-strip entries are a
      // different markup shape, and cloning those produced mixed-size cards.
      const source = grid?.querySelector('.tool-card[data-tool="' + CSS.escape(id) + '"]')
        || document.querySelector('[data-tool="' + CSS.escape(id) + '"]');
      if (!source) continue;
      const card = document.createElement('a');
      card.className = 'quick-card recent-card';
      card.href = source.getAttribute('href') || '/';
      card.dataset.tool = id;
      card.dataset.toolId = id;
      const iconNode = source.querySelector('.tool-icon');
      if (iconNode) card.append(iconNode.cloneNode(true));
      const title = document.createElement('b');
      title.textContent = source.querySelector('b')?.textContent?.trim() || id;
      card.append(title);
      recentGrid.append(card);
      shown++;
    }
    if (recentCount) recentCount.textContent = shown ? String(shown) : '';
    if (recentSection) recentSection.hidden = shown === 0;
    if (recentClear) recentClear.hidden = shown === 0;
    return shown;
  }

  renderRecent();

  recentClear?.addEventListener('click', () => {
    try { localStorage.removeItem(RECENT_KEY); } catch { /* storage unavailable */ }
    renderRecent();
  });

  // Keep the strip in step when tools are opened from another tab/page.
  window.addEventListener('pageshow', renderRecent);
  window.addEventListener('storage', event => { if (event.key === RECENT_KEY) renderRecent(); });
</script>
