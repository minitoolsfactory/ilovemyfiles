 .hero-search input {font-size:11px}
 .hero-search kbd {display:none}
 .hero-search .button {padding:0 13px}
 .hero-benefits {gap:9px 12px;font-size:10px}
 .hero-benefits i {width:27px;height:27px;font-size:14px}
 .hero-art {height:250px;transform:scale(.76);transform-origin:top center;margin-bottom:-55px}
 .category-rail,.discovery-layout {margin-left:14px;margin-right:14px}
