:root{
  --color-text-primary:#20243b;
  --color-text-secondary:#4b5268;
  --color-text-muted:#5c6377;
  --color-text-subtle:#616881;
  --color-background:#ffffff;
  --color-surface:#ffffff;
  --color-surface-soft:#f7f8fc;
  --color-surface-tint:#f0efff;
  --color-border:#e9ebf3;
  --color-border-control:#7d8497;
  --color-divider:#e2e5ef;
  --color-accent:#4b49e8;
  --color-accent-strong:#4338ca;
  --color-accent-brand:#5d5cf6;
  --color-action:#5d5cf6;
  --color-action-hover:#4b49e8;
  --color-on-accent:#ffffff;
  --color-focus:#4338ca;
  --color-success:#1a7f57;
  --color-success-bg:#eaf9f1;
  --color-warning:#8a5a00;
  --color-warning-bg:#fff7db;
  --color-error:#b3261e;
  --color-error-bg:#fdecec;
  --radius-sm:8px;
  --radius-md:13px;
  --radius-lg:17px;
  --space-1:4px;
  --space-2:8px;
  --space-3:13px;
  --space-4:20px;
  --space-5:28px;
  --space-6:40px;
  --font-xs:10px;
  --font-sm:11px;
  --font-md:13px;
  /* Remap legacy palette names onto validated tokens. */
  --ink:var(--color-text-primary);
  --muted:var(--color-text-muted);
  --line:var(--color-border);
}

/* Polished hub layout inspired by the supplied file-tools concept. */
.hero {max-width:1280px;min-height:410px;margin:0 auto 20px;padding:42px clamp(28px,5vw,74px);grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);gap:20px;border:0;border-radius:0 0 28px 28px;box-shadow:none;background:radial-gradient(ellipse at 78% 45%,#e4e7ff 0,#f3f4ff 36%,transparent 68%),linear-gradient(110deg,#f9faff,#f4f5ff 65%,#eff3ff)}
.hero-copy {max-width:650px}
.hero .eyebrow {padding:8px 14px;border:1px solid #e8e5ff;border-radius:999px;background:#f0efff;color:#4338b5;letter-spacing:.1px;font-size:12px}
.hero h1 {font-size:clamp(42px,4.2vw,58px);line-height:1.05;letter-spacing:-2.8px;margin:17px 0 12px;text-transform:none}
.hero h1 span {background:linear-gradient(90deg,#2563eb,#7146df);background-clip:text;-webkit-background-clip:text;color:transparent}
.hero-subtitle {max-width:560px;font-size:17px;line-height:1.52;color:#424a60}
.hero-search {margin-top:24px;max-width:680px;min-height:58px;display:flex;align-items:center;gap:11px;padding:6px 7px 6px 15px;border:1px solid #cbd5ed;border-radius:15px;background:#fff;box-shadow:0 7px 20px rgba(37,67,139,.09)}
.hero-search svg {flex:0 0 21px;width:21px;height:21px;fill:none;stroke:#27324a;stroke-width:2}
.hero-search input {flex:1;min-width:0;min-height:40px;border:0;outline:0;background:transparent;font-size:13px;color:#20243b}
.hero-search input::placeholder {color:#626a7d;opacity:1}
.hero-search kbd {flex:0 0 auto;padding:5px 8px;border-radius:7px;background:#f1f3f8;color:#596176;font:600 11px ui-monospace,monospace;white-space:nowrap}
.hero-search .button {min-height:44px;padding:0 22px;border-radius:11px;font-size:13px}
.hero-benefits {display:flex;flex-wrap:wrap;gap:12px 22px;margin:19px 4px 0;color:#30374d;font-size:12px;font-weight:650}
.hero-benefits span {display:flex;align-items:center;gap:8px;white-space:nowrap}
.hero-benefits i {width:31px;height:31px;display:grid;place-items:center;border:1px solid #e9e8fa;border-radius:50%;background:#fff;color:#4338b5;font-size:17px;font-style:normal;box-shadow:0 2px 6px #252b4510}
.hero-art {height:350px;transform:scale(1.02);background:radial-gradient(ellipse at 53% 53%,#e4e3ff 0,#eeefff 50%,transparent 74%)}
.hero-art:before {width:290px;height:290px;background:radial-gradient(circle,#dcd7ff 0,#ededff 60%,transparent 74%)}
.hero-laptop {position:relative;z-index:1;width:min(390px,85%);height:270px;display:flex;flex-direction:column;align-items:center;justify-content:center;filter:drop-shadow(0 17px 20px #4d45a32b)}
.laptop-screen {width:86%;height:218px;padding:12px;border:7px solid #263c8b;border-bottom-width:9px;border-radius:18px 18px 7px 7px;background:linear-gradient(140deg,#fff,#f5f7ff);box-shadow:inset 0 0 0 1px #fff}
.laptop-window {height:100%;border:1.5px dashed #8294d7;border-radius:13px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:6px;color:#161b2d;background:rgba(255,255,255,.75)}
.upload-cloud {width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:#edf1ff;color:#2563eb;font-size:34px;font-weight:500}
.laptop-window b {font-size:14px}
.laptop-window small {font-size:12px;color:#687087}
.laptop-base {width:100%;height:21px;margin-top:2px;border-radius:4px 4px 17px 17px;background:linear-gradient(#dce2ff,#898de0 60%,#696ed0);box-shadow:0 7px 12px #373b862b}
.hero-file {position:absolute;z-index:2;width:65px;height:65px;display:grid;place-items:center;border:1px solid #ffffff99;border-radius:17px;color:#fff;font-size:24px;font-weight:850;box-shadow:0 12px 25px #2c31733b;transform:rotate(-9deg)}
.file-pdf {top:46px;left:20%;background:linear-gradient(145deg,#ff687a,#e22a50)}
.file-image {top:95px;left:4%;background:linear-gradient(145deg,#a579ff,#6438d8);font-size:35px}
.file-word {top:102px;right:5%;background:linear-gradient(145deg,#55a7ff,#2563eb);transform:rotate(9deg)}
.file-sheet {right:13%;bottom:46px;background:linear-gradient(145deg,#57d892,#18a65d);transform:rotate(10deg)}
.file-play {left:15%;bottom:42px;background:linear-gradient(145deg,#ffc249,#f27a13);font-size:21px;transform:rotate(8deg)}
.category-rail {max-width:1280px;margin:0 auto 28px;padding:8px 14px;display:flex;align-items:center;justify-content:space-between;gap:4px;border:1px solid #e3e7f2;border-radius:18px;background:rgba(255,255,255,.94);box-shadow:0 8px 22px #1720440c;overflow-x:auto}
.category-rail a {min-height:42px;padding:0 14px;display:flex;align-items:center;justify-content:center;gap:9px;white-space:nowrap;border-right:1px solid #e5e8f0;color:#30374c;font-size:12px;font-weight:700;transition:background .16s,color .16s}
.category-rail a:hover {color:#284fce;background:#f4f6ff}
.category-rail a span {font-size:18px;color:#4c56d8}
.category-rail .category-rail-all {border:0;border-radius:999px;background:linear-gradient(120deg,#2563eb,#4f46e5);color:#fff;padding:0 21px}
.category-rail .category-rail-all span {color:#fff}
.category-rail .category-rail-more {border:0}
.discovery-layout {max-width:1280px;margin:0 auto;padding:8px 0 35px;display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:22px;align-items:start}
.quick-section {max-width:none;margin:0;padding:12px 0 0}
.quick-head {align-items:flex-end;margin-bottom:16px}
.quick-head>div .eyebrow {font-size:9px;margin-bottom:6px}
.quick-head h2 {font-size:26px;line-height:1.1;margin:0 0 5px}
.quick-head p {font-size:12px;color:var(--color-text-secondary);margin:0}
.quick-browse {font-size:13px;white-space:nowrap}
.quick-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.quick-card {position:relative;width:auto;min-width:0;min-height:102px;justify-content:flex-start;align-items:center;gap:12px;padding:14px;background:var(--canvas-surface);border:1px solid var(--canvas-border);border-radius:15px;box-shadow:0 3px 10px #1720440b}
.quick-card>span:nth-child(2) {display:block;min-width:0;padding-right:14px}
.quick-card b {display:block;font-size:13px;line-height:1.3;margin-bottom:5px}
.quick-card small {display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;color:var(--color-text-secondary);font-size:10px;line-height:1.4;font-weight:450}
.quick-card .tool-icon {width:48px;height:48px;flex:0 0 48px;border-radius:13px}
.quick-card .tool-icon svg {width:26px;height:26px}
.popular-arrow {position:absolute;right:12px;bottom:10px;color:var(--color-text-primary);font-size:19px;transition:transform .16s}
.quick-card:hover .popular-arrow {transform:translateX(3px)}
.why-card {padding:20px 19px 16px;border:1px solid #dce2f2;border-radius:21px;background:radial-gradient(circle at 100% 0,#e6eaff 0,transparent 45%),linear-gradient(145deg,#fff,#f4f6ff);box-shadow:0 8px 25px #1720440d}
.why-title {display:flex;align-items:center;gap:10px;margin-bottom:13px}
.why-title>span {width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#eeedff;color:#5145ca;font-size:20px}
.why-title h2 {margin:0;font-size:20px;letter-spacing:-.6px}
.why-card ul {list-style:none;padding:0;margin:0 0 16px;display:grid;gap:8px}
.why-card li {position:relative;padding-left:22px;color:var(--color-text-primary);font-size:12px;font-weight:600;line-height:1.4}
.why-card li:before {content:"✓";position:absolute;left:0;top:0;width:16px;height:16px;display:grid;place-items:center;border-radius:50%;background:#20a86a;color:#fff;font-size:10px;font-weight:850}
.why-stats {display:grid;grid-template-columns:repeat(3,1fr);padding:10px 4px 0;border-top:1px solid #dfe4f2;text-align:center}
.why-stats>div+div {border-left:1px solid #dfe4f2}
.why-stats b,.why-stats span {display:block}
.why-stats b {font-size:21px;letter-spacing:-.5px;color:#202b58}
.why-stats span {margin-top:2px;font-size:10px;color:var(--color-text-secondary)}
.tools-section {max-width:1280px;padding-top:54px}
@media(max-width:1100px) {
 .hero,.category-rail,.discovery-layout {margin-left:22px;margin-right:22px}
 .discovery-layout {grid-template-columns:minmax(0,1fr) 285px;gap:16px}
