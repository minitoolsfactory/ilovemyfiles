---
---
<style is:global>
/* Curated homepage design system; scoped below to avoid touching tool pages. */
/* Home-page-only layout, hero, discovery, marketing sections, and shared WCAG overrides. */
.hero {max-width:1200px;min-height:440px;margin:18px auto 24px;padding:56px clamp(24px,5vw,56px);display:grid;grid-template-columns:1.03fr .9fr;align-items:center;gap:36px;background:linear-gradient(120deg,#fff 4%,#fbfbff 54%,#f2f0ff 100%);border:1px solid var(--canvas-border);border-radius:24px;box-shadow:var(--canvas-shadow);overflow:hidden
}
.hero-copy {max-width:565px
}
.hero h1 {font-size:clamp(42px,5vw,64px);line-height:1.04;letter-spacing:-3.2px;margin:20px 0 18px;font-weight:780;text-transform:capitalize
}
.hero h1 span {color:#2563eb
}
.hero-subtitle {font-size:16px;line-height:1.75;color:#6a7185;max-width:490px;margin:0
}
.hero-actions {display:flex;align-items:center;gap:22px;margin-top:29px
}
.hero-proof {display:flex;flex-wrap:wrap;gap:0;margin-top:31px;color:var(--color-text-secondary);font-size:11px}
.hero-proof span {padding:0 16px;border-left:1px solid var(--color-border)}
.hero-proof span:first-child {padding-left:0;border-left:0}
.hero-proof b {color:var(--color-text-primary);font-size:13px;margin-right:4px}
.hero-art {height:350px;position:relative;display:grid;place-items:center;overflow:hidden;border-radius:24px;background:radial-gradient(ellipse at 50% 45%,#fff 0%,#f1edff 48%,#e9e6ff 100%)
}
.hero-art:before {content:"";position:absolute;width:330px;height:330px;border-radius:50%;background:radial-gradient(circle,#e2ddff 0,#f4f2ff 57%,transparent 70%)
}
.art-orbit {position:absolute;border:1px dashed #d6d5ff;border-radius:50%;transform:rotate(-20deg)
}
.orbit-one {width:390px;height:190px
}
.orbit-two {width:300px;height:330px;transform:rotate(35deg)
}
.file-card {position:absolute;background:#fff;border:1px solid #e9e9f5;border-radius:17px;box-shadow:0 22px 55px #393b7318
}
.file-card-back {width:190px;height:230px;left:12%;top:68px;transform:rotate(-9deg);padding:26px 20px
}
.fake-lines {height:7px;border-radius:8px;background:#e9eaf4;margin:12px 0
}
.fake-lines.short {width:58%
}
.file-card-front {width:235px;padding:20px 20px 17px;right:13%;top:51px;transform:rotate(4deg);z-index:2
}
.image-glyph {height:112px;border-radius:10px;background:linear-gradient(140deg,#c6c5ff,#e8e7ff 55%,#b9e8d7);position:relative;overflow:hidden
}
.image-glyph:before {content:"";position:absolute;width:115px;height:115px;left:47px;top:44px;border-radius:50%;background:#fff7d9;opacity:.8
}
.image-glyph span {position:absolute;width:150px;height:90px;bottom:-24px;left:-9px;background:#6a68dc;clip-path:polygon(0 100%,35% 15%,57% 54%,75% 30%,100% 100%)
}
.image-glyph i {position:absolute;width:120px;height:80px;bottom:-24px;right:-16px;background:#51b995;clip-path:polygon(0 100%,38% 20%,100% 100%)
}
.file-label {font-size:12px;font-weight:800;margin-top:13px
}
.file-meta {font-size:8px;letter-spacing:1px;color:#9a9db0;margin-top:4px
}
.convert-arrow {position:absolute;right:27px;top:144px;width:27px;height:27px;border-radius:50%;background:#eeeefe;color:var(--purple);display:grid;place-items:center;font-size:17px
}
.file-output {display:flex;align-items:center;gap:9px;margin-top:13px;padding:10px;background:#f4fbf7;border-radius:9px
}
.output-icon {width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:#d8f4e6;color:#179967;font-weight:800;font-size:11px
}
.file-output b, .file-output small {display:block
}
.file-output b {font-size:10px
}
.file-output small {font-size:8px;color:#7d8790;margin-top:3px
}
.floating-chip {position:absolute;z-index:3;background:#fff;border:1px solid #ececf4;box-shadow:0 10px 25px #292b5310;padding:10px 13px;border-radius:10px;font-size:10px;font-weight:700;display:flex;align-items:center;gap:8px
}
.floating-chip span {color:var(--purple);font-size:17px
}
.chip-lock {top:36px;right:2%
}
.chip-speed {bottom:43px;left:8%
}
.trust-strip {max-width:1200px;margin:20px auto 0;border:0;border-radius:16px;background:transparent;display:flex;justify-content:center;gap:clamp(35px,8vw,120px);padding:19px 20px;box-shadow:none
}
.trust-strip>div {display:flex;align-items:center;gap:12px
}
.trust-icon {width:35px;height:35px;display:grid;place-items:center;border:1px solid #ececff;background:#f4f3ff;border-radius:11px;color:var(--purple);font-size:19px
}
.trust-strip b, .trust-strip small {display:block
}
.trust-strip b {font-size:11px
}
.trust-strip small {font-size:10px;color:#9297a8;margin-top:4px
}
.tools-section {max-width:1200px;margin:0 auto;padding:62px 28px 74px
}
.section-heading {display:flex;justify-content:space-between;align-items:flex-end;gap:24px
}
.section-heading h2, .privacy-copy h2, .bottom-cta h2 {font-size:34px;letter-spacing:-1.25px;line-height:1.2;margin:13px 0 9px
}
.section-heading p {font-size:13px;color:#858b9d;margin:0
}
.search-wrap {display:flex;align-items:center;gap:9px;width:min(390px,38vw);border:1px solid var(--canvas-border);background:var(--canvas-surface);border-radius:13px;padding:9px 12px;margin-bottom:2px;min-height:48px;box-shadow:0 2px 8px rgba(32,35,58,.04)
}
.search-wrap svg {width:17px;height:17px;fill:none;stroke:#969bae;stroke-width:1.7
}
.search-wrap input {width:100%;border:0;outline:0;font-size:13px;color:var(--ink);min-width:0;min-height:24px;align-self:stretch
}
.search-wrap input::placeholder {color:var(--color-text-muted);opacity:1}
.search-shortcut {display:grid;place-items:center;flex:0 0 24px;height:24px;border:1px solid var(--color-border);border-radius:6px;background:var(--color-surface-soft);color:var(--color-text-muted);font:600 12px ui-monospace,monospace}
.category-tabs {display:flex;gap:7px;margin:27px 0 18px;scrollbar-width:thin;-webkit-overflow-scrolling:touch;overflow-x:auto;overflow-y:hidden;max-width:100%;padding:4px 3px 9px;overscroll-behavior-inline:contain
}
.category-tab {border:1px solid transparent;background:transparent;border-radius:11px;padding:8px 12px;min-height:42px;color:#515970;font-size:12px;font-weight:650
}
.category-tab {flex:0 0 auto
}
.category-tab.active {background:#eeecff;border-color:#b9b3ff;color:#4338b5
}
.category-tab {display:inline-flex;align-items:center;gap:8px;white-space:nowrap
}
.category-symbol {display:inline-grid;place-items:center;width:22px;height:22px;border-radius:7px;background:#f2f3f8;color:#70768c;font-size:13px;line-height:1
}
.category-tab.active .category-symbol {background:#dedcff;color:var(--purple)
}
.category-tab .category-count {display:inline-grid;place-items:center;min-width:21px;height:21px;padding:0 5px;background:#f0f1f6;border-radius:999px;font-size:9px
}
.category-tabs::-webkit-scrollbar {height:5px
}
.category-tabs::-webkit-scrollbar-thumb {background:#c8cad7;border-radius:999px
}
.category-tabs::-webkit-scrollbar-track {background:transparent
}
.category-tab.active .category-count {background:#deddff;color:var(--purple)
}
.tool-catalog-meta {display:flex;justify-content:space-between;align-items:center;margin:-5px 0 15px;color:var(--color-text-muted);font-size:10px
}
.tool-catalog-meta b {color:var(--color-text-primary);font-size:12px
}
.tool-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px
}
.tool-card {min-height:132px;text-align:left;display:flex;align-items:flex-start;gap:13px;padding:19px 16px;background:var(--canvas-surface);border:1px solid var(--canvas-border);border-radius:15px;position:relative;transition:border .16s,box-shadow .16s,transform .16s,color .16s;box-shadow:0 2px 8px rgba(32,35,58,.035);color:var(--ink)
}
.tool-card:hover {border-color:#a9a1f4;box-shadow:0 10px 26px rgba(65,55,150,.1);transform:translateY(-2px)
}
.tool-card[hidden] {display:none
}
.tool-card-content {display:block;padding-right:4px;min-width:0
}
.tool-card-content b {font-size:13px;display:block;margin:3px 0 7px
}
.tool-card-content>span {font-size:10px;line-height:1.6;color:#858b9d;display:block
}
.tool-card-content small {display:block;font-size:8px;letter-spacing:.8px;font-weight:800;color:#a2a6b5;margin-top:13px
}
.tool-arrow {position:absolute;right:14px;top:15px;color:#a8aabb;font-size:15px
}
.no-results {padding:35px 20px;text-align:center;color:var(--muted);font-size:13px;border:1px dashed var(--color-border-control);border-radius:14px;background:var(--color-surface-soft)
}
.no-results b {display:block;color:var(--color-text-primary);font-size:16px}
.no-results p {margin:8px 0 16px;color:var(--color-text-secondary)}
.privacy-section {width:calc(100% - 40px);max-width:1200px;margin:0 auto;background:var(--canvas-surface);border:1px solid var(--canvas-border);border-radius:22px;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1fr);align-items:center;gap:clamp(28px,5vw,60px);padding:58px clamp(24px,6vw,76px);box-shadow:var(--canvas-shadow)
}
.privacy-visual {height:275px;position:relative;display:grid;place-items:center
}
.privacy-visual:before {content:"";position:absolute;width:250px;height:250px;border-radius:50%;border:1px dashed #d4d3ff
}
.privacy-visual:after {content:"";position:absolute;width:190px;height:190px;border-radius:50%;background:#eeedff
}
.privacy-circle {z-index:1;width:125px;height:125px;background:#fff;border:1px solid #e7e6ff;box-shadow:0 15px 45px #5d5cf61a;border-radius:35px;display:grid;place-items:center;color:var(--purple);transform:rotate(-5deg)
}
.privacy-circle svg {width:65px;height:65px
}
.privacy-spark {position:absolute;z-index:2;color:var(--purple);font-size:27px
}
.spark-a {top:27px;right:21%
}
.spark-b {bottom:33px;left:20%
}
.privacy-copy h2 {font-size:35px;margin-top:14px
}
.privacy-copy {min-width:0}
.privacy-copy h2 span {color:var(--purple)
}
.privacy-copy>p {font-size:12px;line-height:1.85;color:#7e8498;max-width:490px;margin:0
}
.privacy-copy ul {list-style:none;margin:21px 0;padding:0;display:grid;gap:12px
}
.privacy-copy li {font-size:11px;font-weight:700;color:#555c72;display:flex;align-items:center;gap:10px
}
.privacy-copy li span {display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#dcf6e9;color:#1d9c69;font-size:11px
}
.privacy-copy .privacy-note {font-size:10px;color:#9a9fb0;border-top:1px solid #e9e9f6;padding-top:13px
}
.how-section {max-width:1200px;margin:auto;padding:74px 28px 78px
}
.centered {text-align:center;justify-content:center
}
.centered .eyebrow {justify-content:center
}
.steps-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px
}
.step {border:1px solid var(--canvas-border);border-radius:15px;padding:25px 24px;position:relative;background:var(--canvas-surface);box-shadow:0 2px 8px rgba(32,35,58,.035)
}
.step-number {position:absolute;right:20px;top:18px;font-size:10px;letter-spacing:1px;font-weight:800;color:#b4b6c7
}
.step-symbol {width:43px;height:43px;border-radius:13px;background:#f0efff;color:var(--purple);display:grid;place-items:center;font-size:23px
}
.step h3 {font-size:14px;margin:19px 0 8px
}
.step p {font-size:11px;line-height:1.75;color:#858b9d;margin:0
}
.bottom-cta {max-width:1144px;margin:0 auto 44px;padding:32px 38px;background:#5347cc;border:1px solid #4d42be;border-radius:18px;display:flex;justify-content:space-between;align-items:center;color:#fff;box-shadow:0 12px 28px rgba(65,55,150,.16)
}
.bottom-cta h2 {font-size:25px;margin:0 0 7px;letter-spacing:-.7px
}
.bottom-cta p {font-size:11px;color:#e1e1ff;margin:0
}
.button-light {background:#fff;color:var(--purple);padding:13px 17px
}
.category-tabs {scrollbar-color:#aeb2c0 transparent}
.quick-section {padding-top:24px}
.quick-head h2 {letter-spacing:.7px}
.quick-card {min-height:54px;border-color:#e0e3ed;padding:9px 15px 9px 9px;font-size:12px}
.recent-clear {min-height:36px}
@media (min-width:1300px) {
.hero {padding-left:65px;padding-right:65px
}
}
@media (max-width:900px) {
.hero {margin:14px 20px 20px;padding:48px 30px 42px;gap:15px;min-height:420px
}
.hero-art {transform:scale(.9);transform-origin:center
}
.hero-proof {margin-top:24px}
.hero h1 {font-size:54px
}
.tool-grid {grid-template-columns:repeat(2,minmax(0,1fr))
}
 .privacy-section {width:calc(100% - 40px);grid-template-columns:minmax(0,.8fr) minmax(0,1fr);gap:30px;padding:48px 36px
}
}
@media (max-width:640px) {
.hero {display:flex;flex-direction:column;align-items:flex-start;padding:38px 21px 20px;gap:8px;margin:10px 12px 16px;border-radius:18px
}
.hero h1 {font-size:49px;letter-spacing:-2.6px
}
.hero-subtitle {font-size:14px
}
.hero-actions {flex-wrap:wrap;gap:13px
}
.hero-proof {gap:10px 0;margin-top:23px}
.hero-proof span {padding:0 10px;font-size:10px}
.hero-proof b {font-size:12px}
.hero-art {align-self:center;width:100%;max-width:400px;height:260px;transform:scale(.88);transform-origin:top center;margin-bottom:-14px
}
.file-card-back {left:7%;top:50px
}
.file-card-front {right:7%;top:35px
}
.chip-lock {right:0;top:15px
}
.chip-speed {left:0;bottom:15px
}
.trust-strip {margin:0 12px;gap:14px;justify-content:space-around;padding:15px 12px;border-radius:14px
}
.trust-strip>div {gap:7px
}
.trust-icon {width:29px;height:29px;font-size:16px;border-radius:9px
}
.trust-strip b {font-size:9px
}
.trust-strip small {font-size:8px
}
.tools-section {padding:56px 18px
}
.section-heading {display:block
}
.section-heading h2, .privacy-copy h2 {font-size:29px
}
.search-wrap {width:100%;margin-top:20px
}
.category-tabs {overflow-x:auto;overflow-y:hidden;white-space:nowrap;max-width:100%;margin-right:-2px;padding-bottom:9px;scroll-snap-type:x proximity
}
.category-tab {scroll-snap-align:start
}
.tool-catalog-meta {align-items:flex-start;gap:8px;flex-direction:column
}
.tool-grid {grid-template-columns:1fr
}
.tool-card {min-height:120px;padding:18px
}
.tool-card-content b {font-size:13px
}
.privacy-section {width:calc(100% - 24px);grid-template-columns:minmax(0,1fr);padding:34px 20px;gap:8px;border-radius:18px
}
.privacy-visual {height:200px
}
.privacy-visual:before {width:205px;height:205px
}
.privacy-visual:after {width:155px;height:155px
}
.privacy-circle {width:110px;height:110px
}
.privacy-copy h2 {font-size:31px
}
.how-section {padding:56px 18px
}
.steps-grid {grid-template-columns:1fr;gap:12px;margin-top:30px
}
.step {padding:20px
}
.bottom-cta {margin:0 12px 30px;padding:25px 20px;gap:18px;align-items:flex-start;flex-direction:column
}
.bottom-cta h2 {font-size:23px
}
}
[data-theme="dark"] .hero-subtitle {color:#9aa1bd
}
[data-theme="dark"] .hero-art:before {background:radial-gradient(circle,#1c1f3a 0,#15172c 57%,transparent 70%)
}
[data-theme="dark"] .file-card {background:#171a2c;border-color:#292d47;box-shadow:0 22px 55px #00000055
}
[data-theme="dark"] .fake-lines {background:#2a2e47
}
[data-theme="dark"] .floating-chip {background:#171a2c;border-color:#2a2e47;color:#c7ccdf
}
[data-theme="dark"] .trust-strip {background:var(--canvas-surface);border-color:var(--canvas-border)
}
[data-theme="dark"] .trust-strip b {color:#dfe2f0
}
[data-theme="dark"] .trust-strip small {color:#8b93b0
}
[data-theme="dark"] .trust-icon {background:#1d2040;border-color:#2b3060
}
[data-theme="dark"] .section-heading p {color:#8b93b0
}
[data-theme="dark"] .search-wrap {background:var(--canvas-surface);border-color:var(--canvas-border)
}
[data-theme="dark"] .hero-proof span {border-color:var(--color-border)}
[data-theme="dark"] .hero-proof b {color:var(--color-text-primary)}
[data-theme="dark"] .search-shortcut {background:#20233b;border-color:#454b68;color:#c3c8dc}
[data-theme="dark"] .no-results {background:var(--color-surface-soft);border-color:var(--color-border-control)}
[data-theme="dark"] .search-wrap input {color:var(--ink)
}
[data-theme="dark"] .category-tab {color:#9aa1bd
}
[data-theme="dark"] .category-tab.active {background:#24264a;border-color:#34395f;color:#bbbbff
}
[data-theme="dark"] .category-tab .category-count {background:#20233b;color:#aab1cc
}
[data-theme="dark"] .category-symbol {background:#20233b;color:#aab1cc
}
[data-theme="dark"] .category-tab.active .category-symbol,[data-theme="dark"] .category-tab.active .category-count {background:#3a3d6b;color:#e0e0ff
}
[data-theme="dark"] .tool-card {background:#171a2c;border-color:#272b45;color:var(--ink)
}
[data-theme="dark"] .tool-card:hover {border-color:#4a4a8f;box-shadow:0 10px 28px #00000044
}
[data-theme="dark"] .tool-card-content>span {color:#9aa1bd
}
[data-theme="dark"] .tool-card-content small {color:#7f86a3
}
[data-theme="dark"] .privacy-section {background:var(--canvas-surface);border-color:var(--canvas-border)
}
[data-theme="dark"] .privacy-copy .privacy-note {color:var(--color-text-muted);border-color:var(--color-border)}
[data-theme="dark"] .privacy-visual:before {border-color:#33376a
}
[data-theme="dark"] .privacy-visual:after {background:#1d2047
}
[data-theme="dark"] .privacy-circle {background:#171a2c;border-color:#2a2e50
}
[data-theme="dark"] .privacy-copy>p {color:#9aa1bd
}
[data-theme="dark"] .privacy-copy li {color:#c3c8dc
}
[data-theme="dark"] .privacy-copy .privacy-note {color:#8289a6;border-color:#262a45
}
[data-theme="dark"] .step {background:var(--canvas-surface);border-color:var(--canvas-border)
}
[data-theme="dark"] .step-number {color:#717899
}
[data-theme="dark"] .step h3 {color:#e6e8f5
}
[data-theme="dark"] .step p {color:#8b93b0
}
[data-theme="dark"] .step-symbol {background:#232752
}
.quick-section {max-width:1200px;margin:0 auto;padding:28px 28px 0
}
.quick-browse {margin-left:auto;font-size:12px;font-weight:700;color:var(--color-accent-strong)}
.quick-head h2 {font-size:16px;letter-spacing:-.2px;color:#20243b;margin:0 0 12px;font-weight:750;text-transform:none
}
.quick-head {display:flex;align-items:center;gap:10px;margin-bottom:12px
}
.quick-head h2 {margin:0
}
.recent-card {min-height:38px;padding:6px 14px 6px 6px;font-size:11px;white-space:nowrap;align-items:center
}
.recent-card .tool-icon {width:26px;height:26px;border-radius:8px
}
.recent-card .tool-icon svg {width:15px;height:15px
}
.recent-card b {overflow:hidden;text-overflow:ellipsis
}
.quick-grid {display:flex;flex-wrap:wrap;gap:10px
}
.quick-card {display:inline-flex;align-items:center;gap:9px;border:1px solid #e9ebf3;background:#fff;border-radius:12px;padding:9px 16px 9px 9px;color:var(--ink);font-weight:700;font-size:12px;transition:border .18s,transform .18s;box-shadow:0 2px 7px rgba(32,35,58,.035)
}
.quick-card:hover {border-color:#9db9ff;transform:translateY(-2px);box-shadow:0 8px 18px rgba(44,93,187,.09)
}
.quick-card .tool-icon {width:36px;height:36px;flex:0 0 36px;border-radius:10px
}
.quick-card .tool-icon svg {width:20px;height:20px
}
.recent-clear {margin-left:auto;flex:none;border:1px solid #e4e6f0;background:#fff;color:#6a7185;font-size:10px;font-weight:700;padding:5px 10px;border-radius:999px;cursor:pointer;transition:border .15s,color .15s,background .15s
}
.recent-clear:hover {border-color:#c7c6ff;color:var(--purple);background:#f7f6ff
}
.recent-clear[hidden] {display:none
}
.recent-count {display:inline-grid;place-items:center;min-width:17px;height:17px;padding:0 5px;margin-left:7px;border-radius:999px;background:#eeedff;color:var(--purple);font-size:9px;font-weight:800;vertical-align:middle
}
.recent-count:empty {display:none
}
.recent-card {position:relative
}
.recent-card[hidden] {display:none
}
[data-theme="dark"] .quick-card {background:#171a2c;border-color:#272b45;color:var(--ink)
}
[data-theme="dark"] .recent-clear {background:#171a2c;border-color:#2c3150;color:#a8aec7
}
[data-theme="dark"] .recent-clear:hover {border-color:#3b3f63;color:#c7c6ff;background:#1e2138
}
[data-theme="dark"] .quick-head h2 {color:#8b93b0
}
@media (max-width:900px) {
.quick-section {padding:20px 22px 0
